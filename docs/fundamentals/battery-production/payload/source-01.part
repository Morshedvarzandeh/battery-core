<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="description" content="CellForge — interactive lithium-ion cell production simulator for a reference graphite/NMC process route.">
<title>CellForge · Lithium-ion Cell Production Simulator</title>
<style>
/* =====================================================================
   Shared design system — the same tokens as the electrode-potentials
   table page, so every file in this set looks like one product.
   ===================================================================== */
:root{
  color-scheme: light;

  --background: light-dark(rgb(255 255 255), rgb(24 24 24));
  --foreground: light-dark(rgb(26 28 31), rgb(255 255 255));
  --card: color-mix(in oklab, var(--foreground) 5%, transparent);
  --card-foreground: var(--foreground);
  --popover: light-dark(rgb(255 255 255), rgb(45 45 45));
  --primary: light-dark(rgb(51 156 255), rgb(131 195 255));
  --primary-foreground: light-dark(rgb(255 255 255), rgb(13 13 13));
  --secondary: light-dark(rgb(255 255 255 / 96%), rgb(54 54 54 / 96%));
  --muted: color-mix(in srgb, var(--foreground) 10%, transparent);
  --muted-foreground: light-dark(rgb(26 28 31 / 62%), rgb(255 255 255 / 62%));
  --faint: light-dark(rgb(26 28 31 / 45%), rgb(255 255 255 / 45%));
  --accent: light-dark(rgb(229 242 255), rgb(13 39 63));
  --accent-foreground: var(--primary);
  --destructive: light-dark(rgb(226 85 7), rgb(255 133 73));
  --destructive-bg: light-dark(rgb(255 240 232), rgb(63 30 13));
  --warning: light-dark(rgb(176 116 0), rgb(240 186 92));
  --warning-bg: light-dark(rgb(255 247 231), rgb(58 45 17));
  --green: light-dark(rgb(0 130 52), rgb(64 201 119));
  --green-bg: light-dark(rgb(232 247 238), rgb(14 46 29));
  --red: light-dark(rgb(186 38 35), rgb(250 66 62));
  --border: light-dark(rgb(26 28 31 / 8%), rgb(255 255 255 / 8.2%));
  --border-strong: light-dark(rgb(26 28 31 / 18%), rgb(255 255 255 / 20%));
  --input: light-dark(rgb(26 28 31 / 11.8%), color-mix(in oklab, rgb(0 0 0) 10%, transparent));
  --ring: light-dark(rgb(51 156 255), rgb(131 195 255 / 76%));

  --font-sans: -apple-system, system-ui, "Segoe UI", sans-serif;
  --font-size-base: 14px;
  --font-size-normal: max(11px, var(--font-size-base));
  --font-size-small: max(11px, calc(var(--font-size-base) - 2px));
  --font-size-h1: calc(var(--font-size-normal) * 1.7142857143);
  --font-size-h2: calc(var(--font-size-normal) * 1.4285714286);
  --font-size-h3: calc(var(--font-size-normal) * 1.2857142857);
  --font-weight-normal: 430;
  --font-weight-medium: 500;
  --font-weight-strong: 600;
  --line-height-normal: calc(var(--font-size-normal) * 1.5);
  --radius: 10px;
  --radius-sm: calc(var(--radius) * 0.6);
  --radius-md: calc(var(--radius) * 0.8);
  --radius-lg: var(--radius);
  --radius-2xl: calc(var(--radius) * 1.6);
  --radius-full: 9999px;
  --shadow-sm: 0 1px 2px -1px rgb(0 0 0 / 8%);
  --shadow-lg: 0 18px 46px light-dark(rgb(26 28 31 / 16%), rgb(0 0 0 / 55%));

  /* materials — a colour always means the same substance, and the same
     substance is the same colour on the cell-architecture page */
  --copper: light-dark(#c07f42, #b87333);
  --alu:    light-dark(#b9c8d1, #a8bbc5);
  --anode:  light-dark(#6b7d86, #46565e);
  --cathode:light-dark(#5aa98d, #4f987f);
  --sep:    light-dark(#ded8ab, #cdc79a);
  --elyte:  light-dark(#3f8bb4, #4a97bf);
  --jelly:  light-dark(#7e4a9e, #9a72b8);
  --hot:    light-dark(#d9542f, #e0704f);
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:var(--background);color:var(--foreground);
  font-family:var(--font-sans);font-size:var(--font-size-normal);
  font-weight:var(--font-weight-normal);line-height:var(--line-height-normal)}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer;background:none;border:0;padding:0}
:is(button,input,select,[tabindex]):focus-visible{outline:2px solid var(--ring);outline-offset:2px;border-radius:var(--radius-sm)}
h1,h2,h3,h4,p{margin:0}
h1{font-size:var(--font-size-h1);font-weight:var(--font-weight-medium);line-height:1.25}
h2{font-size:var(--font-size-h2);font-weight:var(--font-weight-medium);line-height:1.25}
h3{font-size:var(--font-size-h3);font-weight:var(--font-weight-medium);line-height:1.3}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}

.app{min-height:100vh;display:grid;grid-template-columns:250px minmax(0,1fr) 330px}

/* ---------------- sidebar ---------------- */
.sidebar{position:sticky;top:0;height:100vh;overflow:auto;background:var(--card);
  border-right:1px solid var(--border);padding:16px 12px;display:flex;flex-direction:column;gap:2px;
  scrollbar-width:thin}
.brand{display:flex;align-items:center;gap:11px;padding:0 6px 14px}
.mark{width:34px;height:34px;border-radius:var(--radius-md);display:grid;place-items:center;
  background:var(--primary);color:var(--primary-foreground);font-size:12px;font-weight:var(--font-weight-strong)}
.brand strong{display:block;font-size:var(--font-size-h3);font-weight:var(--font-weight-medium);line-height:1.2}
.brand small{display:block;color:var(--faint);font-size:10px;letter-spacing:.06em;margin-top:2px}
.tour-btn{width:100%;min-height:32px;padding:8px 10px;margin-bottom:12px;border-radius:var(--radius-md);
  background:var(--accent);border:1px solid transparent;color:var(--accent-foreground);
  font-size:var(--font-size-small);font-weight:var(--font-weight-medium);text-align:left}
.tour-btn:hover{background:color-mix(in srgb,var(--primary) 18%,transparent)}
.tour-btn span{display:inline-grid;width:18px;height:18px;border-radius:50%;place-items:center;
  background:var(--primary);color:var(--primary-foreground);margin-right:8px;font-size:8px}
.route{margin:0 0 12px;padding:9px 10px;border-radius:var(--radius-md);background:var(--background);
  border:1px solid var(--border)}
.route small{display:block;color:var(--faint);font-size:10px;font-weight:var(--font-weight-medium);
  margin-bottom:6px}
.route-opts{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}
.route-opts button{min-height:26px;padding:5px 2px;border-radius:var(--radius-sm);background:transparent;
  color:var(--muted-foreground);font-size:var(--font-size-small);font-weight:var(--font-weight-medium);
  border:1px solid var(--input)}
.route-opts button:hover{background:color-mix(in srgb,var(--foreground) 6%,var(--secondary))}
.route-opts button[aria-pressed="true"]{background:var(--foreground);color:var(--background);border-color:transparent}
.phase{margin-top:12px}
.phase-title{padding:0 8px 5px;color:var(--faint);font-size:10px;font-weight:var(--font-weight-medium)}
.phase-title i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:7px}
.stage-btn{width:100%;display:grid;grid-template-columns:20px 1fr auto;gap:7px;align-items:center;
  padding:6px 8px;border-radius:var(--radius-sm);color:var(--muted-foreground);text-align:left;
  font-size:var(--font-size-small);min-height:28px}
.stage-btn:hover{background:color-mix(in srgb,var(--foreground) 6%,var(--secondary));color:var(--foreground)}
.stage-btn[aria-current="true"]{background:var(--accent);color:var(--accent-foreground);
  font-weight:var(--font-weight-medium)}
.stage-btn b{font-size:10px;color:var(--faint);font-weight:var(--font-weight-medium);font-variant-numeric:tabular-nums}
.stage-btn[aria-current="true"] b{color:var(--primary)}
.stage-btn em{font-style:normal;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.stage-btn i{width:7px;height:7px;border-radius:2px;display:block}
.side-foot{margin-top:auto;padding:14px 8px 0;border-top:1px solid var(--border);color:var(--faint);
  font-size:10px;line-height:1.55}

/* ---------------- main ---------------- */
.main{min-width:0;display:flex;flex-direction:column}
/* grid items default to a min-content floor, which lets a wide table or
   schematic push the whole page sideways instead of scrolling inside itself */
.content>*{min-width:0}
.topbar{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--background) 88%,transparent);
  backdrop-filter:blur(14px);border-bottom:1px solid var(--border);padding:10px 22px;
  display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.crumb{font-size:10px;color:var(--faint);font-weight:var(--font-weight-medium)}
.crumb b{display:block;font-size:var(--font-size-h3);font-weight:var(--font-weight-medium);
  color:var(--foreground);margin-top:1px}
.topbar-right{margin-left:auto;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.pill{display:inline-flex;align-items:center;gap:6px;min-height:28px;padding:0 10px;
  border-radius:var(--radius-full);border:1px solid var(--input);background:var(--background);
  font-size:var(--font-size-small);color:var(--muted-foreground)}
.pill b{color:var(--foreground);font-weight:var(--font-weight-medium)}
.pill i{width:7px;height:7px;border-radius:50%;background:var(--green)}
.runbtn{min-height:28px;padding:0 13px;border-radius:var(--radius-full);border:1px solid transparent;
  background:var(--foreground);color:var(--background);font-size:var(--font-size-small);
  font-weight:var(--font-weight-medium)}
.runbtn:hover{background:color-mix(in srgb,var(--foreground) 80%,transparent)}
.runbtn[aria-pressed="true"]{background:var(--primary);color:var(--primary-foreground)}
.runbtn[aria-pressed="true"]:hover{background:color-mix(in srgb,var(--primary) 84%,transparent)}
.content{padding:18px 22px 60px;display:grid;gap:14px}

/* ---------------- cards ---------------- */
.card{min-width:0;overflow:hidden;overflow-wrap:break-word;border-radius:var(--radius-2xl);
  color:var(--card-foreground);background:var(--card)}
.card-pad{padding:14px 16px}
.eyebrow{font-size:var(--font-size-small);font-weight:var(--font-weight-medium);color:var(--primary)}
.lede{color:var(--muted-foreground);font-size:var(--font-size-normal);line-height:1.6}

/* machine stage */
.machine{position:relative;border:1px solid var(--border);border-radius:var(--radius-2xl);overflow:hidden;
  background:var(--background)}
.machine-head{display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:1px solid var(--border);
  background:var(--card);flex-wrap:wrap}
.machine-head h3{font-size:var(--font-size-normal);font-weight:var(--font-weight-medium)}
.machine-head .tag{margin-left:auto;display:flex;gap:6px;flex-wrap:wrap}
.tag span{padding:2px 8px;border-radius:var(--radius-full);background:var(--background);
  border:1px solid var(--input);font-size:var(--font-size-small);color:var(--muted-foreground)}
.machine svg{display:block;width:100%;height:auto;background:
  linear-gradient(180deg,color-mix(in srgb,var(--card) 46%,var(--background)) 0%,var(--background) 62%,
  color-mix(in srgb,var(--muted) 42%,var(--background)) 100%)}
.hot{cursor:pointer}
.hot .hit{fill:transparent}
.hot:hover .hit,.hot:focus-visible .hit{fill:color-mix(in srgb,var(--primary) 8%,transparent)}
.hot:hover .ring,.hot[aria-current="true"] .ring{opacity:1}
.ring{opacity:0;stroke:var(--primary);stroke-width:1.8;stroke-dasharray:none;fill:none;
  filter:drop-shadow(0 0 3px color-mix(in srgb,var(--primary) 32%,transparent))}
.readout{display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:start;
  padding:11px 14px;border-top:1px solid var(--border);background:var(--card);min-height:70px}
.readout .num{width:28px;height:28px;border-radius:var(--radius-sm);background:var(--primary);
  color:var(--primary-foreground);display:grid;place-items:center;font-size:11px;font-weight:var(--font-weight-strong)}
.readout strong{display:block;font-size:var(--font-size-normal);font-weight:var(--font-weight-medium)}
.readout span{display:block;color:var(--muted-foreground);font-size:var(--font-size-normal);line-height:1.55;margin-top:2px}
.readout em{font-style:normal;display:inline-block;margin-top:5px;padding:1px 8px;border-radius:var(--radius-full);
  background:var(--accent);font-size:var(--font-size-small);font-weight:var(--font-weight-medium);color:var(--accent-foreground)}

/* material in / out */
.flow{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center}
.flow-box{padding:10px 12px;border-radius:var(--radius-md);border:1px solid var(--border);background:var(--background)}
.flow-box small{display:block;font-size:var(--font-size-small);color:var(--faint)}
.flow-box strong{display:block;font-size:var(--font-size-normal);font-weight:var(--font-weight-medium);margin-top:2px}
.flow-arrow{font-size:18px;color:var(--primary)}

/* info grid */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.block h4{font-size:var(--font-size-normal);font-weight:var(--font-weight-medium);margin-bottom:7px;
  display:flex;align-items:center;gap:7px}
.block h4 i{width:8px;height:8px;border-radius:2px;display:inline-block}
.block ul{margin:0;padding-left:17px;color:var(--muted-foreground);font-size:var(--font-size-normal);line-height:1.6}
.block li+li{margin-top:3px}
.block li b{color:var(--foreground);font-weight:var(--font-weight-medium)}
.sop{margin:0;padding:0;list-style:none;counter-reset:sop;display:grid;gap:5px}
.sop li{counter-increment:sop;position:relative;padding:7px 11px 7px 34px;border-radius:var(--radius-md);
  background:var(--background);border:1px solid var(--border);font-size:var(--font-size-normal);
  color:var(--muted-foreground)}
.sop li::before{content:counter(sop,decimal-leading-zero);position:absolute;left:11px;top:7px;
  color:var(--primary);font-weight:var(--font-weight-strong);font-size:var(--font-size-small);
  font-variant-numeric:tabular-nums}
.env{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px}
.env div{padding:9px 11px;border-radius:var(--radius-md);background:var(--background);border:1px solid var(--border)}
.env small{display:block;font-size:var(--font-size-small);color:var(--faint)}
.env b{display:block;font-size:var(--font-size-normal);font-weight:var(--font-weight-medium);margin-top:2px}

/* line map */
.map{display:grid;gap:12px}
.map-row{display:flex;flex-wrap:wrap;gap:6px;align-items:stretch}
