/* shared helpers — defined first so every later block can use them */
const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>]/g, c => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;" }[c]));
const PHASES = [
  ["Electrode manufacturing", "var(--warning)"],
  ["Cell assembly",           "var(--elyte)"],
  ["Cell finishing",          "var(--green)"]
];
const phaseColor = p => (PHASES.find(x => x[0] === p) || [, "var(--primary)"])[1];
let proc = "wet";   /* "wet" = slurry coating + drying + calendering; "dry" = solvent-free */
const active = () => STATIONS.filter(s => s.routes.includes(route) && (!s.proc || s.proc === proc));
const clamp = (v, lo = 0, hi = 100) => Math.max(lo, Math.min(hi, v));
const fmt = n => n >= 1000 ? Math.round(n).toLocaleString("en-US") : n.toFixed(n < 10 ? 2 : 1);

const ALL = "pouch cyl prism";
const STATIONS = [
{ id:"mixing", no:"01", phase:"Electrode manufacturing", title:"Wet mixing and dispersing", machine:"mixing", routes:ALL, proc:"wet",
  env:{iso:"ISO 7 – ISO 8", dew:"water-based semi-dry, +5…−5 °C; NMP-based 0…−60 °C", temp:"22 ± 2 °C"}, cost:"€ 30–55 M (mixing)", takt:"20 min – 6 h per batch",
  purpose:"Combine active material, conductive carbon, binder and solvent into a homogeneous slurry that can be coated without defects.",
  inp:"Powders, binder, solvent", out:"Filtered, de-aerated slurry",
  parts:[
    ["Powder dosing","FEED","Sample formulations, 5th edition. Anode: graphite 95 wt%, conductive carbon 1 wt%, CMC binder 2 wt%, SBR additive 2 wt%, in deionised water. Cathode: Li(NiMnCo)O₂ 95 wt%, conductive carbon 1 wt%, PVDF binder 4 wt%, in NMP. Anode and cathode are dosed in separate rooms — cross-contamination can make a batch unusable."],
    ["Intensive mixer","MIX + DISPERSE","Step I breaks up heterogeneous phases dry — distributive mixing. Step II adds the solvent and disperses under high shear — dispersive mixing. The jacket is held at 20–40 °C and the batch runs 20 min to 6 h. Vacuum is then applied to pull the entrained air back out, and the result is called slurry."],
    ["Transfer pump","CONVEY","Moves slurry through closed pipework — the slurry never sees open air between mixing and coating."],
    ["Buffer tank","HOLD","Stirred and filtered storage keeps the slurry homogeneous while the coater draws from it. Sedimentation here shows up as a streak on the electrode."],
    ["Release gate","QC","Viscosity, particle size and foreign-object count are checked before the batch is released to coating."]],
  params:["Mixing time: 20 min – 6 h","Temperature control: 20–40 °C","Atmosphere in the mixer: inert gas or vacuum","Atmosphere at the installation site: clean room or no requirement","Different mixers for anode and cathode to avoid cross-contamination"],
  alts:["Continuous mixing by a twin-screw extruder","Intensive mixing","Inline dispersing","Trajectory mixing"],
  innov:["Continuous and intensified wet mixing"],
  qInf:["Mixing and dispersing sequence","Filter media and filter system","Shear forces","Mixing temperature"],
  qFeat:["Homogeneity of the slurry","Agglomerate size","Bubble-free","Purity — foreign matter content","Viscosity"],
  sop:["Verify material identity and lot against the recipe","Confirm the vessel is clean and dedicated to this polarity","Load the approved dosing sequence","Dry mix, then add solvent and disperse","Sample viscosity and particle size","Release under seal to the buffer tank"] },

{ id:"drymix", no:"01D", phase:"Electrode manufacturing", title:"Dry mixing and fibrillation", machine:"drymix", routes:ALL, proc:"dry",
  env:{iso:"ISO 7 – ISO 8", dew:"powder- and chemistry-dependent controlled atmosphere", temp:"20–50 °C reference window"}, cost:"Not separately quoted in the source", takt:"batch or continuous, equipment-dependent",
  purpose:"Blend active material, conductive additive and PTFE-based binder without solvent, then apply enough shear to create a fibril network for film forming.",
  inp:"Dry active material, conductive additive and binder", out:"Homogeneous, fibrillated dry electrode mix",
  parts:[
    ["Powder dosing","FEED","Active material, conductive additive and binder are weighed without water or NMP. Anode and cathode materials remain physically separated to control cross-contamination."],
    ["Premixer","DISTRIBUTE","Low-to-moderate shear distributes powders before the binder is deliberately fibrillated. Merely blending the ingredients is not enough to make a self-supporting film."],
    ["High-shear zone","FIBRILLATE","Mechanical work draws PTFE-based binder into fibrils that connect particles. The displayed fibrillation index is an illustrative teaching relationship, not an equipment recipe."],
    ["Temperature control","CONTROL","Temperature and residence time influence agglomeration, binder behaviour and powder flow. Validated windows depend on the selected materials and mixer."],
    ["Screen and sealed transfer","RELEASE","The mix is screened for large agglomerates and transferred in a closed container to dry coating. Release criteria are manufacturer-specific."]],
  params:["No process solvent","Controlled powder dosing and cross-contamination control","Fibrillation depends on shear, residence time, temperature and binder system","Batch or continuous equipment may be used"],
  alts:["Batch high-shear mixing","Continuous twin-screw or intensive mixing","Alternative fluorine-free binder systems under development"],
  innov:["Continuous dry mixing","Fluorine-free thermoplastic binders","Inline agglomerate and fibrillation monitoring"],
  qInf:["Material sequence","Specific mechanical energy","Residence time","Temperature","Binder type and content"],
  qFeat:["Homogeneity","Fibrillation state","Agglomerate size","Powder flow","Purity"],
  sop:["Verify dry-material identities and lots","Confirm polarity-dedicated equipment","Dose the approved dry recipe","Distribute powders before high shear","Apply the validated fibrillation programme","Screen and release in a sealed container"] },

{ id:"coating", no:"02", phase:"Electrode manufacturing", title:"Coating", machine:"coating", routes:ALL, proc:"wet",
  env:{iso:"ISO 7", dew:"semi-dry, +5…−5 °C", temp:"22 ± 2 °C"}, cost:"€ 35–65 M (coating and drying)", takt:"35–80 m/min",
  purpose:"Meter slurry onto the current-collector foil at a controlled wet-film thickness, one side at a time.",
  inp:"Bare Cu or Al foil, 5–25 µm", out:"Foil coated on one side",
  parts:[
    ["Slurry storage","SUPPLY","A stirred, filtered vessel feeds the die. Any settled solid becomes a visible defect on the web."],
    ["Precision pump","METER","Flow rate sets coat weight together with web speed. Pump precision is one of the three named quality influences on this station."],
    ["Slot die","APPLY","The application tool. Slot die is standard; doctor blade and anilox roller are alternatives. Gap between die lip and foil sets wet thickness."],
    ["Application roll","BACKING","Supports the foil against the die and defines the coating plane. Roll runout prints straight through to thickness."],
    ["Foil unwind","INFEED","Copper for the anode, aluminium for the cathode, 5–25 µm thick, up to 1 500 mm wide. Purchased, not made in house."],
    ["Intermittent coating","PATTERN","Coating can be continuous or intermittent. Intermittent leaves bare foil windows that later become the welded tabs — this is the pouch route."],
    ["Wet-film gauge","MEASURE","Measures wet layer thickness immediately after the die, before any solvent is lost. The ±2 g/m² dry accuracy used here is a common working target from the electrode-processing literature, not a figure the PEM guide quotes."],
    ["Rewind","OUTFEED","The one-side-coated roll is rewound and returned for a second pass, or fed straight to a second die in a tandem line."]],
  params:["Coating width: up to 1 500 mm","Drying speed: 35–80 m/min","Drying distance: up to 100 m","Temperature profile in the drying zones: 50–160 °C","Solvent recovery","Appropriate foil pre-tensioning to prevent foil tears"],
  alts:["Multi-layer simultaneous application","Additive manufacturing processes","Dry coating — a solvent-free route, selectable in the sidebar"],
  innov:["Upstream heating systems to shorten drying times and save energy","Laser drying","Infrared drying","Induction drying"],
  qInf:["Surface quality and layer-thickness monitoring","Choice of application tool","Precision of the slurry pump"],
  qFeat:["Coating thickness accuracy along and across the web","Surface quality — blowholes, particles","Adhesion between coating and substrate"],
  sop:["Scan slurry batch and foil roll IDs","Thread the web through the precision rollers","Set die gap and pump flow for the target coat weight","Start at reduced speed and ramp","Verify wet-film profile across the width","Release the first article before full speed"] },

{ id:"drying", no:"03", phase:"Electrode manufacturing", title:"Drying", machine:"drying", routes:ALL, proc:"wet",
  env:{iso:"ISO 7", dew:"semi-dry, +5…−5 °C", temp:"22 ± 2 °C"}, cost:"€ 35–65 M — quoted together with coating", takt:"dryer up to 100 m long",
  purpose:"Evaporate the solvent and bake the coating onto the foil without cracking it or losing adhesion.",
  inp:"Wet-coated web", out:"Dry electrode web, cooled",
  parts:[
    ["Exhaust manifold","EXTRACT","Solvent and water vapour are handled by plant-specific exhaust, recovery and abatement systems. NMP commonly requires recovery; water-based exhaust handling still depends on process emissions, permits and local regulations."],
    ["Chamber 1 — preheat","RAMP","The first zone raises the web gently. Too fast here and the surface skins over, trapping solvent underneath."],
    ["Chamber 2 — main evaporation","EVAPORATE","Bulk solvent leaves here. Air nozzles above and below both heat the web and float it."],
    ["Chamber 3 — peak","PEAK","The hottest zone, up to 160 °C. Overshoot cracks the coating and can pull binder to the surface."],
    ["Chamber 4 — finish","LEVEL","Brings residual solvent down to specification and evens the profile before cooling."],
    ["Web infeed","TENSION","Foil pre-tensioning is called out explicitly: get it wrong and the thin foil tears inside a hot dryer."],
    ["Cooling rolls","COOL","Chilled rolls bring the web back to room temperature so it can be rewound, or fed directly to the second-side coater in a tandem line."]],
  params:["Drying speed 35–80 m/min","Dryer length up to 100 m","Zone profile 50 °C – 160 °C","Solvent recovery, thermal afterburning","Foil pre-tensioning to avoid tears"],
  alts:["Infrared drying added to convection — shorter and more efficient","Laser drying — shortens the dryer dramatically, still in development"],
  innov:["Upstream heating systems to shorten drying times and save energy","Laser drying","Infrared drying","Induction drying"],
  qInf:["Process parameters matched to the electrode design","Choice of foil pretension","Temperature profile"],
  qFeat:["Adhesion between coating and substrate","Residual humidity","Surface finish — cracks, inclusions"],
  sop:["Confirm exhaust and LEL monitoring are live","Load the zone temperature profile","Verify web tension setpoint","Start airflow before heat","Track solvent loading through the run","Cool below handling temperature before rewind"] },

{ id:"drycoat", no:"03", phase:"Electrode manufacturing", title:"Dry coating", machine:"drycoat", routes:ALL, proc:"dry",
  env:{iso:"ISO 7", dew:"dry — no solvent to hold", temp:"22 ± 2 °C"}, cost:"€ 45–60 M (coating and drying)", takt:"double-sided, single pass",
  purpose:"Form the electrode as a free-standing powder film and press it straight onto the foil — no solvent, no dryer, and no separate calender.",
  inp:"Dry, fibrillated powder mix + primed foil", out:"Compacted electrode, coated both sides",
  parts:[
    ["Dosing unit","FEED","Active material, conductive additive and binder arrive already dry-mixed. There is no solvent anywhere in this station, so there is nothing to evaporate later."],
    ["Film-forming nip","FIBRILLATE","Mechanical shear draws the PTFE binder out into fine fibrils, which knit the powder into a network — that network is what lets a loose powder leave the nip as a self-supporting film."],
    ["Laminating roll","PRESS","The rolls counter-rotate at different speeds, and the speed step rises towards the centre. The faster roll grips harder, so the film always travels inwards. Line pressure 150–300 N/mm, rolls held at 50–200 °C."],
    ["Second film line","MIRROR","A second identical stack forms the reverse-side film at the same moment, so both faces are applied in one pass through the centre gap."],
    ["Lower dosing unit","FEED","Same mix, feeding the lower stack. Both films must match in areal weight or the finished electrode is lopsided."],
    ["Foil unwind","SUBSTRATE","The current collector is usually pre-treated with a carbon-based primer. Without it the dry film has little to hold on to — low adhesion is the standing weakness of this route."],
    ["Areal-weight gauge","MEASURE","Constant weight per unit area is the headline quality feature here, exactly as coat weight is for the wet route."],
    ["Rewind","OUTFEED","The web leaves already compacted, so it goes to slitting rather than to a dryer and calender."]],
  params:["Upstream dry mixing process","Double-sided coating process","Line pressure: 150–300 N/mm","Roll temperature control: 50–200 °C","Foil pre-tensioning important to prevent foil tears"],
  alts:["Electrostatic powder coating","Hot press / extrusion process"],
  innov:["Fluorine-free thermoplastic binders"],
  qInf:["Fibrillation degree of the binder","Line pressure and roll temperature","Speed ratio between the rolls","Primer on the current collector"],
