/* ---------------- 3 · one material chain ---------------- */
/* the dry route replaces four wet-processing stages with dry mixing/fibrillation and dry coating */
const FLOW_DRY = [
  { id:"fibril", by:"drymix", name:"Fibrillated dry mix", state:"Solid, no solvent",
    note:"Shear draws the PTFE binder into fibrils that knit the powder together. There is no solvent at any point, so there is nothing to evaporate later." },
  { id:"film", by:"drycoat", name:"Free-standing film on foil", state:"Compacted, 20–35% porosity",
    note:"The powder leaves the nip as a self-supporting film and is pressed onto the primed collector in the same pass. Because the nip compacts it, no separate calender follows." }
];
const FLOW = [
  { id:"powder", by:null, name:"Active powder", state:"Solid, free-flowing",
    note:"Graphite and NMC reference powders, carbon black and binder. Anode and cathode materials are handled in physically separate rooms." },
  { id:"slurry", by:"mixing", name:"Slurry", state:"Liquid, 2 000–6 000 mPa·s",
    note:"Solvent added and the agglomerates broken up. The batch is filtered and released only on viscosity and particle size." },
  { id:"wet", by:"coating", name:"Wet film on foil", state:"Liquid on metal",
    note:"Metered onto the current collector at a controlled wet thickness. Nothing about the electrode is fixed yet." },
  { id:"dryel", by:"drying", name:"Dried electrode", state:"Porous solid, ≈50% porosity",
    note:"Solvent driven off through a multi-zone dryer and recovered. The coating is now a fragile, very open structure." },
  { id:"comp", by:"calendering", name:"Compacted electrode", state:"Porous solid, 20–35% porosity",
    note:"Rolled to its final thickness and density. This single step sets areal capacity, contact between particles and how easily electrolyte can move." },
  { id:"daughter", by:"slitting", name:"Daughter roll", state:"Narrow coil, 60–300 mm",
    note:"The wide mother roll is cut to cell width. Every cut makes an edge, and every edge can carry a burr." },
  { id:"dry", by:"vacdry", name:"Dry electrode", state:"< 50 ppm residual water",
    note:"Batch vacuum drying at 60–150 °C. From here on the material never sees room air again." },
  { id:"piece", by:"separation|winding", name:"Sheets or jelly roll", state:"Discrete parts",
    note:"Pouch cells are punched into sheets with a contact lug; cylindrical and prismatic cells are wound continuously onto a mandrel." },
  { id:"stack", by:"stacking|winding", name:"Electrode stack", state:"Assembled, dry",
    note:"Anode, separator, cathode, separator, repeated. The anode is typically designed with overhang beyond the cathode edge according to the cell design." },
  { id:"packed", by:"packPouch|packHard", name:"Packaged cell", state:"Sealed except for the fill port",
    note:"Tabs welded, housing formed and sealed. The cell is now a container waiting for its electrolyte." },
  { id:"filled", by:"fillPouch|fillHard", name:"Filled cell", state:"Wetted, not yet working",
    note:"Electrolyte is dosed under vacuum and given time — sometimes with pressure cycling or roll pressing — to reach the porous structure. Incomplete wetting can create locally inactive or nonuniform regions and may not be fully corrected later." },
  { id:"formed", by:"formation", name:"Formed cell", state:"Electrochemically alive",
    note:"The first controlled cycles form the SEI and activate the cell. A chemistry- and process-dependent fraction of cyclable lithium is consumed during interphase formation." },
  { id:"aged", by:"aging", name:"Aged cell", state:"Screened",
    note:"Days to weeks of rest with OCV logged. Excessive voltage loss can indicate elevated self-discharge or an internal defect; the threshold depends on chemistry, SOC, temperature and test duration." },
  { id:"graded", by:"eol", name:"Graded cell", state:"Sorted, at shipping SOC",
    note:"Capacity and resistance measured, cell binned, discharged to transport state of charge and packed." }
];
</script>
<script>
/* =====================================================================
   OPERATOR CONSOLES
   Every station gets the knobs that machine actually has. They write the
   same S the rail writes, so anything you change here is felt by every
   station downstream and by the cell at the end of the line.
   ===================================================================== */
const ok   = (v, lo, hi) => v >= lo && v <= hi ? "ok" : "bad";
const band = (v, lo, hi, soft) => v >= lo && v <= hi ? "ok" : (v >= lo - soft && v <= hi + soft ? "warn" : "bad");
const V    = (label, value, state, hint) => ({ label, value, state: state || "ok", hint: hint || "" });

const OPS = {

mixing: {
  lead:"You are at the mixer HMI. Set the recipe and the dispersing programme, then decide whether this batch releases to coating.",
  ctl:["solid","mixMin","mixT"],
  read:m => [
    V("Slurry viscosity", m.visc.toFixed(0) + " mPa·s", band(m.visc, 2000, 6000, 900), "coatable window 2 000–6 000"),
    V("Dispersion index", m.disp.toFixed(0) + "%", m.disp >= 92 ? "ok" : m.disp >= 85 ? "warn" : "bad", "agglomerates broken up"),
    V("Solvent to remove", ((100 - S.solid) * 10).toFixed(0) + " kg/t", S.solid >= 55 ? "ok" : "warn", "every kg is dryer energy"),
    V("Batch time", (S.mixMin / 60).toFixed(1) + " h", ok(S.mixMin, 20, 360), "PEM 20 min – 6 h")],
  verdict:m => m.visc < 2000 ? ["bad", "Batch rejected — too thin",
      "The solids will settle in the buffer tank and the film will run at the die. Raise the solid content or drop the jacket temperature."]
    : m.visc > 6000 ? ["bad", "Batch rejected — too thick",
      "The die will streak and coat weight will drift. Lower the solid content, or warm the jacket to thin it."]
    : m.disp < 85 ? ["warn", "Released with a note — under-dispersed",
      "Agglomerates survive into the coating and print through as thickness scatter. Give it more dispersing time."]
    : ["ok", "Batch released to coating",
      `Viscosity ${m.visc.toFixed(0)} mPa·s, dispersion ${m.disp.toFixed(0)}%. This is a coatable slurry.`],
  viz:m => ({ fill: clamp((m.visc - 1000) / 7000 * 100, 10, 95) })
},


drymix: {
  lead:"You are at dry mixing and fibrillation. There is no slurry: powder distribution, residence time, temperature and mechanical work determine whether the mix can form a coherent film at the next station.",
  ctl:["dcFib","dmTime","dmT"],
  read:m => [
    V("Illustrative fibrillation index", m.fibril.toFixed(0) + "%", m.fibril >= 55 ? (m.fibril <= 95 ? "ok" : "warn") : "bad", "teaching indicator, not a release criterion"),
    V("Residence time", S.dmTime + " min", band(S.dmTime, 15, 60, 10), "equipment- and recipe-dependent"),
    V("Mix temperature", S.dmT + " °C", band(S.dmT, 20, 50, 10), "material-dependent"),
    V("Process solvent", "none", "ok", "dry route")],
  verdict:m => m.fibril < 55 ? ["bad", "Fibril network not established",
      "The teaching indicator is below the selected film-forming window. Increase mechanical work or residence time, while staying within the validated material temperature range."]
    : m.fibril > 95 ? ["warn", "Agglomeration risk rising",
      "The teaching indicator is above the selected window. Excessive work can compact or agglomerate the powder before controlled film forming."]
    : ["ok", "Dry mix ready for film forming",
      `Illustrative fibrillation index ${m.fibril.toFixed(0)}%. Release still depends on the manufacturer's homogeneity, agglomerate and powder-flow criteria.`],
  viz:m => ({ fill: m.fibril })
},

drycoat: {
  lead:"You are at the dry coater. The upstream dry mixer has already created the fibril network. This nip now forms the film, bonds it to the foil and compacts it without solvent. Web speed is an explicit teaching assumption because the guide does not quote a separate dry-coating speed.",
  ctl:["dcLine","dcRollT","dcPrimer","speed","tC","tA"],
  read:m => [
    V("Fibrillation", m.fibril.toFixed(0) + "%", m.fibril >= 55 ? (m.fibril <= 95 ? "ok" : "warn") : "bad", "PTFE drawn into a binding network"),
    V("Adhesion to the foil", m.adhesion.toFixed(0) + "%", m.adhesion >= 88 ? "ok" : m.adhesion >= 80 ? "warn" : "bad", "the standing weakness of this route"),
    V("Areal-weight scatter", "±" + m.dcErr.toFixed(1) + " g/m²", m.dcErr <= 2 ? "ok" : m.dcErr <= 3 ? "warn" : "bad", "constant weight per unit area"),
    V("Porosity out of the nip", m.por.toFixed(0) + "%", band(m.por, 20, 35, 6), "no separate calender follows"),
    V("Solvent to evaporate", "none", "ok", "no dryer, no recovery plant"),
    V("Illustrative cathode areal capacity", m.capC.toFixed(2) + " mAh/cm²", band(m.capC, 2.5, 5, 1))],
  verdict:m => m.fibril < 55 ? ["bad", "No self-supporting film",
      `Shear at ${S.dcFib}%. Without a fibril network the mix leaves the nip as powder, not as a film, and there is nothing to laminate.`]
    : m.adhesion < 80 ? ["bad", "Film will not stay on the foil",
      `Adhesion ${m.adhesion.toFixed(0)}%. ${S.dcPrimer ? "Bare foil gives it nothing to key into." : "Warm the rolls or raise the shear."} It will delaminate at slitting or in the cell.`]
    : m.dcErr > 2 ? ["warn", "Areal weight drifting",
      `±${m.dcErr.toFixed(1)} g/m². Weight per unit area is the headline quality feature here, exactly as coat weight is on the wet line.`]
    : ["ok", "Dry film laid down and compacted",
      `Adhesion ${m.adhesion.toFixed(0)}%, ±${m.dcErr.toFixed(1)} g/m², porosity ${m.por.toFixed(0)}% straight out of the nip — no dryer and no calender needed.`],
  viz:m => ({ coat: clamp(S.tC / 80 * 100, 20, 100), err: m.dcErr })
},

coating: {
  lead:"You are at the coater. The pump and the web speed together set coat weight; the die gap has to match the wet film the recipe needs.",
  ctl:["tC","tA","speed","gap"],
  read:m => [
    V("Wet film the recipe needs", m.wetNeed.toFixed(0) + " µm", "ok", "dry thickness ÷ solids by volume"),
    V("Gap error", (S.gap - m.wetNeed).toFixed(0) + " µm", Math.abs(S.gap - m.wetNeed) < 12 ? "ok" : Math.abs(S.gap - m.wetNeed) < 30 ? "warn" : "bad"),
    V("Coat weight scatter", "±" + m.coatErr.toFixed(1) + " g/m²", m.coatErr <= 2 ? "ok" : m.coatErr <= 3 ? "warn" : "bad", "±2 g/m² working target"),
    V("Illustrative cathode areal capacity", m.capC.toFixed(2) + " mAh/cm²", band(m.capC, 2.5, 5, 1), "sets the cell's capacity"),
    V("Web throughput", (S.speed * 60).toFixed(0) + " m/h", "ok"),
    V("Coating uniformity", m.uniformity.toFixed(0) + "%", m.uniformity >= 92 ? "ok" : "warn")],
  verdict:m => m.coatErr > 3 ? ["bad", "Coat weight out of specification",
      `±${m.coatErr.toFixed(1)} g/m² against a ±2 g/m² target. Set the gap to ${m.wetNeed.toFixed(0)} µm and slow the web.`]
    : m.coatErr > 2 ? ["warn", "Coat weight drifting",
      `±${m.coatErr.toFixed(1)} g/m². Thickness variation becomes capacity variation, and grading will find it.`]
    : ["ok", "Coating on target",
      `±${m.coatErr.toFixed(1)} g/m² at ${S.speed} m/min. Cathode is laying down ${m.capC.toFixed(2)} mAh/cm².`],
  viz:m => ({ coat: clamp(S.tC / 80 * 100, 20, 100), err: m.coatErr })
},

drying: {
  lead:"You are at the dryer control desk. The web needs a certain amount of heat to lose its solvent — set the zones, and mind that more is not better.",
  ctl:["dryT","speed","dryLen","solid"],
  read:m => [
    V("Heat the web needs", m.needT.toFixed(0) + " °C", "ok", "from speed, solvent load and dryer length"),
    V("Peak set", S.dryT + " °C", "ok"),
    V("Margin", (S.dryT - m.needT).toFixed(0) + " °C", m.solventGap > 0 ? "bad" : m.crackGap > 12 ? "warn" : "ok", "aim for 0 to +30 °C"),
    V("Residual solvent", m.solventGap > 0 ? (m.solventGap * 240).toFixed(0) + " ppm" : "< 300 ppm", m.solventGap > 0 ? "bad" : "ok"),
    V("Binder migration", m.crackGap > 12 ? "high" : m.crackGap > 0 ? "some" : "low", m.crackGap > 12 ? "warn" : "ok", "binder pulled to the surface"),
    V("Dwell time in the dryer", (S.dryLen / S.speed * 60).toFixed(0) + " s", "ok")],
  verdict:m => m.solventGap > 10 ? ["bad", "Web leaving wet",
      `Needs about ${m.needT.toFixed(0)} °C, set to ${S.dryT} °C. Solvent left in the coating destroys adhesion and poisons the cell.`]
    : m.crackGap > 12 ? ["warn", "Over-dried",
      "The surface skins before the depth is dry. Binder migrates up, adhesion to the foil falls, and the coating cracks at the calender."]
    : ["ok", "Drying profile balanced",
      `${(S.dryT - m.needT).toFixed(0)} °C of margin over what the web needs, ${(S.dryLen / S.speed * 60).toFixed(0)} s of dwell.`],
  viz:m => ({ heat: clamp((S.dryT - 50) / 110 * 100), gap: m.solventGap })
},

calendering: {
  lead:"You are at the calender. This one nip decides energy density, wetting and crack risk at the same time — it is the most consequential setpoint on the line.",
  ctl:["force","rollT","speed"],
  read:m => [
    V("Porosity", m.por.toFixed(0) + "%", band(m.por, 20, 35, 5), "commercial cells run 20–25%, research 30–35%"),
    V("Coating density", (4.65 * (1 - m.por / 100)).toFixed(2) + " g/cm³", "ok"),
    V("Illustrative cathode areal capacity", m.capC.toFixed(2) + " mAh/cm²", "ok"),
    V("N/P ratio", m.np.toFixed(2), band(m.np, 1.05, 1.25, 0.05), "anode must stay oversized"),
    V("Particle cracking", S.force > 2300 ? "likely" : S.force > 1900 ? "possible" : "unlikely", S.force > 2300 ? "bad" : S.force > 1900 ? "warn" : "ok"),
    V("Electrolyte access", m.por > 24 ? "good" : m.por > 19 ? "tight" : "poor", m.por > 24 ? "ok" : m.por > 19 ? "warn" : "bad", "pores are the ion path")],
  verdict:m => m.np < 1.02 ? ["bad", "Anode under-sized — plating risk",
      `N/P ${m.np.toFixed(2)}. Compressing both coatings equally does not fix a balance problem; change coat thickness instead.`]
    : S.force > 2300 ? ["bad", "Squeezing, not compacting",
