  ${T(178, 60, "20–35% porosity", "mTxtS")}
  ${T(20, 124, "thinner and denser", "mTxtS")}
  ${T(296, 72, "→ capacity", "mTxtS")}${T(296, 86, "→ less room", "mTxtS")}
  ${T(296, 100, "   for electrolyte", "mTxtS")}`),

/* the burr, against a separator */
burr: () => pic(`
  ${R(20, 40, 130, 26, "mCu", 2)}
  ${P("M150 40l0 26", "mLine")}
