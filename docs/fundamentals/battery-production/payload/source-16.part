};

const TOUR = [
  { id:null, t:"Welcome to Line A-17",
    d:"You are standing at the head of a lithium-ion cell plant. A line of stations turns black powder into a packed cell. This tour walks you through in order — at each stop the machine on screen is the one you would actually be looking at." , pic:"line" },
  { id:"view:anatomy", t:"First — what you are actually building",
    d:"Before the machines, the product. A cell is a five-layer sandwich repeated up to 120 times, soaked in electrolyte and sealed in a barrier. Click any layer to see which stations are responsible for it. Only three of the nine components are made in this building." , pic:"stack" },
  { id:"view:flow", t:"Follow the product state",
    d:"Electrode materials are transformed through successive stations while bought-in foils, separator, electrolyte and housing components are added at defined stages. Upstream defects can therefore remain embedded in the finished cell." , pic:"chain" },
  { id:"mixing", t:"It starts with two black powders",
    d:"Anode and cathode active materials arrive as powder and are nearly indistinguishable by eye. Contamination between them ruins a cell, so they are mixed in physically separate rooms. Hover the mixer to see the two-step dry-then-wet sequence." , pic:"powders" },
  { id:"coating", t:"Slurry meets foil",
    d:"A slot die meters slurry onto copper foil for the anode, aluminium for the cathode — both only 5–25 µm thick. Only one side is coated per pass. Scroll down to the black Operate this station panel: those are this machine's real knobs. Move the die gap away from the wet film the recipe needs and watch coat weight leave specification." , pic:"die" },
  { id:"drying", t:"The longest machine in the building",
    d:"Up to 100 metres of dryer in four temperature zones. Push the line speed up and the model will tell you the dryer needs more heat — run it under-heated and solvent stays in the coating." , pic:"dryer" },
  { id:"calendering", t:"Where energy density is decided",
    d:"Two rollers press the coating from about 50% porosity down to a lower target range. This setpoint influences capacity, wetting and crack risk at once. Slide the calender force and watch porosity, N/P ratio and the illustrative process-health score move." , pic:"nip" },
  { id:"slitting", t:"The most dangerous burr in the plant",
    d:"Rolling knives cut the wide roll into daughter rolls. A burr can damage or pierce the separator and create a latent internal-short risk, so blade condition, edge inspection and cleanliness are critical." , pic:"burr" },
  { id:"vacdry", t:"Getting the water out",
    d:"12 to 30 hours under vacuum. From here on the dew point falls station by station, because residual water can hydrolyse LiPF₆ and generate HF-containing species. Try dropping the vacuum drying time and watch the moisture score collapse." , pic:"water" },
  { id:"stacking", t:"Building the sandwich",
    d:"For pouch cells, sheets are stacked alternately into a Z-folded separator — up to 120 layers, one second per sheet, positioned to ±200 µm. Switch the format to cylindrical in the sidebar and this station is replaced by a winder." , pic:"stacker" },
  { id:"fillPouch", t:"The driest room you will ever stand in",
    d:"The chamber is first evacuated to about 0.01 mbar in a −50 to −70 °C dew-point environment. Dosing is followed by separate pressure/vacuum wetting cycles, represented here by a roughly 150 mbar reference setpoint." , pic:"wetting" },
  { id:"formation", t:"The cell's first controlled cycles",
    d:"The reference guide shows stepped formation rates in the 0.1–0.5 C range. These first controlled cycles form the SEI, consume some cyclable lithium and can generate gas. Formation is capital- and time-intensive, and validated recipes are manufacturer-specific." , pic:"sei" },
  { id:"aging", t:"Three weeks of watching",
    d:"Cells are held hot, then at room temperature, while their open-circuit voltage is logged. Excessive OCV loss can indicate elevated self-discharge or an internal defect. The actual threshold depends on chemistry, SOC, temperature, duration and the manufacturer’s release procedure." , pic:"screen" },
  { id:"eol", t:"Out the door",
    d:"Run a defined capacity test, set the required shipping SOC, then grade, label and pack. Every station has an Operate panel, and every one of them feeds this number." , pic:"grade" },
  { id:"view:matrix", t:"Who is responsible for what",
    d:"One grid: fifteen machines down the side, nine cell components across the top. Read a row to see what a station is accountable for, a column to see how many hands a component passes through. Slitting builds nothing at all — its entire row is risk." , pic:"matrix" },
  { id:"view:refs", t:"And where every number came from",
    d:"Process parameters, room classes, machine investments and cycle times are from the PEM RWTH Aachen and VDMA guide. The physics linking them is from the peer-reviewed sources listed here. Every superscript number in this simulator opens the source it came from." , pic:"refs" }
];
let tourAt = -1;
let tourReturnFocus = null;
function closeTour() {
  $("tour").dataset.open = "0";
  if (tourReturnFocus && document.contains(tourReturnFocus)) tourReturnFocus.focus();
}
function showTour(i) {
  const opening = $("tour").dataset.open !== "1";
  if (opening) tourReturnFocus = document.activeElement;
  tourAt = i;
  const s = TOUR[i];
  go(s.id);
  $("tour").dataset.open = "1";
  $("tourStep").textContent = `STOP ${i + 1} OF ${TOUR.length}`;
  $("tourTitle").textContent = s.t;
  $("tourText").textContent = s.d;
  $("tourPic").innerHTML = s.pic && TOURPIC[s.pic] ? TOURPIC[s.pic]() : "";
  $("tourDots").innerHTML = TOUR.map((_, j) => `<i class="${j <= i ? "on" : ""}"></i>`).join("");
  $("tourBack").disabled = i === 0;
  $("tourNext").textContent = i === TOUR.length - 1 ? "Finish tour" : "Next stop →";
  if (opening) requestAnimationFrame(() => $("tourClose").focus());
}
$("tourStart").addEventListener("click", () => showTour(0));
$("tourNext").addEventListener("click", () => {
  if (tourAt >= TOUR.length - 1) { closeTour(); return; }
