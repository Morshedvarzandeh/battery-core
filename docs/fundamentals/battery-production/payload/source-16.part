      xMark:30, xMarkLabel:"above IATA PI 965", lo:0,
      series:[{ y:m => m.cellAh * 3.65 * S.shipSOC / 100, label:"Watt-hours per cell as shipped", col:"var(--elyte)" }] }]
};
const CUSTOM = { aging:agingOCVChart, formation:formationChart };

function renderCharts(st) {
  const list = (CHARTS[st.id] || []).map(chartSVG);
  if (CUSTOM[st.id]) list.unshift(CUSTOM[st.id]());
  if (!list.length) return "";
  return `<div class="charts">${list.join("")}</div>`;
}

/* --- the process window bar under every control -------------------------
   answers the plain question "am I allowed to set it here?" before any
   of the physics gets a chance to answer it for you.                     */
function windowBar(k) {
  const c = CTL[k];
  if (c.opts || !c.good) return "";
  const p = v => Math.max(1.6, Math.min(98.4, (v - c.min) / (c.max - c.min) * 100)).toFixed(1);
