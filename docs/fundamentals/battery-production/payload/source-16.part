      <line x1="${px(days)}" y1="${TT}" x2="${px(days)}" y2="${H2 - B}" stroke="var(--foreground)" stroke-width="1.2" stroke-dasharray="3 3" opacity=".55"/>
      <text class="cLab" x="${px(days) + (days > 11 ? -4 : 4)}" y="${TT + 10}"
        text-anchor="${days > 11 ? "end" : "start"}">you release here</text>
      <path d="${path(bad)}" fill="none" stroke="var(--destructive)" stroke-width="2.2"/>
      <path d="${path(good)}" fill="none" stroke="var(--primary)" stroke-width="2.2"/>
      <circle cx="${px(days)}" cy="${py(bad(days))}" r="4.6" fill="#fff" stroke="var(--destructive)" stroke-width="2.4"/>
      <circle cx="${px(days)}" cy="${py(good(days))}" r="4.6" fill="#fff" stroke="var(--primary)" stroke-width="2.4"/>
      <path d="M${px(days) + 13} ${py(good(days))}L${px(days) + 13} ${py(bad(days))}" stroke="var(--foreground)" stroke-width="1"/>
      <text class="cVal" x="${px(days) + 18}" y="${(py(good(days)) + py(bad(days))) / 2 + 4}"
        fill="${caught ? "var(--primary)" : "var(--destructive)"}">${sep.toFixed(1)} mV apart</text>
      <text class="cAx" x="${L}" y="${H2 - B + 13}">0 d</text>
      <text class="cAx" x="${W2 - R}" y="${H2 - B + 13}" text-anchor="end">21 d</text>
      <text class="cAx" x="${L - 5}" y="${py(maxY) + 8}" text-anchor="end">${maxY.toFixed(0)}</text>
      <text class="cAx" x="${L - 5}" y="${py(0)}" text-anchor="end">0</text>
      <text class="cVal" x="${L}" y="${TT - 7}">mV lost</text>
      <g transform="translate(${L} ${H2 - 6})">
        <line x1="0" y1="-3" x2="14" y2="-3" stroke="var(--primary)" stroke-width="2.2"/><text class="cLab" x="18" y="0">healthy cell</text>
        <line x1="112" y1="-3" x2="126" y2="-3" stroke="var(--destructive)" stroke-width="2.2"/><text class="cLab" x="130" y="0">illustrative high-self-discharge cell</text>
      </g>
    </svg>
    <p class="chart-note" data-s="${caught ? "ok" : "bad"}">${caught
      ? `At ${days} days and ${HT} °C the two cells are ${sep.toFixed(1)} mV apart — above the illustrative 5 mV/week flag, so this teaching example would trigger further investigation or rejection.`
      : `At ${days} days and ${HT} °C the two cells are only ${sep.toFixed(1)} mV apart. In this teaching example the separation is too small for the assumed screen. A real release decision requires validated limits, measurement uncertainty and site procedures.`}</p>
  </figure>`;
}

/* --- bespoke: the first charge, drawn ---------------------------------- */
function formationChart() {
  const m = model(), C = S.cRate, hours = 13 / (C / 0.25);
  const W2 = 340, H2 = 176, L = 40, R = 12, TT = 22, B = 30;
  const px = t => L + t / hours * (W2 - L - R);
  const py = v => TT + (1 - (v - 2.8) / (S.vMax + 0.1 - 2.8)) * (H2 - TT - B);
  /* CC to the cut-off, then CV taper — the shape every formation recipe has */
  const cc = hours * 0.78;
  const v = t => t < cc ? 2.8 + (S.vMax - 2.8) * (1 - Math.exp(-t / (cc * 0.34))) : S.vMax;
  const path = Array.from({ length: 70 }, (_, i) => {
    const t = i / 69 * hours; return `${i ? "L" : "M"}${px(t).toFixed(1)} ${py(v(t)).toFixed(1)}`;
  }).join("");
  /* the SEI grows in the first part of the charge, between about 0.7 and 1.5 V vs Li */
  const seiEnd = px(cc * 0.42);
  return `<figure class="chart">
    <figcaption><b>The first charge, drawn</b><span>cell voltage against time at ${C.toFixed(2)} C</span></figcaption>
    <svg viewBox="0 0 ${W2} ${H2}" role="img" aria-label="Cell voltage against time during the first charge">
      <line x1="${L}" y1="${TT}" x2="${L}" y2="${H2 - B}" stroke="var(--border-strong)"/>
      <line x1="${L}" y1="${H2 - B}" x2="${W2 - R}" y2="${H2 - B}" stroke="var(--border-strong)"/>
      <rect x="${L}" y="${TT}" width="${seiEnd - L}" height="${H2 - TT - B}" fill="color-mix(in srgb,var(--jelly) 12%,transparent)"/>
      <text class="cLab" x="${L + 4}" y="${H2 - B - 6}" fill="var(--jelly)">SEI forms in here</text>
      <line x1="${L}" y1="${py(S.vMax)}" x2="${W2 - R}" y2="${py(S.vMax)}" stroke="var(--destructive)"
        stroke-width="1.4" stroke-dasharray="4 3"/>
      <text class="cLab" x="${W2 - R - 3}" y="${py(S.vMax) - 4}" text-anchor="end" fill="var(--destructive)">cut-off ${S.vMax.toFixed(2)} V</text>
      <path d="${path}" fill="none" stroke="var(--primary)" stroke-width="2.4" stroke-linejoin="round"/>
      <text class="cAx" x="${L}" y="${H2 - B + 13}">0 h</text>
      <text class="cAx" x="${W2 - R}" y="${H2 - B + 13}" text-anchor="end">${hours.toFixed(1)} h</text>
      <text class="cAx" x="${L - 5}" y="${py(S.vMax) + 4}" text-anchor="end">${S.vMax.toFixed(1)}</text>
      <text class="cAx" x="${L - 5}" y="${py(2.8) }" text-anchor="end">2.8</text>
      <text class="cVal" x="${L}" y="${TT - 7}">cell voltage, V</text>
    </svg>
    <p class="chart-note" data-s="${m.seiQ >= 90 ? "ok" : m.seiQ >= 80 ? "warn" : "bad"}">
      ${hours.toFixed(1)} h on the rack. The film forms in the shaded part of the ramp — the faster you push through it,
      the more porous and resistive it is. SEI quality ${m.seiQ.toFixed(0)}%, with ${m.liLoss.toFixed(1)}% illustrative first-cycle irreversible loss. Actual values are chemistry- and protocol-dependent.</p>
  </figure>`;
}

