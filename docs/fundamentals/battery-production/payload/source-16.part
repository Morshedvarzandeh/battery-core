  ${REEL(46, 96, 18, "mCu")}
  ${P("M64 96q30 -10 74 -14l190 0", "mWeb")}
  <path class="mWeb flowdash" stroke="var(--copper)" d="M64 96q30 -10 74 -14l190 0"/>
  ${T(24, 124, "bare foil", "mTxtS")}
  ${R(238, 68, 74, 12, "mAn", 2)}
  ${T(238, 62, "wet film", "mTxtS")}
  ${T(238, 124, "coated", "mTxtS")}`),

/* four heated chambers over a web */
dryer: () => pic(`
  ${[0, 1, 2, 3].map(i => `${R(20 + i * 84, 34, 74, 56, "mHot", 4)}
