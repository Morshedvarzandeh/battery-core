      S[b.dataset.seg] = Number(b.dataset.v); refresh();
    }));
  $("conReset").addEventListener("click", () => {
    ctlsOf(o).forEach(k => S[k] = DEFAULTS[k]); renderSliders(); refresh();
  });
  $("conBreak").addEventListener("click", () => {
    /* push this station's knobs to the edge that fails, so the failure mode is visible */
    const BREAK = { tC:80, tA:50, speed:80, dryT:60, force:2500, vac:8, cRate:0.5, ageDays:3,
      solid:75, mixMin:30, mixT:40, gap:280, dryLen:20, rollT:120, knife:0, cutSpd:150, wear:100,
      vacT:60, sepMode:0, stackAcc:600, webTens:140, drawDepth:10, sealT:150, doseFac:1,
      fillP:400, soak:1, pressP:1.2, preT:60, formT:60, vMax:4.4, degP:60, ageSOC:20, ageHiT:25, shipSOC:60,
      dcLine:150, dcRollT:50, dcFib:20, dmTime:5, dmT:70, dcPrimer:1 };
    ctlsOf(o).forEach(k => S[k] = BREAK[k]); renderSliders(); refresh();
  });
}

/* ---------------------------------------------------------------------
   navigation for the new views
   ------------------------------------------------------------------- */
function showView(id) {
  $("overview").hidden = true; $("stationView").hidden = true; $("layerView").hidden = false;
  const v = VIEWS.find(x => x.id === id) || VIEWS[0];
  $("crumbTitle").textContent = v.label;
  $("pillEnv").innerHTML = `<i></i><b>${esc(v.hint)}</b>`;
  $("pillPos").textContent = "—";
  ({ machine:renderMachineOverview, anatomy:renderAnatomy, flow:renderFlow, matrix:renderMatrix,
     radar:renderRadar, factory:renderFactory, refs:renderRefs }[v.id])();
}

/* ---------------------------------------------------------------------
   responsive workspace drawers
   ------------------------------------------------------------------- */
const appShell = document.querySelector(".app");
const compactShell = window.matchMedia("(max-width: 1280px)");
let drawerReturnFocus = null;

function syncDrawerState() {
  const compact = compactShell.matches;
  const open = compact ? appShell.dataset.drawer : "";
  const navOpen = open === "nav", labOpen = open === "lab";
  if (!compact) appShell.dataset.drawer = "";
  $("navBtn").setAttribute("aria-expanded", String(navOpen));
  $("labBtn").setAttribute("aria-expanded", String(labOpen));
  $("stationDrawer").toggleAttribute("inert", compact && !navOpen);
  $("processDrawer").toggleAttribute("inert", compact && !labOpen);
  $("lesson-content").toggleAttribute("inert", compact && (navOpen || labOpen));
  document.body.classList.toggle("drawer-open", compact && (navOpen || labOpen));
}

function openDrawer(name, trigger) {
  if (!compactShell.matches) return;
  if ($("tour").dataset.open === "1") closeTour();
  drawerReturnFocus = trigger;
  appShell.dataset.drawer = name;
  syncDrawerState();
  requestAnimationFrame(() => $(name === "nav" ? "navClose" : "labClose").focus());
}

function closeDrawer(restoreFocus = true) {
  if (!appShell.dataset.drawer) return;
  const target = drawerReturnFocus;
  drawerReturnFocus = null;
  appShell.dataset.drawer = "";
  syncDrawerState();
  if (restoreFocus && target && document.contains(target)) target.focus();
}

$("navBtn").addEventListener("click", e => openDrawer("nav", e.currentTarget));
$("labBtn").addEventListener("click", e => openDrawer("lab", e.currentTarget));
$("navClose").addEventListener("click", () => closeDrawer());
$("labClose").addEventListener("click", () => closeDrawer());
$("drawerScrim").addEventListener("click", () => closeDrawer());
$("tourStart").addEventListener("click", () => closeDrawer(false));

document.addEventListener("click", e => {
  if (compactShell.matches && e.target.closest("#stationDrawer [data-go]")) closeDrawer(false);
});
document.addEventListener("keydown", e => {
  const open = compactShell.matches && appShell.dataset.drawer;
  if (!open) return;
  if (e.key === "Escape") { e.preventDefault(); closeDrawer(); return; }
  if (e.key !== "Tab") return;
  const panel = $(open === "nav" ? "stationDrawer" : "processDrawer");
  const focusable = [...panel.querySelectorAll('button:not([disabled]),a[href],input:not([disabled]),select:not([disabled]),[tabindex]:not([tabindex="-1"])')]
    .filter(el => !el.hasAttribute("inert") && el.offsetParent !== null);
  if (!focusable.length) return;
  const first = focusable[0], last = focusable[focusable.length - 1];
  if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
  else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
});
const onShellChange = () => { appShell.dataset.drawer = ""; drawerReturnFocus = null; syncDrawerState(); };
if (compactShell.addEventListener) compactShell.addEventListener("change", onShellChange);
else compactShell.addListener(onShellChange);

/* reference chips open the reference list at the right entry */
document.addEventListener("click", e => {
  const b = e.target.closest("[data-ref]");
  if (!b) return;
  e.preventDefault();
  go("view:refs");
  setTimeout(() => {
    const el = document.getElementById("ref-" + b.dataset.ref);
    if (el) { el.scrollIntoView({ behavior:"smooth", block:"center" }); el.style.outline = "2px solid var(--primary)";
      setTimeout(() => el.style.outline = "", 1800); }
  }, 60);
});

/* ---------------- boot ---------------- */
renderSliders();
renderRail();
go(null);
syncDrawerState();
</script>
</body>
</html>
