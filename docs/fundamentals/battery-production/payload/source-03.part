  padding-left:8px;border-left:3px solid var(--green)}
.chart-note[data-s="warn"]{border-left-color:var(--warning)}
.chart-note[data-s="bad"]{border-left-color:var(--destructive);color:color-mix(in srgb,var(--destructive) 78%,var(--foreground))}

/* ---------------- component badges ---------------- */
.makes{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.chipc{display:inline-flex;align-items:center;gap:6px;min-height:26px;padding:2px 10px;
  border-radius:var(--radius-full);border:1px solid var(--input);background:var(--background);
  font-size:var(--font-size-small);font-weight:var(--font-weight-medium);color:var(--foreground)}
.chipc i{width:9px;height:9px;border-radius:2px;display:block}
.chipc:hover{border-color:var(--primary);color:var(--primary)}

/* ---------------- anatomy ---------------- */
.anat{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:16px}
@media(max-width:1500px){.anat{grid-template-columns:1fr}}
.layerlist{display:grid;gap:5px}
.layer{display:grid;grid-template-columns:14px 1fr auto;gap:10px;align-items:center;text-align:left;
  padding:8px 11px;border-radius:var(--radius-md);border:1px solid var(--border);background:var(--background);width:100%}
.layer:hover{border-color:var(--primary)}
.layer[aria-current="true"]{border-color:var(--primary);background:var(--accent)}
.layer i{height:22px;border-radius:3px;display:block}
.layer strong{display:block;font-size:var(--font-size-normal);font-weight:var(--font-weight-medium)}
.layer small{display:block;font-size:var(--font-size-small);color:var(--muted-foreground);margin-top:1px}
.layer em{font-style:normal;font-size:10px;color:var(--faint)}
.anat-detail h3{font-size:var(--font-size-h2);font-weight:var(--font-weight-medium)}
.anat-spec{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin:12px 0}
.anat-spec div{padding:9px 11px;border-radius:var(--radius-md);background:var(--background);border:1px solid var(--border)}
.anat-spec small{display:block;font-size:var(--font-size-small);color:var(--faint)}
.anat-spec b{display:block;font-size:var(--font-size-normal);font-weight:var(--font-weight-medium);margin-top:2px;line-height:1.45}
.anat p{color:var(--muted-foreground);font-size:var(--font-size-normal);line-height:1.65}
.anat p b{color:var(--foreground);font-weight:var(--font-weight-medium)}

/* ---------------- material flow ---------------- */
.chain{display:grid;gap:0}
.chain-row{display:grid;grid-template-columns:140px 22px minmax(0,1fr);align-items:stretch}
.chain-by{padding:12px 10px 12px 0;text-align:right}
.chain-by button{font-size:var(--font-size-small);font-weight:var(--font-weight-medium);color:var(--primary);
  text-align:right;line-height:1.4}
.chain-by button:hover{text-decoration:underline}
.chain-by small{display:block;font-size:10px;color:var(--faint);font-weight:var(--font-weight-normal)}
.chain-spine{position:relative}
.chain-spine::before{content:"";position:absolute;left:50%;top:0;bottom:0;width:2px;transform:translateX(-50%);
  background:var(--border-strong)}
.chain-row:first-child .chain-spine::before{top:26px}
.chain-row:last-child .chain-spine::before{bottom:calc(100% - 26px)}
.chain-spine i{position:absolute;left:50%;top:20px;width:11px;height:11px;border-radius:50%;
  transform:translateX(-50%);background:var(--background);border:2px solid var(--primary)}
.chain-state{padding:10px 0 14px 14px}
.chain-state strong{display:block;font-size:var(--font-size-h3);font-weight:var(--font-weight-medium)}
.chain-state em{font-style:normal;display:inline-block;margin-top:3px;margin-right:5px;padding:1px 8px;
  border-radius:var(--radius-full);background:var(--card);border:1px solid var(--border);
  font-size:var(--font-size-small);color:var(--muted-foreground)}
.chain-state span{display:block;color:var(--muted-foreground);font-size:var(--font-size-normal);
  line-height:1.6;margin-top:5px;max-width:90ch}

/* ---------------- matrix ---------------- */
.mtxwrap{width:100%;overflow-x:auto;scrollbar-width:thin}
.mtx{width:100%;min-width:820px;border-collapse:collapse;color:var(--foreground);font:inherit;text-align:start}
.mtx :is(th,td){padding:7px 4px;text-align:center;border-bottom:1px solid var(--border);vertical-align:middle}
.mtx thead th{position:sticky;top:0;background:var(--background);z-index:2;vertical-align:bottom;
  font-size:var(--font-size-small);font-weight:var(--font-weight-strong);line-height:1.25;padding-bottom:8px;
  border-bottom-color:var(--border-strong)}
.mtx thead th i{display:block;height:4px;border-radius:2px;margin:0 auto 5px;width:22px}
.mtx th.rowh{text-align:left;position:sticky;left:0;background:var(--background);z-index:1;
  font-weight:var(--font-weight-normal);font-size:var(--font-size-normal);padding-left:8px;white-space:nowrap}
.mtx tbody tr:last-child :is(th,td){border-bottom:0}
.mtx tbody tr:hover th.rowh,.mtx tbody tr:hover td{background:var(--card)}
.mtx td button{width:26px;height:26px;border-radius:var(--radius-sm);font-size:12px;line-height:1;margin:0 auto;display:block}
.mtx td[data-k="make"] button{background:color-mix(in srgb,var(--primary) 20%,transparent);color:var(--primary)}
.mtx td[data-k="shape"] button{background:color-mix(in srgb,var(--warning) 22%,transparent);color:var(--warning)}
.mtx td[data-k="risk"] button{background:color-mix(in srgb,var(--destructive) 18%,transparent);color:var(--destructive)}
.mtx td[data-k="check"] button{background:color-mix(in srgb,var(--green) 18%,transparent);color:var(--green)}
.mtx td[data-k="both"] button{background:linear-gradient(135deg,
  color-mix(in srgb,var(--primary) 22%,transparent) 50%,
  color-mix(in srgb,var(--destructive) 20%,transparent) 50%);color:var(--foreground)}
.mtx td button:hover{outline:2px solid var(--primary)}
.legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:12px;font-size:var(--font-size-small);color:var(--muted-foreground)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend b{width:22px;height:22px;border-radius:var(--radius-sm);display:grid;place-items:center;font-size:11px}

/* ---------------- references ---------------- */
.reflist{display:grid;gap:9px}
.refitem{display:grid;grid-template-columns:32px 1fr;gap:12px;padding:12px 14px;border-radius:var(--radius-md);
  border:1px solid var(--border);background:var(--background);scroll-margin-top:80px}
.refitem:target{border-color:var(--primary);background:var(--accent)}
.refitem .rn{width:26px;height:26px;border-radius:var(--radius-sm);background:var(--primary);
  color:var(--primary-foreground);display:grid;place-items:center;font-size:11px;font-weight:var(--font-weight-strong)}
.refitem p{font-size:var(--font-size-normal);line-height:1.6}
.refitem .used{display:block;color:var(--muted-foreground);font-size:var(--font-size-small);line-height:1.55;margin-top:5px}
.refitem .used b{color:var(--foreground);font-weight:var(--font-weight-medium)}
.refitem a{display:inline-block;margin-top:6px;color:var(--primary);font-size:var(--font-size-small);word-break:break-all}
.srcline{margin-top:11px;padding-top:9px;border-top:1px solid var(--border);font-size:var(--font-size-small);
  color:var(--muted-foreground);display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.srcline button{min-height:24px;padding:0 9px;border-radius:var(--radius-full);border:1px solid var(--input);
  background:var(--background);font-size:var(--font-size-small);font-weight:var(--font-weight-medium);color:var(--primary)}
.srcline button:hover{background:var(--primary);color:var(--primary-foreground);border-color:transparent}
.side-layers{margin:0 0 4px}
.side-layers .stage-btn b{font-size:10px}

@media(prefers-reduced-motion:reduce){
  *{animation-duration:.001ms!important;transition-duration:.001ms!important}
}
</style>
</head>
<style>
/* ---- machine schematic ---- */
.mSteel{fill:light-dark(#e4e9ec,#3a4247);stroke:light-dark(#a9b6bd,#5d686e);stroke-width:1.5}
.mSteel2{fill:light-dark(#f0f3f5,#454e54);stroke:light-dark(#b6c2c8,#6a757b);stroke-width:1.5}
.mDark{fill:light-dark(#3f4a51,#8b979e);stroke:light-dark(#2c353a,#a7b2b8);stroke-width:1.5}
.mGlass{fill:light-dark(#dceaf4,#2c3b45);stroke:light-dark(#93b6ca,#5a7180);stroke-width:1.5}
.mHot{fill:var(--hot);stroke:light-dark(#a63d1f,#f0a184);stroke-width:1.5}
.mHotSoft{fill:light-dark(#f0a184,#8a4229);stroke:light-dark(#c9714f,#c9714f);stroke-width:1.2}
.mCu{fill:var(--copper);stroke:light-dark(#8a5323,#d99a5f);stroke-width:1.2}
.mAl{fill:var(--alu);stroke:light-dark(#8b9ba5,#c7d4db);stroke-width:1.2}
.mAn{fill:var(--anode);stroke:light-dark(#4d5c64,#7d8e97);stroke-width:1.2}
.mCa{fill:var(--cathode);stroke:light-dark(#3f7f68,#7cc0a8);stroke-width:1.2}
.mSep{fill:var(--sep);stroke:light-dark(#b8b183,#a49d76);stroke-width:1.2}
.mEl{fill:var(--elyte);stroke:light-dark(#2b6485,#7ab6d6);stroke-width:1.2}
.mAcc{fill:var(--primary);stroke:light-dark(#1f7fd6,#a9d5ff);stroke-width:1.2}
.mLine{stroke:light-dark(#8b979e,#7d888e);stroke-width:1.4;fill:none}
.mPipe{stroke:var(--elyte);stroke-width:5;fill:none;stroke-linecap:round}
.mWeb{stroke:var(--copper);stroke-width:4;fill:none;stroke-linecap:round}
.mWebA{stroke:var(--anode);stroke-width:5;fill:none;stroke-linecap:round}
.mWebS{stroke:var(--sep);stroke-width:3.5;fill:none;stroke-linecap:round}
.mTxt{fill:var(--foreground);font-size:11px;font-weight:600}
.mTxtS{fill:var(--muted-foreground);font-size:9.5px;font-weight:500}
.mTxtW{fill:#fff;font-size:10px;font-weight:700}
/* halo: lines, webs and selection rings duck behind every label */
.mTxt,.mTxtS{paint-order:stroke fill;stroke:var(--background);stroke-width:3.2;
  stroke-linejoin:round;stroke-linecap:round}
.mTxt.onpanel,.mTxtS.onpanel{stroke:none}
.mLead{stroke:light-dark(#9aa6ac,#77838a);stroke-width:1;fill:none}
.mArrow{fill:var(--primary)}
.spin{transform-box:fill-box;transform-origin:center}
.is-run .spin{animation:mspin 2.6s linear infinite}
.is-run .flowdash{animation:mdash 1.1s linear infinite}
.is-run .puff{animation:mpuff 2.2s ease-in-out infinite}
.is-run .bob{animation:mbob 2.4s ease-in-out infinite}
.flowdash{stroke-dasharray:9 7}
@keyframes mspin{to{transform:rotate(360deg)}}
@keyframes mdash{to{stroke-dashoffset:-32}}
@keyframes mpuff{0%,100%{opacity:.25;transform:translateY(0)}50%{opacity:.75;transform:translateY(-7px)}}
@keyframes mbob{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
</style>

<body>
<h1 class="sr">CellForge — Lithium-ion Cell Production Simulator</h1>
<div class="app">

  <aside class="sidebar">
    <div class="brand">
      <div class="mark">CF</div>
      <div><strong>CellForge</strong><small>PRODUCTION SIMULATOR</small></div>
    </div>

    <button type="button" class="tour-btn" id="tourStart"><span>▶</span>Start the guided factory tour</button>

    <div class="route">
      <small>CELL FORMAT — CHANGES THE LINE</small>
      <div class="route-opts" id="routeOpts" role="group" aria-label="Cell format">
        <button type="button" data-route="pouch" aria-pressed="true">Pouch</button>
        <button type="button" data-route="cyl" aria-pressed="false">Cylindrical</button>
        <button type="button" data-route="prism" aria-pressed="false">Prismatic</button>
      </div>
    </div>

    <div class="route side-layers">
      <small>THE BIG PICTURE</small>
      <div id="layerNav" style="display:grid;gap:2px"></div>
    </div>

    <nav id="nav" aria-label="Production stations"></nav>

    <div class="side-foot">
      Process data after PEM RWTH Aachen, <em>Production Process of a Lithium-Ion Battery Cell</em>.
      Training simulation — site SOPs always govern.
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div class="crumb">LINE A-17 · <span id="crumbRoute">POUCH</span><b id="crumbTitle">Factory overview</b></div>
      <div class="topbar-right">
        <span class="pill"><b>Reference chemistry</b>&nbsp; graphite / NMC</span>
        <span class="pill" id="pillEnv"><i></i><b>—</b></span>
        <span class="pill">Station <b id="pillPos">—</b></span>
        <button type="button" class="runbtn" id="runBtn" aria-pressed="true">⏸ Pause line</button>
      </div>
    </header>

    <div class="content">
      <section id="overview"></section>
      <section id="stationView" hidden></section>
      <section id="layerView" hidden></section>
    </div>
  </main>

  <aside class="rail" aria-label="Illustrative process model">
    <div class="rail-head">
      <div><small>ILLUSTRATIVE PROCESS MODEL</small><strong>Line condition</strong></div>
      <span class="live" id="liveTag">● RUNNING</span>
    </div>

    <div class="gauge-wrap">
      <div class="gauge" id="gauge" style="--v:97"><div><b id="yieldVal">97.4</b><span>% PROCESS<br>HEALTH</span></div></div>
      <div style="flex:1">
        <div class="metric"><div><span>Coating uniformity</span><b id="mUniT">99%</b></div><i><b id="mUniB" style="width:99%"></b></i></div>
        <div class="metric"><div><span>Moisture control</span><b id="mMoiT">98%</b></div><i><b id="mMoiB" style="width:98%"></b></i></div>
        <div class="metric"><div><span>Risk-control score</span><b id="mSafT">99%</b></div><i><b id="mSafB" style="width:99%"></b></i></div>
      </div>
    </div>

    <div class="rail-title"><span>SETPOINT LAB</span><button type="button" id="resetBtn">RESET</button></div>
    <div id="sliders"></div>

    <div class="advice" id="advice" data-level="ok">
      <strong>Model inside the training window</strong>
      <span>Move a setpoint and the illustrative downstream relationships recalculate.</span>
    </div>

    <div class="rail-title" style="margin-top:18px"><span>REFERENCE CELL OUTPUTS</span></div>
    <div class="kpi" id="cellKpi" style="grid-template-columns:1fr 1fr"></div>
  </aside>
</div>

<section class="tour" id="tour" data-open="0" role="dialog" aria-modal="true" aria-labelledby="tourTitle" aria-describedby="tourText" tabindex="-1">
  <button type="button" class="tour-close" id="tourClose" aria-label="Close tour">×</button>
