  `<path class="mLine" d="M${x} ${y}L${x + 8} ${y - 8}"/>` +
  `<circle class="mDark" cx="${x}" cy="${y}" r="2"/>` + T(x, y + 27, label, "mTxtS", "middle") + `</g>`;
const ARROW = (x, y, dir = 1) =>
  `<path class="mArrow" d="M${x} ${y}l${14 * dir} 0l${-4 * dir} -4l${9 * dir} 4l${-9 * dir} 4l${4 * dir} -4z"/>`;
const NOZZLES = (x, y, n, w, down = true) => {
  let s = "";
  for (let i = 0; i < n; i++) {
    const cx = x + i * w;
    s += `<path class="mEl" d="M${cx} ${y}l4 0l0 ${down ? 7 : -7}l-2 ${down ? 4 : -4}l-2 ${down ? -4 : 4}z"/>`;
  }
  return s;
};

