  const inside = S[k] >= c.good[0] && S[k] <= c.good[1];
  const full = c.good[0] <= c.min && c.good[1] >= c.max;
  if (full && S[k] >= c.good[0] && S[k] <= c.good[1]) return "";   /* nothing to warn about */
  const dec = c.step < 1 ? String(c.step).split(".")[1].length : 0;
  return `<div class="winbar" title="Recommended window ${c.good[0]}–${c.good[1]}${c.unit || ""}">
      <i style="left:${p(c.good[0])}%;width:${(p(c.good[1]) - p(c.good[0])).toFixed(1)}%"></i>
      <b data-in="${inside}" style="left:${p(S[k])}%"></b>
    </div>
    <small class="winmsg" data-in="${inside}">${inside
      ? (full ? "whole range is inside the recommended window"
              : `inside the recommended window, ${c.good[0].toFixed(dec)}–${c.good[1].toFixed(dec)}${c.unit || ""}`)
      : `outside the recommended window of ${c.good[0].toFixed(dec)}–${c.good[1].toFixed(dec)}${c.unit || ""} — expect trouble`}</small>`;
}
</script>
<script>
/* =====================================================================
   RENDERING + INTERACTION
   ===================================================================== */

/* ---------------- sidebar ---------------- */
function renderNav() {
  renderLayerNav();
  const list = active();
  $("nav").innerHTML = PHASES.map(([p, col]) => {
    const items = list.filter(s => s.phase === p);
    if (!items.length) return "";
    return `<div class="phase"><div class="phase-title"><i style="background:${col}"></i>${p}</div>` +
      items.map(s => {
        const n = list.indexOf(s) + 1;
        return `<button type="button" class="stage-btn" data-go="${s.id}" aria-current="${current === s.id}">
          <b>${String(n).padStart(2, "0")}</b><em>${esc(s.title)}</em>
          <i style="background:${col}"></i></button>`;
      }).join("") + `</div>`;
  }).join("");
}

/* ---------------- overview ---------------- */
const WORD = {12:"Twelve", 13:"Thirteen", 14:"Fourteen", 15:"Fifteen"};
function renderOverview() {
  const m = model(), list = active(), g = GEOM[route];
  $("overview").innerHTML = `
    <div class="card card-pad">
      <span class="eyebrow">Production simulator · ${g.name.toLowerCase()} line</span>
      <h2 style="font-size:22px;letter-spacing:-.02em;margin:6px 0 8px">Walk the line from powder to packed cell</h2>
      <p class="lede" style="max-width:78ch">${WORD[list.length] || list.length} stations, drawn as the machines you would actually stand next to. Pick any
      station to open its machine, hover any part to learn what it does, and use the setpoint lab on the right —
      every change updates the teaching relationships and reference-line estimates shown below.</p>
    </div>

    <div class="grid2">
      <div class="card card-pad block">
        <h4><i style="background:var(--green)"></i>Reference recipe</h4>
        <p class="lede"><b>Graphite negative electrode · NMC positive electrode.</b> The material properties, voltage guidance and simplified capacity relationships apply only to this reference chemistry. LFP, silicon-rich, sodium and solid-state routes require different inputs and process windows. The wet and dry electrode routes are both modelled, but both on this same chemistry.</p>
      </div>
      <div class="card card-pad block">
        <h4><i style="background:var(--elyte)"></i>Model scope</h4>
        <p class="lede">Published sources support the process sequence and displayed operating ranges. Capacity, throughput, wetting, process-health and risk-control outputs are illustrative teaching relationships. They are not calibrated plant predictions, equipment-sizing calculations or release criteria.</p>
      </div>
    </div>

    <div class="card card-pad">
      <h4><i style="background:var(--primary)"></i>What the 5th edition changed${r(1)}</h4>
      <p class="lede" style="max-width:84ch;margin-bottom:10px">This simulator follows the February 2026 edition of the
      PEM RWTH Aachen and VDMA process guide. Four things in it are new here.</p>
      <div class="newRow">
        <button type="button" class="newCard" data-go="view:machine">
          <b>The line on one screen</b>
          <span>A control-room view of every station at once, with a lamp per machine, plus the four halls in plan so
          you can see where each one physically stands.</span><u>Open the machine overview →</u></button>
        <button type="button" class="newCard" data-newgo="proc:dry">
          <b>A second electrode route</b>
          <span>Dry coating is now a station of its own. Switch the line from Wet to Dry in the sidebar and four wet-processing stages
          are replaced by two dry stages — no process solvent or dryer, with a reported potential 45% process-energy reduction.</span>
          <u>Switch to the dry route →</u></button>
        <button type="button" class="newCard" data-go="view:radar">
          <b>A technology radar</b>
          <span>44 technologies scored against use in series production, split between what changes the process and what
          changes the product.</span><u>Open the radar →</u></button>
        <button type="button" class="newCard" data-go="view:factory">
          <b>What the machines cost</b>
          <span>A machinery and equipment investment range for every station, against a 10 GWh reference plant — plus
          the building and the air each phase needs.</span><u>Open the cost view →</u></button>
        <button type="button" class="newCard" data-go="${proc === "dry" ? "drymix" : "mixing"}">
          <b>Updated recipes and windows</b>
          <span>Electrode formulations, mixing time, aging state of charge, deep-draw depth and formation duration all
          moved. Every station carries an Innovations and trends box.</span><u>Start at ${proc === "dry" ? "dry mixing" : "wet mixing"} →</u></button>
      </div>
    </div>

    <div class="card card-pad">
      <span class="eyebrow">The line</span>
      <div class="map" style="margin-top:10px">
        ${PHASES.map(([p, col]) => {
          const items = list.filter(s => s.phase === p);
          if (!items.length) return "";
          return `<div><div style="font-size:9px;font-weight:900;letter-spacing:.13em;color:var(--faint);margin-bottom:6px">
            <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:${col};margin-right:6px"></span>${p.toUpperCase()}</div>
            <div class="map-row">${items.map(s => {
              const n = list.indexOf(s) + 1;
              return `<button type="button" class="map-node" data-go="${s.id}">
                <b>${String(n).padStart(2, "0")}</b><strong>${esc(s.title)}</strong>
                <small>${esc(s.env.iso)}${s.env.dew !== "—" ? " · " + esc(s.env.dew) : ""}</small>
                <i style="background:${col}"></i></button>`;
            }).join("")}</div></div>`;
        }).join("")}
      </div>
    </div>

    <div class="card card-pad">
      <span class="eyebrow">Illustrative reference-line estimates</span>
      <div class="kpi" style="margin-top:10px">
        <div><small>Reference capacity estimate</small><b>${m.cellAh.toFixed(1)} Ah</b><span>${g.unit}</span></div>
        <div><small>Illustrative cells per day</small><b>${fmt(m.cellsDay)}</b><span>assumes one 1 m line and 85% uptime</span></div>
        <div><small>Illustrative annual output</small><b>${m.gwh.toFixed(1)} GWh</b><span>simplified geometry and uptime estimate</span></div>
        <div><small>Process-health score</small><b>${m.yieldPct.toFixed(1)}%</b><span>teaching score, not a factory-yield prediction</span></div>
        <div><small>Coating porosity</small><b>${m.por.toFixed(0)}%</b><span>set by calender line force</span></div>
        <div><small>N/P ratio</small><b>${m.np.toFixed(2)}</b><span>anode capacity ÷ cathode capacity</span></div>
      </div>
      <div class="srcline">Cell geometry, foil thicknesses and plant-scale assumptions follow ${
        [1,2,13].map(n => `<button type="button" data-ref="${n}">${n} · ${esc(refMap[n].tag)}</button>`).join("")}</div>
    </div>

    <div class="grid2">
      <div class="card card-pad block">
        <h4><i style="background:var(--green)"></i>How to read this simulator</h4>
        <ul>
          <li><b>Every station is a real machine.</b> The schematics follow the PEM RWTH Aachen process figures — unwinders, slot die, four-chamber dryer, calender nip, punching unit, Z-folder, formation racks.</li>
          <li><b>Hover or tab any part</b> of a machine to get its job, its setpoints and why it matters.</li>
          <li><b>The setpoint lab is live.</b> Coat thickness, line speed, dryer temperature, calender force, vacuum drying time, formation C-rate and aging period all feed one model.</li>
          <li><b>Change the cell format</b> in the sidebar and the line itself changes — the pouch route separates and stacks sheets, the can routes wind a jelly roll instead.</li>
          <li><b>Change the electrode route</b> and it changes again. The wet line coats a slurry and then dries and calenders it; the dry line fibrillates the binder and does all three in one nip. Four stations become one.</li>
          <li><b>Start with the big picture.</b> <button type="button" data-go="view:machine" style="color:var(--green);font-weight:800;text-decoration:underline">Machine overview</button> puts the whole line on one screen; <button type="button" data-go="view:anatomy" style="color:var(--green);font-weight:800;text-decoration:underline">cell anatomy</button> shows what you are building and who builds each layer; <button type="button" data-go="view:flow" style="color:var(--green);font-weight:800;text-decoration:underline">material flow</button> follows one material through every state; <button type="button" data-go="view:matrix" style="color:var(--green);font-weight:800;text-decoration:underline">process ↔ component</button> maps every station onto every part of the cell; the <button type="button" data-go="view:radar" style="color:var(--green);font-weight:800;text-decoration:underline">technology radar</button> shows what is coming next, and <button type="button" data-go="view:factory" style="color:var(--green);font-weight:800;text-decoration:underline">factory &amp; environment</button> covers the building, the air and the bill.</li>
        </ul>
      </div>
      <div class="card card-pad block">
        <h4><i style="background:var(--destructive)"></i>Three major defect drivers</h4>
        <ul>
          <li><b>Particles and burrs.</b> A burr from slitting or a particle rolled in at the calender can pierce the separator. A severe internal short can create local heating that external controls may not stop; prevention depends on cleanliness, edge quality, separator integrity and screening.</li>
          <li><b>Water.</b> Residual water can hydrolyse LiPF₆ and generate HF-containing species that degrade electrolyte and interfaces. That is why the dew point drops station by station to −50…−70 °C at electrolyte filling.</li>
          <li><b>Cross-contamination.</b> Anode and cathode powders look identical and are both black. Mixing rooms are commonly separated to reduce this risk.</li>
        </ul>
      </div>
    </div>`;
}

/* ---------------- station ---------------- */
function renderStation(st) {
  const list = active(), n = list.indexOf(st) + 1, m = model(), col = phaseColor(st.phase);
  $("stationView").innerHTML = `
    <div class="machine ${running ? "is-run" : ""}" id="machineWrap">
      <div class="machine-head">
        <h3>${String(n).padStart(2, "0")} · ${esc(st.title)}</h3>
        <div class="tag">
          <span>${esc(st.env.iso)}</span>
          ${st.env.dew !== "—" ? `<span>Dew point ${esc(st.env.dew)}</span>` : ""}
          <span>${esc(st.env.temp)}</span>
          <span>${esc(st.takt)}</span>
        </div>
      </div>
      <svg viewBox="0 0 980 318" role="img" aria-label="${esc(st.title)} machine schematic"
           style="${machineStyle(st, m)}">${M[st.machine]()}</svg>
      <div class="readout" id="readout"></div>
    </div>

    <div class="card card-pad">
      <span class="eyebrow" style="color:${col}">${esc(st.phase)}</span>
      <h2 style="font-size:20px;letter-spacing:-.02em;margin:5px 0 7px">${esc(st.purpose)}</h2>
      <div class="flow" style="margin-top:12px">
        <div class="flow-box"><small>Arrives as</small><strong>${esc(st.inp)}</strong></div>
        <div class="flow-arrow">→</div>
        <div class="flow-box"><small>Leaves as</small><strong>${esc(st.out)}</strong></div>
      </div>
      <div class="env" style="margin-top:12px">
        <div><small>Clean room${r(1,9)}</small><b>${esc(st.env.iso)}</b></div>
        <div><small>Dry room${r(1,5)}</small><b>${esc(st.env.dew)}</b></div>
        <div><small>Temperature${r(1)}</small><b>${esc(st.env.temp)}</b></div>
        <div><small>Machine investment${r(1)}</small><b>${esc(st.cost)}</b></div>
      </div>
      ${madeHTML(st)}
    </div>

    <div class="grid2">
      <div class="card card-pad block">
        <h4><i style="background:var(--green)"></i>Process parameters &amp; requirements</h4>
        <ul>${st.params.map(p => `<li>${p}</li>`).join("")}</ul>
        <div class="srcline">Sources for this station: ${(SRC[st.id] || [1]).map(n =>
          `<button type="button" data-ref="${n}">${n} · ${esc(refMap[n].tag)}</button>`).join("")}</div>
      </div>
      <div class="card card-pad block">
        <h4><i style="background:var(--jelly)"></i>Technology alternatives</h4>
        <ul>${st.alts.map(p => `<li>${p}</li>`).join("")}</ul>
        ${(st.innov || []).length ? `
        <h4 style="margin-top:14px"><i style="background:var(--primary)"></i>Innovations &amp; trends${r(1)}</h4>
        <ul>${st.innov.map(p => `<li>${p}</li>`).join("")}</ul>` : ""}
      </div>
    </div>

    <div class="grid2">
      <div class="card card-pad block">
        <h4><i style="background:var(--warning)"></i>Quality influences</h4>
        <ul>${st.qInf.map(p => `<li>${p}</li>`).join("")}</ul>
