    ["Buffer tank","HOLD","Stirred and filtered storage keeps the slurry homogeneous while the coater draws from it. Sedimentation here shows up as a streak on the electrode."],
    ["Release gate","QC","Viscosity, particle size and foreign-object count are checked before the batch is released to coating."]],
  params:["α: 0°–10°","Mixing time 30 min – 5 h","20 °C – 40 °C","Protective gas, vacuum or clean-room air","Separate mixers for anode and cathode"],
  alts:["Intensive, planetary and dissolver mixers all in use","Continuous mixing in an extruder, fed straight to coating"],
  qInf:["Mixing and dispersing sequence","Filter media and filter system","Shear forces","Mixing temperature"],
  qFeat:["Homogeneity of the slurry","Particle size","Purity — foreign objects","Viscosity"],
  sop:["Verify material identity and lot against the recipe","Confirm the vessel is clean and dedicated to this polarity","Load the approved dosing sequence","Dry mix, then add solvent and disperse","Sample viscosity and particle size","Release under seal to the buffer tank"] },

{ id:"coating", no:"02", phase:"Electrode manufacturing", title:"Coating", machine:"coating", routes:ALL,
  env:{iso:"ISO 7", dew:"semi-dry, +5…−5 °C", temp:"22 ± 2 °C"}, cost:"€ 16–35 M (coating + drying)", takt:"35–80 m/min",
  purpose:"Meter slurry onto the current-collector foil at a controlled wet-film thickness, one side at a time.",
  inp:"Bare Cu or Al foil, 5–25 µm", out:"Foil coated on one side",
  parts:[
    ["Slurry storage","SUPPLY","A stirred, filtered vessel feeds the die. Any settled solid becomes a visible defect on the web."],
    ["Precision pump","METER","Flow rate sets coat weight together with web speed. Pump precision is one of the three named quality influences on this station."],
    ["Slot die","APPLY","The application tool. Slot die is standard; doctor blade and anilox roller are alternatives. Gap between die lip and foil sets wet thickness."],
    ["Application roll","BACKING","Supports the foil against the die and defines the coating plane. Roll runout prints straight through to thickness."],
    ["Foil unwind","INFEED","Copper for the anode, aluminium for the cathode, 5–25 µm thick, up to 1 500 mm wide. Purchased, not made in house."],
    ["Intermittent coating","PATTERN","Coating can be continuous or intermittent. Intermittent leaves bare foil windows that later become the welded tabs — this is the pouch route."],
    ["Wet-film gauge","MEASURE","Measures wet layer thickness immediately after the die, before any solvent is lost. Dry coating accuracy target is ±2 g/m²."],
    ["Rewind","OUTFEED","The one-side-coated roll is rewound and returned for a second pass, or fed straight to a second die in a tandem line."]],
  params:["Dry film per side: anode 50–100 µm, cathode 40–80 µm","Coating speed 35–80 m/min","Coating width up to 1 500 mm","Dry coating accuracy ±2 g/m²"],
  alts:["Slot die, doctor blade or anilox roller","Simultaneous two-sided coating with opposed dies","Dry coating — active material applied as powder, no solvent"],
  qInf:["Surface quality and layer-thickness monitoring","Choice of application tool","Precision of the slurry pump"],
  qFeat:["Coating thickness accuracy along and across the web","Surface quality — blowholes, particles","Adhesion between coating and substrate"],
  sop:["Scan slurry batch and foil roll IDs","Thread the web through the precision rollers","Set die gap and pump flow for the target coat weight","Start at reduced speed and ramp","Verify wet-film profile across the width","Release the first article before full speed"] },

{ id:"drying", no:"03", phase:"Electrode manufacturing", title:"Drying", machine:"drying", routes:ALL,
  env:{iso:"ISO 7", dew:"semi-dry, +5…−5 °C", temp:"22 ± 2 °C"}, cost:"included with coating", takt:"dryer up to 100 m long",
  purpose:"Evaporate the solvent and bake the coating onto the foil without cracking it or losing adhesion.",
  inp:"Wet-coated web", out:"Dry electrode web, cooled",
  parts:[
    ["Exhaust manifold","EXTRACT","Solvent vapour is highly flammable and is captured for recovery or thermal afterburning. NMP is recovered; water is simply vented."],
    ["Chamber 1 — preheat","RAMP","The first zone raises the web gently. Too fast here and the surface skins over, trapping solvent underneath."],
    ["Chamber 2 — main evaporation","EVAPORATE","Bulk solvent leaves here. Air nozzles above and below both heat the web and float it."],
    ["Chamber 3 — peak","PEAK","The hottest zone, up to 160 °C. Overshoot cracks the coating and can pull binder to the surface."],
    ["Chamber 4 — finish","LEVEL","Brings residual solvent down to specification and evens the profile before cooling."],
    ["Web infeed","TENSION","Foil pre-tensioning is called out explicitly: get it wrong and the thin foil tears inside a hot dryer."],
    ["Cooling rolls","COOL","Chilled rolls bring the web back to room temperature so it can be rewound, or fed directly to the second-side coater in a tandem line."]],
  params:["Drying speed 35–80 m/min","Dryer length up to 100 m","Zone profile 50 °C – 160 °C","Solvent recovery, thermal afterburning","Foil pre-tensioning to avoid tears"],
  alts:["Infrared drying added to convection — shorter and more efficient","Laser drying — shortens the dryer dramatically, still in development"],
  qInf:["Process parameters matched to the electrode design","Choice of foil pretension","Temperature profile"],
  qFeat:["Adhesion between coating and substrate","Residual humidity","Surface finish — cracks, inclusions"],
  sop:["Confirm exhaust and LEL monitoring are live","Load the zone temperature profile","Verify web tension setpoint","Start airflow before heat","Track solvent loading through the run","Cool below handling temperature before rewind"] },

{ id:"calendering", no:"04", phase:"Electrode manufacturing", title:"Calendering", machine:"calendering", routes:ALL,
  env:{iso:"ISO 7", dew:"semi-dry, +5…−5 °C", temp:"22 ± 2 °C"}, cost:"€ 5–10 M", takt:"60–100 m/min",
  purpose:"Compress the porous coating to a defined thickness, density and porosity — this is where energy density is set.",
  inp:"Dry electrode, ≈50% porosity", out:"Compacted electrode, 20–40% porosity",
  parts:[
    ["Unwind","INFEED","The dried mother roll enters under controlled tension and edge guidance."],
    ["Static discharge","NEUTRALISE","The web is statically discharged first. Charged foil can attract particles that later damage or pierce the separator."],
    ["Clean + suction","CLEAN","Brushes or air flow plus extraction. Roller cleanliness is called out as crucial — a particle rolled into the coating is a latent short circuit."],
    ["Roller pair","COMPACT","Top and bottom rollers apply a precisely defined line pressure, up to 2 500 N/mm. Rollers can be heated to 50–250 °C to make the coating more ductile."],
    ["Thickness gauge","MEASURE","Closes the loop on final thickness. Line pressure sets porosity, and porosity sets how well the electrode later wets with electrolyte."],
    ["Clean + suction","CLEAN","A second cleaning stage after the nip removes anything the compaction shook loose."],
    ["Rewind","OUTFEED","Roll-to-roll: the calendered web is wound back up for slitting."]],
  params:["Line pressure up to 2 500 N/mm","Speed 60–100 m/min","Porosity reduced from ≈50% to 20–40%","Roller preheating 50 °C – 250 °C"],
  alts:["Hot rollers — water or oil heated, to set ductility precisely"],
  qInf:["Line pressure","Roller material and diameter","Surface accuracy and concentricity of the rollers","Roller temperature"],
  qFeat:["Defined porosity","Surface texture","Adhesion between coating and substrate"],
  sop:["Inspect roller surfaces for damage and debris","Confirm static neutralisation is active","Set gap and line pressure for the target porosity","Run a leader and measure","Verify the thickness profile across the width","Rewind under controlled tension"] },

{ id:"slitting", no:"05", phase:"Electrode manufacturing", title:"Slitting", machine:"slitting", routes:ALL,
  env:{iso:"ISO 7 – ISO 8", dew:"semi-dry, +5…−5 °C", temp:"22 ± 2 °C"}, cost:"€ 3–8 M", takt:"80–150 m/min",
  purpose:"Cut the wide mother roll into daughter rolls of the exact width the cell design needs — without leaving a burr.",
  inp:"Calendered mother roll, up to 1 500 mm", out:"Daughter rolls, 60–300 mm",
  parts:[
    ["Mother roll","INFEED","The full-width calendered roll, fed in by manual transport from the calender."],
    ["Coated web","MATERIAL","Intermittent coating for the pouch route, continuous coating for prismatic and cylindrical. The cut lines fall in the bare foil."],
    ["Rolling knives + suction","CUT","Rolling knives are standard. Cut quality and coil cleanliness are the two main quality criteria — a burr on the edge can pierce the separator and short the finished cell."],
    ["Separated strips","SEPARATE","The web leaves as parallel strips, edge trim extracted away."],
    ["Daughter rolls","OUTFEED","Rewound individually, 60–300 mm wide depending on cell design, cleaned by suction and brushes."]],
  params:["Cutting speed 80–150 m/min","Suction for the separated edge strips","Width tolerance ±150 µm to ±250 µm","Burr-free cutting"],
  alts:["Laser slitting — more flexible, but risks a heat-affected zone and more dust contamination"],
  qInf:["Finish of the cutting blades","Parameters matched to coating thickness","Extraction of dust and cutting waste"],
  qFeat:["Edge geometry — cutting burr","Thermal and mechanical stress at the edge","Particle contamination during cutting"],
  sop:["Check knife condition and replace on schedule","Set slit positions against the coating pattern","Confirm extraction at every knife","Run and inspect the first edges under magnification","Measure width tolerance","Label and seal each daughter roll"] },

{ id:"vacdry", no:"06", phase:"Electrode manufacturing", title:"Vacuum drying", machine:"vacdry", routes:ALL,
  env:{iso:"ISO 7 – ISO 8", dew:"dry, 0…−30 °C", temp:"22 ± 2 °C"}, cost:"€ 6–12 M", takt:"12–30 h per batch",
  purpose:"Pull the last residual moisture and solvent out of the coils before they enter the dry room.",
  inp:"Daughter rolls from slitting", out:"Coils at low residual moisture",
  parts:[
    ["Vacuum oven","DRY","Daughter rolls on a goods carrier are pushed into the oven. 12–30 h at 60–150 °C under 0.07–1 000 mbar. Low pressure lets moisture evaporate at low temperature, so the binder is not damaged."],
    ["Vacuum pump + inert gas","EVACUATE","Ovens can be run under inert gas to prevent corrosion of the foils. Many plants use the oven as an air lock into the dry room."],
    ["Loaded shelves","BATCH","Section view: coils sit on shelves with clearance for gas flow. Constant heat supply and stable vacuum are the named quality influences."]],
  params:["0.07 mbar < p < 1 000 mbar","Drying time 12–30 h per batch","60 °C – 150 °C","Inert gas supply"],
  alts:["Continuous dryers — the web runs through a long facility instead of batch ovens","Infrared drying as a supplement"],
  qInf:["Constant heat supply and stable vacuum","Longer resting only possible in the dry room","Inert gas to prevent corrosion"],
  qFeat:["Surface condition — cracks","Residual moisture: none wanted"],
  sop:["Load coils with flow clearance between them","Close and evacuate to setpoint","Hold temperature and pressure for the recipe time","Break vacuum with inert gas","Transfer directly to the dry room or vacuum pack","Log the batch against the coil IDs"] },

{ id:"separation", no:"07", phase:"Cell assembly", title:"Separation", machine:"separation", routes:"pouch",
  env:{iso:"min. ISO 7", dew:"dry, −25…−35 °C", temp:"22 ± 2 °C"}, cost:"€ 5–10 M", takt:"≈0.2 s per sheet",
  purpose:"Cut individual anode and cathode sheets out of the daughter rolls — the pouch route only.",
  inp:"Daughter rolls", out:"Single electrode sheets",
  parts:[
    ["Daughter roll","INFEED","Dried coils are unwound and fed to the separation tool."],
    ["Intermittent-coated web","MATERIAL","The blank edge left by intermittent coating becomes the welding area for the cell tab. Cut position is referenced to the coating pattern, not the foil edge."],
    ["Punching unit","CUT","A shear cut in a continuous process, about 0.2 s per sheet. Tolerance ±200 µm in width and length. Punch wear directly degrades edge quality."],
    ["Separated sheets","SORT","Anode and cathode sheets are stored in magazines or handed straight to stacking."],
    ["Electrode stack","OUTPUT","Sheets ready for stacking. Cutting dust is extracted at the tool — it must not travel with the sheet."]],
  params:["≈0.2 s per sheet","Tolerance ±200 µm in width and length","Punching tool with very good cutting edge quality"],
  alts:["Laser ablation to expose the tab area at chosen points","Laser cutting instead of a punching tool"],
  qInf:["Heat-affected zone and suction of evaporated material when laser cutting","Tool finish","Cutting speed"],
  qFeat:["Cutting edge geometry — smearing of active material over the edge","Thermal and mechanical stress during cutting"],
  sop:["Confirm dry-room dew point before opening a coil","Reference the cut to the coating pattern","Check the first sheets for burr and smear","Verify sheet dimensions against tolerance","Confirm dust extraction at the tool","Transfer magazines without stacking damage"] },

{ id:"stacking", no:"08", phase:"Cell assembly", title:"Stacking", machine:"stacking", routes:"pouch",
  env:{iso:"min. ISO 7", dew:"dry, −40…−50 °C", temp:"22 ± 2 °C"}, cost:"€ 18–27 M", takt:"≈1 s per sheet",
  purpose:"Build the repeating anode / separator / cathode / separator stack that becomes the cell.",
  inp:"Electrode sheets + separator tape", out:"Fixed stack, up to 120 layers",
  parts:[
    ["Input magazines","FEED","Anode sheets, cathode sheets and the separator reel. Separator arrives as an endless tape."],
