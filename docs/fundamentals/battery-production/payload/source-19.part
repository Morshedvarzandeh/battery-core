   Drawn with the same primitives and the same material palette as the
   station schematics, so a colour always means the same substance.
   ===================================================================== */
const PIC_W = 372, PIC_H = 140;
const pic = body => `<svg viewBox="0 0 ${PIC_W} ${PIC_H}" role="img" aria-hidden="true">${body}</svg>`;
/* a small arrow between stages */
const pArrow = (x, y) => `<path class="mArrow" d="M${x} ${y}l10 0l-3 -3.5l7 3.5l-7 3.5l3 -3.5z"/>`;

const TOURPIC = {

/* the wet chain against the dry chain, with what the change is worth */
drychain: () => pic(`
  ${T(12, 26, "WET — FIVE STEPS", "mTxtS")}
  ${["mix", "disperse", "coating", "drying", "calender"].map((n, i) =>
    `<rect x="${12 + i * 72}" y="32" width="64" height="18" rx="3" fill="var(--warning)" opacity=".45"/>` +
    T(44 + i * 72, 45, n, "mTxtS", "middle")).join("")}
  ${T(12, 68, "DRY — TWO STEPS", "mTxtS")}
  ${["dry mix / fibrillate", "coating"].map((n, i) =>
    `<rect x="${12 + i * 136}" y="74" width="128" height="18" rx="3" fill="var(--primary)" opacity=".5"/>` +
    T(76 + i * 136, 87, n, "mTxtS", "middle")).join("")}
  ${[["35", "CapEx"], ["45", "energy"], ["55", "space"], ["70", "CO₂"]].map(([v, k], i) => {
    const x = 12 + i * 90;
    return T(x, 112, "−" + v + "%", "mTxt") + T(x + 44, 112, k, "mTxtS") +
      `<rect x="${x}" y="118" width="78" height="5" rx="2.5"
        fill="color-mix(in srgb,var(--foreground) 10%,transparent)"/>
       <rect x="${x}" y="118" width="${78 * v / 100}" height="5" rx="2.5" fill="var(--primary)" opacity=".7"/>`;
  }).join("")}
`),


/* the radar, reduced to its rings and a scatter of dots */
radar: () => pic(`
  ${[[52, "var(--jelly)", .10], [37, "var(--elyte)", .16], [22, "var(--primary)", .22]]
    .map(([r, c, o]) => `<circle cx="72" cy="70" r="${r}" fill="${c}" opacity="${o}"
      stroke="color-mix(in srgb,var(--foreground) 12%,transparent)"/>`).join("")}
  <path d="M20 70l104 0" stroke="var(--foreground)" opacity=".45"/>
  ${[[62,52],[84,56],[72,44],[96,66],[50,58],[104,80],[60,88],[86,92],[38,84],[112,52],[70,104],[46,44]]
    .map(([x, y], i) => `<circle cx="${x}" cy="${y}" r="4.5" fill="var(--background)"
      stroke="${i < 4 ? "var(--primary)" : i < 8 ? "var(--elyte)" : "var(--jelly)"}" stroke-width="1.6"/>`).join("")}
  ${T(132, 40, "44 technologies", "mTxt")}
  ${T(132, 56, "process above the line —", "mTxtS")}
  ${T(132, 68, "how the cell is made", "mTxtS")}
  ${T(132, 84, "product below it —", "mTxtS")}
  ${T(132, 96, "what the cell is", "mTxtS")}
  ${T(132, 114, "centre = already in production", "mTxtS")}
`),


/* the whole line, one block per station, coloured by phase */
line: () => pic(`
  ${[...Array(15)].map((_, i) => {
    const col = i < 6 ? "var(--warning)" : i < 10 ? "var(--elyte)" : "var(--green)";
    const x = 16 + i * 23;
    return `<rect x="${x}" y="${44 - (i % 3) * 3}" width="17" height="${40 + (i % 3) * 3}" rx="3"
      fill="${col}" opacity="${0.35 + i * 0.04}"/>`;
  }).join("")}
  ${T(16, 34, "15 stations, 3 phases", "mTxt")}
  ${T(16, 106, "electrode manufacturing", "mTxtS")}
  ${T(150, 106, "assembly", "mTxtS")}
  ${T(246, 106, "finishing", "mTxtS")}
  <circle cx="20" cy="118" r="3.5" fill="var(--warning)"/>
  <circle cx="154" cy="118" r="3.5" fill="var(--elyte)"/>
  <circle cx="250" cy="118" r="3.5" fill="var(--green)"/>
`),

/* the five-layer repeat unit */
stack: () => pic(`
  ${[["var(--alu)", 10, "Al foil"], ["var(--cathode)", 22, "cathode"], ["var(--sep)", 12, "separator"],
     ["var(--anode)", 26, "anode"], ["var(--copper)", 9, "Cu foil"]]
    .reduce((acc, [c, h, n]) => {
      const y = acc.y;
      acc.s += `<rect x="24" y="${y}" width="150" height="${h}" rx="1.5" fill="${c}"/>` +
               T(182, y + h / 2 + 3.5, n, "mTxtS");
      acc.y = y + h + 4;
      return acc;
    }, { y: 16, s: "" }).s}
  <rect x="20" y="12" width="158" height="99" rx="5" fill="none" stroke="var(--elyte)"
    stroke-width="1.4" stroke-dasharray="5 4"/>
  ${T(262, 44, "repeated", "mTxt")}${T(262, 58, "up to 120×", "mTxt")}
  ${T(262, 76, "electrolyte fills", "mTxtS")}${T(262, 88, "every pore", "mTxtS")}
  ${[0, 1, 2].map(i => `<rect x="${300 + i * 6}" y="${20 + i * 3}" width="52" height="${34 - i * 6}"
     rx="3" fill="none" stroke="var(--border-strong)"/>`).join("")}`),

/* powder → slurry → coated web → cell */
chain: () => pic(`
  ${C(34, 54, 15, "mSteel2")}
  <g class="bob">${C(29, 52, 4, "mAn")}${C(38, 57, 3.5, "mCa")}${C(34, 48, 3, "mDark")}</g>
  ${T(16, 90, "powder", "mTxtS")}
  ${pArrow(56, 54)}
  ${R(78, 40, 34, 28, "mGlass", 4)}<path class="mLine" d="M78 50q17 7 34 0"/>
  ${T(78, 90, "slurry", "mTxtS")}
  ${pArrow(120, 54)}
  ${REEL(158, 54, 15, "mCu")}<path class="mWeb" d="M173 54l38 0"/>
  ${T(140, 90, "coated web", "mTxtS")}
  ${pArrow(214, 54)}
  ${R(238, 34, 30, 40, "mSteel2", 4)}
  ${[0, 1, 2, 3].map(i => `<rect x="242" y="${39 + i * 8}" width="22" height="3" rx="1"
     fill="${i % 2 ? "var(--anode)" : "var(--cathode)"}"/>`).join("")}
  ${T(232, 90, "stack", "mTxtS")}
  ${pArrow(274, 54)}
  ${R(298, 30, 40, 48, "mSteel", 6)}${R(310, 22, 16, 9, "mAl", 2)}
  ${T(296, 90, "packed cell", "mTxtS")}
  ${T(16, 20, "one material, changed at every station", "mTxt")}`),

/* two powders, kept apart */
powders: () => pic(`
  ${R(24, 36, 116, 62, "mSteel2", 6)}
  <g class="bob">${C(56, 62, 8, "mAn")}${C(82, 70, 7, "mAn")}${C(106, 60, 6, "mAn")}</g>
  ${T(32, 112, "graphite · negative", "mTxtS")}
  ${R(230, 36, 116, 62, "mSteel2", 6)}
  <g class="bob">${C(262, 62, 8, "mCa")}${C(288, 70, 7, "mCa")}${C(312, 60, 6, "mCa")}</g>
  ${T(238, 112, "NMC · positive", "mTxtS")}
  <path class="mLead" d="M186 34l0 72" stroke-dasharray="4 4"/>
  ${T(186, 66, "separate", "mTxtS", "middle")}${T(186, 80, "rooms", "mTxtS", "middle")}`),

/* slot die laying a film on foil */
die: () => pic(`
  ${R(8, 20, 356, 94, "mFrame", 7)}
  ${REEL(38, 78, 17, "mCu")}${ROLLER(136, 78, 22)}${REEL(334, 78, 17, "mAn")}
  ${R(104, 24, 64, 18, "mSteel", 4)}${P("M112 42l14 31h18l16 -31z", "mDark")}${P("M127 69h18l-3 7h-13z", "mAcc")}
  ${P("M38 78H314", "mWeb")}<path class="mWeb flowdash" stroke="var(--copper)" d="M38 78H314"/>
  ${P("M145 73H314", "mWebA")}<path class="mWebA flowdash" stroke="var(--anode)" d="M145 73H314"/>
  ${ARROW(72, 78)}${ARROW(198, 75)}${ARROW(274, 75)}
  ${T(38, 108, "BARE FOIL", "mFlowLabel", "middle")}${T(136, 16, "SLOT DIE", "mFlowLabel", "middle")}
  ${T(226, 108, "WET FILM", "mFlowLabel", "middle")}${T(334, 108, "REWIND", "mFlowLabel", "middle")}
  ${R(198, 30, 102, 25, "mZone", 5)}${T(249, 47, "coat weight measured here", "mTxtS", "middle")}`),

/* four heated chambers over a web */
dryer: () => pic(`
  ${R(8, 24, 356, 86, "mFrame", 7)}${R(34, 14, 304, 16, "mSteel", 4)}
  ${[0, 1, 2, 3].map(i => {
    const x = 28 + i * 82;
    return `${R(x, 40, 70, 58, "mHot", 4)}${R(x + 14, 46, 42, 17, "mBadge", 9)}
      ${T(x + 35, 59, [50,100,160,90][i] + " °C", "mTxt", "middle")}
      ${T(x + 35, 82, ["RAMP","EVAP","PEAK","FINISH"][i], "mFlowLabel", "middle")}
      ${P(`M${x + 35} 40V30`, "mLine")}`;
  }).join("")}
  ${P("M16 86H354", "mWebA")}<path class="mWebA flowdash" stroke="var(--anode)" d="M16 86H354"/>
  ${ARROW(100, 86)}${ARROW(182, 86)}${ARROW(264, 86)}
  ${T(186, 124, "airflow follows solvent load · vapour → recovery", "mTxtS", "middle")}`),

/* the nip: thick porous in, thin dense out */
nip: () => pic(`
  ${R(8, 18, 356, 98, "mFrame", 7)}${R(130, 22, 112, 12, "mDark", 4)}
  ${R(138, 30, 8, 80, "mSteel", 3)}${R(226, 30, 8, 80, "mSteel", 3)}
  ${ROLLER(186, 48, 27)}${ROLLER(186, 102, 27)}
  ${P("M20 76H159", "mWebA")}<path class="mWebA flowdash" stroke="var(--anode)" stroke-width="12" d="M20 76H159"/>
  ${P("M213 76H350", "mWebA")}<path class="mWebA flowdash" stroke="var(--anode)" stroke-width="6" d="M213 76H350"/>
  ${[...Array(8)].map((_, i) => `<circle cx="${30 + i * 15}" cy="76" r="3.2" fill="var(--background)"/>`).join("")}
  ${[...Array(8)].map((_, i) => `<circle cx="${225 + i * 15}" cy="76" r="1.6" fill="var(--background)"/>`).join("")}
  ${R(142, 34, 88, 18, "mBadge", 9)}${T(186, 47, "LINE FORCE", "mFlowLabel", "middle")}
  ${T(66, 104, "≈50% · OPEN", "mFlowLabel", "middle")}${T(302, 104, "20–35% · DENSE", "mFlowLabel", "middle")}
  ${T(186, 128, "the same mass becomes thinner; pore volume is the trade-off", "mTxtS", "middle")}`),

/* the burr, against a separator */
burr: () => pic(`
  ${R(20, 40, 130, 26, "mCu", 2)}
  ${P("M150 40l0 26", "mLine")}
  ${[0, 1, 2].map(i => `${P(`M${24 + i * 44} 78l36 0`, "mLine")}${T(24 + i * 44, 96, "strip", "mTxtS")}`).join("")}
  ${T(20, 34, "mother roll cut into strips", "mTxtS")}
  ${R(206, 52, 140, 12, "mCu", 1)}
  ${P("M346 52l8 -14l4 14z", "mDark")}
  ${T(206, 46, "burr left on the edge", "mTxtS")}
  ${R(206, 74, 148, 9, "mSep", 1)}
  ${T(206, 100, "separator, only 12–25 µm", "mTxtS")}
  ${T(206, 114, "taller than this and the cell shorts", "mTxtS")}`),

/* water leaving under vacuum */
water: () => pic(`
  ${R(24, 36, 150, 74, "mSteel2", 6)}${R(24, 36, 150, 12, "mDark", 3)}
  ${[0, 1].map(r => [0, 1].map(c => REEL(66 + c * 66, 66 + r * 30, 12, "mCu")).join("")).join("")}
  ${T(28, 126, "12–48 h under vacuum", "mTxtS")}
  <g class="puff">${[0, 1, 2, 3].map(i => `<circle cx="${196 + i * 15}" cy="${52 - (i % 2) * 10}" r="4"
     fill="var(--elyte)" opacity=".55"/>`).join("")}</g>
  ${T(196, 82, "H₂O + LiPF₆ → HF", "mTxt")}
  ${T(196, 98, "which attacks the cathode", "mTxtS")}
  ${T(196, 112, "and the aluminium", "mTxtS")}`),

/* z-folded separator with sheets dropping in */
stacker: () => pic(`
  ${R(8, 18, 356, 98, "mFrame", 7)}${ROLLER(182, 34, 14)}
  ${P("M182 48L136 61L226 76L136 91L226 106", "mWebS")}
  <path class="mWebS flowdash" stroke="var(--sep)" d="M182 48L136 61L226 76L136 91L226 106"/>
  ${R(58, 55, 104, 9, "mCa", 2)}${R(210, 70, 104, 9, "mAn", 2)}
  ${R(58, 85, 104, 9, "mCa", 2)}${R(210, 100, 104, 9, "mAn", 2)}
  ${ARROW(118, 59)}${ARROW(254, 74, -1)}${ARROW(118, 89)}${ARROW(254, 104, -1)}
  ${T(58, 46, "CATHODE →", "mFlowLabel")}${T(314, 61, "← ANODE", "mFlowLabel", "end")}
  ${T(182, 14, "ENDLESS SEPARATOR", "mFlowLabel", "middle")}
  ${T(182, 128, "place · fold · place · fold — repeat to 120 layers within ±200 µm", "mTxtS", "middle")}`),

/* electrolyte finding its way into pores */
wetting: () => pic(`
  ${R(22, 36, 96, 76, "mSteel2", 5)}
  ${[...Array(6)].map((_, i) => `<rect x="30" y="${42 + i * 12}" width="80" height="6" rx="1"
     fill="${i % 2 ? "var(--anode)" : "var(--cathode)"}"/>`).join("")}
  ${P("M70 30l0 -14", "mPipe")}<path class="mPipe flowdash" stroke="var(--elyte)" d="M70 30l0 -14"/>
  ${T(22, 126, "dosed under vacuum", "mTxtS")}
  ${R(160, 40, 90, 60, "mSteel2", 4)}
  ${[...Array(4)].map((_, i) => [...Array(6)].map((_, j) =>
     `<circle cx="${172 + j * 14}" cy="${52 + i * 14}" r="4" fill="${(i + j) % 3 ? "var(--elyte)" : "var(--background)"}"
      stroke="var(--border-strong)" stroke-width=".8"/>`).join("")).join("")}
  ${T(160, 116, "a dry pore is dead area", "mTxtS")}
  ${T(160, 130, "for the life of the cell", "mTxtS")}
  ${T(272, 60, "capillary", "mTxtS")}${T(272, 74, "action is slow", "mTxtS")}`),

/* first charge and the film it grows */
sei: () => pic(`
  <path class="mLine" d="M24 106l0 -70M24 106l124 0" stroke="var(--border-strong)"/>
  <path d="M24 104C56 62 74 46 92 44l56 0" fill="none" stroke="var(--primary)" stroke-width="2.4"/>
  <rect x="24" y="36" width="34" height="70" fill="var(--jelly)" opacity=".16"/>
  ${T(26, 30, "SEI forms here", "mTxtS")}
  ${T(24, 122, "0 h", "mTxtS")}${T(148, 122, "up to 15 h", "mTxtS", "end")}
  ${R(196, 42, 26, 62, "mAn", 2)}
  <rect x="222" y="42" width="5" height="62" fill="var(--jelly)"/>
  ${R(227, 42, 40, 62, "mGlass", 2)}
  ${T(196, 36, "graphite", "mTxtS")}${T(238, 36, "electrolyte", "mTxtS")}
  ${T(196, 120, "the SEI is 10–50 nm and permanent", "mTxtS")}
  ${T(282, 60, "5–15% of the", "mTxtS")}${T(282, 74, "lithium is spent", "mTxtS")}
  ${T(282, 88, "building it", "mTxtS")}`),

/* two cells drifting apart */
screen: () => pic(`
  <path class="mLine" d="M28 108l0 -66M28 108l180 0" stroke="var(--border-strong)"/>
  <path d="M28 106C60 96 120 88 208 84" fill="none" stroke="var(--primary)" stroke-width="2.2"/>
  <path d="M28 106C68 88 130 62 208 44" fill="none" stroke="var(--destructive)" stroke-width="2.2"/>
  <path class="mLead" d="M208 84l0 -40"/>
  ${T(214, 66, "gap", "mTxt")}
  ${T(28, 122, "0 d", "mTxtS")}${T(208, 122, "21 d", "mTxtS", "middle")}
  ${T(28, 36, "mV lost", "mTxtS")}
  ${T(252, 52, "> 5 mV/week", "mTxt")}
  ${T(252, 66, "→ investigate", "mTxtS")}
  ${T(252, 88, "stable", "mTxt")}
  ${T(252, 102, "→ release checks", "mTxtS")}`),

/* graded and packed */
grade: () => pic(`
  ${[0, 1, 2].map(i => `${R(24 + i * 62, 44, 50, 56, "mSteel2", 4)}
    ${R(34 + i * 62, 54, 30, 10, "mDark", 2)}
    ${T(49 + i * 62, 86, "class " + (i + 1), "mTxtS", "middle")}`).join("")}
  ${T(24, 118, "graded on capacity and resistance", "mTxtS")}
  ${R(232, 40, 62, 64, "mCu", 4)}
  ${[...Array(3)].map((_, i) => `<rect x="240" y="${48 + i * 18}" width="46" height="12" rx="2" fill="var(--elyte)"/>`).join("")}
  ${T(232, 118, "packed at shipping SOC", "mTxtS")}
  ${T(308, 62, "air freight", "mTxtS")}${T(308, 76, "caps this at", "mTxtS")}${T(308, 90, "30%", "mTxt")}`),

/* the responsibility grid */
matrix: () => pic(`
  ${[...Array(5)].map((_, r) => [...Array(9)].map((_, c) => {
    const k = (r * 9 + c * 5) % 7;
    const f = k === 0 ? "var(--primary)" : k === 1 ? "var(--destructive)" : k === 2 ? "var(--green)" : null;
    return f ? `<rect x="${96 + c * 26}" y="${36 + r * 17}" width="17" height="11" rx="3"
      fill="${f}" opacity=".55"/>` : "";
  }).join("")).join("")}
  ${[...Array(5)].map((_, r) => T(16, 46 + r * 17, ["mixing", "coating", "calendering", "slitting", "formation"][r], "mTxtS")).join("")}
  ${T(96, 30, "the nine parts of the cell →", "mTxtS")}
  ${T(16, 126, "● builds it   ▲ can ruin it   ◆ checks it", "mTxtS")}`),

/* the sources */
refs: () => pic(`
  ${[0, 1, 2].map(i => `<rect x="${24 + i * 14}" y="${36 + i * 8}" width="120" height="76" rx="5"
     fill="var(--card)" stroke="var(--border-strong)"/>`).join("")}
  ${[...Array(5)].map((_, i) => `<rect x="66" y="${64 + i * 11}" width="${86 - (i % 2) * 24}" height="4" rx="2"
     fill="var(--border-strong)"/>`).join("")}
  ${T(66, 58, "PEM / VDMA, 5th ed.", "mTxtS")}
  ${T(200, 50, "+ peer-reviewed sources", "mTxt")}
  ${T(200, 68, "for porosity, N/P balance,", "mTxtS")}
  ${T(200, 82, "moisture, SEI, dry rooms", "mTxtS")}
  ${T(200, 104, "every superscript number", "mTxtS")}
  ${T(200, 118, "opens its source", "mTxtS")}`)
};

const TOUR = [
  { id:null, t:"Welcome to Line A-17",
