.mGlass{fill:light-dark(#dceaf4,#2c3b45);stroke:light-dark(#93b6ca,#5a7180);stroke-width:1.5}
.mHot{fill:var(--hot);stroke:light-dark(#a63d1f,#f0a184);stroke-width:1.5}
.mHotSoft{fill:light-dark(#f0a184,#8a4229);stroke:light-dark(#c9714f,#c9714f);stroke-width:1.2}
.mCu{fill:var(--copper);stroke:light-dark(#8a5323,#d99a5f);stroke-width:1.2}
.mAl{fill:var(--alu);stroke:light-dark(#8b9ba5,#c7d4db);stroke-width:1.2}
.mAn{fill:var(--anode);stroke:light-dark(#4d5c64,#7d8e97);stroke-width:1.2}
.mCa{fill:var(--cathode);stroke:light-dark(#3f7f68,#7cc0a8);stroke-width:1.2}
.mSep{fill:var(--sep);stroke:light-dark(#b8b183,#a49d76);stroke-width:1.2}
.mEl{fill:var(--elyte);stroke:light-dark(#2b6485,#7ab6d6);stroke-width:1.2}
.mAcc{fill:var(--primary);stroke:light-dark(#1f7fd6,#a9d5ff);stroke-width:1.2}
.mLine{stroke:light-dark(#8b979e,#7d888e);stroke-width:1.4;fill:none}
.mPipe{stroke:var(--elyte);stroke-width:5;fill:none;stroke-linecap:round}
.mWeb{stroke:var(--copper);stroke-width:4;fill:none;stroke-linecap:round}
.mWebA{stroke:var(--anode);stroke-width:5;fill:none;stroke-linecap:round}
.mWebC{stroke:var(--copper);stroke-width:5;fill:none;stroke-linecap:round}
.mFilm{stroke:var(--cathode);stroke-width:6;fill:none;stroke-linecap:round;opacity:.9}
.mWebS{stroke:var(--sep);stroke-width:3.5;fill:none;stroke-linecap:round}
.mTxt{fill:var(--foreground);font-size:11px;font-weight:600}
.mTxtS{fill:var(--muted-foreground);font-size:9.5px;font-weight:500}
.mTxtW{fill:#fff;font-size:10px;font-weight:700}
/* halo: lines, webs and selection rings duck behind every label */
.mTxt,.mTxtS{paint-order:stroke fill;stroke:var(--background);stroke-width:3.2;
  stroke-linejoin:round;stroke-linecap:round}
.mTxt.onpanel,.mTxtS.onpanel{stroke:none}
.mLead{stroke:light-dark(#9aa6ac,#77838a);stroke-width:1;fill:none}
.mArrow{fill:var(--primary)}
.spin{transform-box:fill-box;transform-origin:center}
.is-run .spin{animation:mspin 2.6s linear infinite}
.is-run .flowdash{animation:mdash 1.1s linear infinite}
.is-run .puff{animation:mpuff 2.2s ease-in-out infinite}
.is-run .bob{animation:mbob 2.4s ease-in-out infinite}
.flowdash{stroke-dasharray:9 7}
@keyframes mspin{to{transform:rotate(360deg)}}
@keyframes mdash{to{stroke-dashoffset:-32}}
@keyframes mpuff{0%,100%{opacity:.25;transform:translateY(0)}50%{opacity:.75;transform:translateY(-7px)}}
@keyframes mbob{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
/* ---- technology radar ---- */
.rdAxis{font-size:11px;font-weight:600;letter-spacing:.08em;fill:var(--muted-foreground)}
.rdSec{font-size:11.5px;font-weight:600;fill:var(--muted-foreground);
  paint-order:stroke fill;stroke:var(--background);stroke-width:3.5px;stroke-linejoin:round}
.rdNum{font-size:11.5px;font-weight:600}
.rdDot{cursor:pointer}
.rdDot circle{transition:r .12s ease}
.rdDot:hover circle{r:15}
.rdDot:focus-visible{outline:2px solid var(--primary);outline-offset:2px;border-radius:50%}
.radarWrap{display:grid;grid-template-columns:minmax(360px,1.05fr) minmax(300px,.95fr);gap:12px;align-items:start}
.radarSide{display:grid;gap:12px}
.rdList{max-height:640px;overflow:auto}
.rdGroup{margin-bottom:14px}
.rdGroup:last-child{margin-bottom:0}
.rdGroup h5{margin:0 0 6px;font-size:12px;font-weight:600;letter-spacing:.02em;
  display:flex;justify-content:space-between;align-items:baseline;
  padding-bottom:5px;border-bottom:1px solid var(--border)}
.rdGroup h5 em{font-style:normal;font-size:10px;letter-spacing:.09em;color:var(--muted-foreground)}
.rdItem{display:grid;grid-template-columns:24px 1fr auto auto;gap:8px;align-items:center;width:100%;
  padding:5px 6px;border:0;background:none;border-radius:7px;cursor:pointer;text-align:left;
  font:inherit;font-size:12.5px;color:var(--foreground)}
.rdItem:hover{background:var(--accent)}
.rdItem.on{background:color-mix(in srgb,var(--primary) 13%,transparent)}
.rdItem i{font-style:normal;font-size:10.5px;font-weight:600;text-align:center;line-height:20px;
  height:20px;border:2px solid;border-radius:50%;color:var(--muted-foreground)}
.rdItem b{font-size:10px;font-weight:500;color:var(--muted-foreground);white-space:nowrap}
.rdItem u{text-decoration:none;font-size:9.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;
  padding:2px 6px;border-radius:99px;background:color-mix(in srgb,var(--primary) 15%,transparent);color:var(--primary)}
.rdItem u.ss{background:color-mix(in srgb,var(--jelly) 16%,transparent);color:var(--jelly)}
/* ---- factory & environment ---- */
.zoneRow{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;align-items:end}
.zone{display:flex;flex-direction:column;gap:6px}
.zone .zbar{border-radius:6px 6px 0 0;opacity:.85;min-height:34px}
.zone b{font-size:12.5px;font-weight:600}
.zone span{font-size:12px;line-height:1.45;color:var(--muted-foreground)}
.envTable{border:1px solid var(--border);border-radius:9px;overflow:hidden;
  display:grid;grid-template-columns:1.05fr .95fr 2.2fr .9fr}
.envTable>*{padding:8px 10px;margin:0;font-size:12.5px;line-height:1.5;
  border-top:1px solid var(--border);border-left:1px solid var(--border);
  display:flex;align-items:center}
.envTable>.etH{background:var(--card);font-size:10.5px;font-weight:600;letter-spacing:.05em;
  text-transform:uppercase;color:var(--muted-foreground);border-top:0}
.envTable>*:nth-child(4n+1){border-left:0}
.envTable>.etNote{grid-column:1/-1;border-left:0;font-size:12px;
  color:var(--muted-foreground);background:var(--card)}
.envTable>.etStep{font-weight:500;border-left:0}
.envTable span div{width:100%}
.envTable span div b{display:inline-block;margin-top:3px}
.pchain{display:flex;gap:12px;align-items:center;padding:8px 10px;border-radius:9px;margin-bottom:7px;
  background:var(--card);border:1px solid transparent}
.pchain.on{border-color:var(--primary);background:color-mix(in srgb,var(--primary) 8%,transparent)}
.pchain small{flex:0 0 128px;font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;
  color:var(--muted-foreground)}
.pchain.on small{color:var(--primary)}
.pchain>div{display:flex;flex-wrap:wrap;gap:7px;align-items:center}
.pchain i{font-style:normal;font-size:12px;padding:4px 9px;border-radius:99px;
  background:var(--background);border:1px solid var(--border)}
.pchain b{font-size:12px;color:var(--muted-foreground)}
.savRow{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:12px}
.sav{background:var(--card);border-radius:9px;padding:10px 11px}
.sav b{display:block;font-size:22px;font-weight:600;letter-spacing:-.02em;color:var(--primary)}
.sav span{display:block;font-size:12px;font-weight:500;margin:1px 0 6px}
.savBar{height:5px;border-radius:99px;background:color-mix(in srgb,var(--foreground) 9%,transparent);overflow:hidden}
.savBar i{display:block;height:100%;background:var(--primary);border-radius:99px}
.sav em{display:block;font-style:normal;font-size:11px;line-height:1.4;color:var(--muted-foreground);margin-top:6px}
@media (max-width:900px){.savRow{grid-template-columns:repeat(2,1fr)}.pchain{flex-direction:column;align-items:flex-start}}
.cxHead{font-size:10.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;fill:var(--muted-foreground)}
.cxLab{font-size:12px;fill:var(--foreground)}
.cxVal{font-size:11px;font-weight:600;fill:var(--muted-foreground)}
.cxTick{font-size:10px;fill:var(--muted-foreground)}
.totRow{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}
.totRow div{background:var(--card);border-radius:8px;padding:9px 11px}
.totRow small{display:block;font-size:10.5px;color:var(--muted-foreground);margin-bottom:3px}
.totRow b{font-size:16px;font-weight:600;letter-spacing:-.01em}
@media (max-width:1180px){
  .radarWrap{grid-template-columns:1fr}
  .zoneRow{grid-template-columns:repeat(2,1fr)}
  .totRow{grid-template-columns:repeat(2,1fr)}
  .etHead,.etRow{grid-template-columns:1fr 1fr}
}
</style>

<body>
<h1 class="sr">CellForge — Lithium-ion Cell Production Simulator</h1>
<div class="app" data-drawer="">

  <aside class="sidebar" id="stationDrawer" aria-label="Factory navigation">
    <div class="brand">
      <div class="mark">CF</div>
      <div><strong>CellForge</strong><small>PRODUCTION SIMULATOR</small></div>
      <button type="button" class="drawer-close" id="navClose" aria-label="Close factory navigation">×</button>
    </div>

    <button type="button" class="tour-btn" id="tourStart"><span>▶</span>Start the guided factory tour</button>
    <a class="mobile-skip" href="#lesson-content">Skip to lesson ↓</a>

    <div class="route">
      <small>CELL FORMAT — CHANGES THE LINE</small>
      <div class="route-opts" id="routeOpts" role="group" aria-label="Cell format">
        <button type="button" data-route="pouch" aria-pressed="true">Pouch</button>
        <button type="button" data-route="cyl" aria-pressed="false">Cylindrical</button>
        <button type="button" data-route="prism" aria-pressed="false">Prismatic</button>
      </div>
    </div>

    <div class="route">
      <small>ELECTRODE ROUTE — CHANGES THE LINE</small>
      <div class="route-opts" id="procOpts" role="group" aria-label="Electrode route">
        <button type="button" data-proc="wet" aria-pressed="true">Wet</button>
        <button type="button" data-proc="dry" aria-pressed="false">Dry</button>
      </div>
    </div>

    <div class="route side-layers">
      <small>THE BIG PICTURE</small>
      <div id="layerNav" style="display:grid;gap:2px"></div>
    </div>

    <nav id="nav" aria-label="Production stations"></nav>

    <div class="side-foot">
      Process data after PEM RWTH Aachen, <em>Production Process of a Lithium-Ion Battery Cell</em>.
      Training simulation — site SOPs always govern.
    </div>
  </aside>

  <main class="main" id="lesson-content" tabindex="-1">
    <header class="topbar">
      <button type="button" class="mobile-tool" id="navBtn" aria-controls="stationDrawer" aria-expanded="false">
        <span aria-hidden="true">☰</span><span>Stations</span>
      </button>
      <div class="crumb">LINE A-17 · <span id="crumbRoute">POUCH</span> · <span id="crumbProc">WET</span><b id="crumbTitle">Factory overview</b></div>
      <div class="topbar-right">
        <span class="pill"><b>Reference chemistry</b>&nbsp; graphite / NMC</span>
        <span class="pill" id="pillEnv"><i></i><b>—</b></span>
        <span class="pill">Station <b id="pillPos">—</b></span>
        <button type="button" class="runbtn" id="runBtn" aria-pressed="true">⏸ Pause line</button>
        <button type="button" class="mobile-tool" id="labBtn" aria-controls="processDrawer" aria-expanded="false">
          <span aria-hidden="true">⚙</span><span>Process lab</span>
        </button>
      </div>
    </header>

    <div class="content">
      <section id="overview"></section>
      <section id="stationView" hidden></section>
      <section id="layerView" hidden></section>
    </div>
  </main>

  <aside class="rail" id="processDrawer" aria-label="Illustrative process model">
    <div class="rail-head">
      <div><small>ILLUSTRATIVE PROCESS MODEL</small><strong>Line condition</strong></div>
      <span class="live" id="liveTag">● RUNNING</span>
      <button type="button" class="drawer-close" id="labClose" aria-label="Close process lab">×</button>
    </div>

    <div class="gauge-wrap">
      <div class="gauge" id="gauge" style="--v:97"><div><b id="yieldVal">97.4</b><span>% PROCESS<br>HEALTH</span></div></div>
      <div style="flex:1">
        <div class="metric"><div><span>Coating uniformity</span><b id="mUniT">99%</b></div><i><b id="mUniB" style="width:99%"></b></i></div>
        <div class="metric"><div><span>Moisture control</span><b id="mMoiT">98%</b></div><i><b id="mMoiB" style="width:98%"></b></i></div>
        <div class="metric"><div><span>Risk-control score</span><b id="mSafT">99%</b></div><i><b id="mSafB" style="width:99%"></b></i></div>
      </div>
    </div>

    <div class="rail-title"><span>SETPOINT LAB</span><button type="button" id="resetBtn">RESET</button></div>
    <div id="sliders"></div>

    <div class="advice" id="advice" data-level="ok">
      <strong>Model inside the training window</strong>
      <span>Move a setpoint and the illustrative downstream relationships recalculate.</span>
    </div>

    <div class="rail-title" style="margin-top:18px"><span>REFERENCE CELL OUTPUTS</span></div>
    <div class="kpi" id="cellKpi" style="grid-template-columns:1fr 1fr"></div>
  </aside>
  <button type="button" class="drawer-scrim" id="drawerScrim" aria-label="Close side panel" tabindex="-1"></button>
</div>

<section class="tour" id="tour" data-open="0" role="dialog" aria-modal="true" aria-labelledby="tourTitle" aria-describedby="tourText">
  <button type="button" class="tour-close" id="tourClose" aria-label="Close tour">×</button>
  <span class="eyebrow" id="tourStep"></span>
  <h2 id="tourTitle"></h2>
  <figure class="tour-pic" id="tourPic"></figure>
  <p id="tourText"></p>
  <div class="tour-dots" id="tourDots"></div>
  <nav>
    <button type="button" id="tourBack">Back</button>
    <button type="button" class="next" id="tourNext">Next stop →</button>
  </nav>
</section>
<script>
/* =====================================================================
   CellForge — production learning simulator
   Process data after PEM RWTH Aachen, "Production Process of a
   Lithium-Ion Battery Cell". Every parameter range below is taken from
   that document; the physics chain that links them is a teaching model.
   ===================================================================== */

/* ---------- SVG primitives ---------- */
const H = (k, x, y, w, h, body) =>
  `<g class="hot" data-k="${k}" tabindex="0" role="button">${body}` +
  `<rect class="hit" x="${x}" y="${y}" width="${w}" height="${h}" rx="9"/>` +
  `<rect class="ring" x="${x}" y="${y}" width="${w}" height="${h}" rx="9"/></g>`;
const T  = (x, y, s, c = "mTxt", a = "start") => `<text class="${c}" x="${x}" y="${y}" text-anchor="${a}">${s}</text>`;
const R  = (x, y, w, h, c = "mSteel", rx = 3) => `<rect class="${c}" x="${x}" y="${y}" width="${w}" height="${h}" rx="${rx}"/>`;
const C  = (x, y, r, c = "mSteel") => `<circle class="${c}" cx="${x}" cy="${y}" r="${r}"/>`;
const P  = (d, c = "mLine") => `<path class="${c}" d="${d}"/>`;
const LEAD = (x1, y1, x2, y2) => `<path class="mLead" d="M${x1} ${y1}L${x2} ${y2}"/>`;
/* a driven roller: dark rim, light hub, spins while the line runs */
const ROLLER = (x, y, r) =>
  `<g class="spin"><circle class="mDark" cx="${x}" cy="${y}" r="${r}"/>` +
  `<circle class="mSteel2" cx="${x}" cy="${y}" r="${Math.max(2, r * .34)}"/>` +
  `<rect class="mSteel2" x="${x - 1}" y="${y - r + 2}" width="2" height="${r * .5}" rx="1"/></g>`;
/* a coil / reel of foil */
const REEL = (x, y, r, cls) =>
