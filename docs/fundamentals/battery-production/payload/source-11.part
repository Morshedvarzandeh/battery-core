  const fibril  = clamp(S.dcFib + (S.dmTime - 30) * 0.35
                   - Math.max(0, 20 - S.dmT) * 0.45 - Math.max(0, S.dmT - 50) * 0.65);
  const adhesion = clamp(94 - (S.dcPrimer ? 34 : 0) + (S.dcRollT - 50) * 0.06
                   - Math.max(0, 60 - fibril) * 1.2 - Math.max(0, fibril - 95) * 1.6);
  const dcErr   = 0.6 + Math.max(0, 62 - fibril) * 0.16 + Math.max(0, fibril - 92) * 0.24
                + Math.abs(S.dcLine - 225) * 0.004;   /* areal-weight scatter, g/m² */

  /* --- coating --------------------------------------------------------- */
  const volSolid = (S.solid / 100) * 0.72;            /* wt% → volume fraction */
  const wetNeed  = S.tC / volSolid;                   /* wet film the recipe needs, µm */
  const coatErr  = dry ? dcErr
                 : 0.5 + Math.abs(S.gap - wetNeed) * 0.06 + (S.speed - 35) * 0.022
                 + (100 - disp) * 0.05;               /* g/m² dry, target ±2 [1] */

  /* --- drying ---------------------------------------------------------- */
  /* no solvent on the dry route, so there is nothing to under- or over-dry */
  const solventLoad = (100 - S.solid) / 42;
  const needT = (40 + S.speed * 1.4) * solventLoad * (60 / S.dryLen);
  const solventGap = dry ? 0 : Math.max(0, needT - S.dryT);      /* under-dried */
  const crackGap   = dry ? 0 : Math.max(0, S.dryT - needT - 30); /* over-dried  */

  /* --- slitting / separation ------------------------------------------- */
  const burrSlit = S.knife
    ? 2 + S.cutSpd * 0.01
    : 4 + S.wear * 0.10 + Math.max(0, S.cutSpd - 110) * 0.05;   /* µm */
  /* the pouch route cuts a second time, at separation */
  const burrSep = pouch ? (S.sepMode ? 2.5 : 4.5 + S.wear * 0.12) : 0;
  const burr = Math.max(burrSlit, burrSep);   /* the tallest burr in the cell is what matters */

  /* --- vacuum drying ---------------------------------------------------- */
  const ppm = (18 + 420 * Math.exp(-(S.vac - 12) / 5.5)) * Math.pow(120 / S.vacT, 0.85);

  /* --- assembly --------------------------------------------------------- */
  const alignRisk = Math.max(0, S.stackAcc - 300) * 0.05
                  + Math.abs(S.webTens - 60) * 0.03;
  const sealQ = clamp(100 - Math.abs(S.sealT - 190) * 1.1 - Math.max(0, S.drawDepth - 8) * 5);

  /* --- filling and wetting ---------------------------------------------- */
  const wetDrive = S.soak * Math.max(0, S.doseFac - 0.98) * Math.pow(200 / S.fillP, 0.35)
                 * (1 + (pouch ? S.pressP * 0.8 : 0)) / (por / 30);
  const wetting  = clamp(100 - 55 * Math.exp(-wetDrive / 0.9));
  const excess   = Math.max(0, S.doseFac - 1.35) * 60;   /* flooded cell gasses */

  /* --- formation -------------------------------------------------------- */
  const seiQ = clamp(100 - Math.max(0, S.cRate - 0.2) * 90
                     - Math.max(0, S.formT - 50) * 1.6 - Math.max(0, 20 - S.formT) * 1.2
                     - Math.max(0, S.vMax - 4.25) * 140 - Math.max(0, ppm - 60) * 0.06);
  const liLoss = 6 + Math.max(0, S.cRate - 0.2) * 22 + Math.max(0, S.formT - 45) * 0.35;

  /* --- shipping compliance ------------------------------------------------ */
  const shipOK = S.shipSOC <= 30;   /* PI 965 check for UN 3480 cells/batteries shipped alone by air */

  /* --- finishing --------------------------------------------------------- */
  const gasLeft   = pouch ? clamp(2 + (S.degP - 1) * 0.9 + (100 - seiQ) * 0.25, 0, 100) : 0;
  const screenSens = clamp(35 + S.ageDays * 3.0 + (S.ageHiT - 25) * 1.0 + (S.ageSOC - 30) * 0.18);
  const escape    = Math.max(0, 96 - screenSens) * 0.06;   /* defects that get past aging */

  /* --- scores ------------------------------------------------------------ */
  const uniformity = clamp(100 - Math.max(0, coatErr - 1) * 9 - solventGap * 0.5
                     - (dry ? Math.max(0, 90 - adhesion) * 0.55 : (100 - disp) * 0.3));
  const moisture   = clamp(100 - Math.max(0, ppm - 40) * 0.18);
  const npPenalty  = np < 1.02 ? (1.02 - np) * 260 : np > 1.25 ? (np - 1.25) * 90 : 0;
  const cPenalty   = Math.max(0, S.cRate - 0.35) * 70;
  const agePenalty = Math.max(0, 10 - S.ageDays) * 2.2;
  const safety     = clamp(100 - npPenalty - cPenalty - Math.max(0, ppm - 60) * 0.12
                     - Math.max(0, burr - 8) * 2.5 - alignRisk * 1.5 - (100 - seiQ) * 0.25);
  const yieldPct   = clamp(99.6 - solventGap * 0.55 - crackGap * 0.5 - Math.max(0, ppm - 40) * 0.05
                     - npPenalty * 0.5 - cPenalty * 0.5 - agePenalty
                     - Math.max(0, S.force - 2300) * 0.006
                     - Math.max(0, coatErr - 2) * 3.5
                     - Math.max(0, burr - 8) * 1.2
                     - Math.max(0, 96 - wetting) * 0.35
                     - Math.max(0, 90 - disp) * 0.12
                     - alignRisk - excess * 0.3
                     - (dry ? Math.max(0, 88 - adhesion) * 0.42 : 0)
                     - (pouch ? Math.max(0, 96 - sealQ) * 0.25 + gasLeft * 0.1 : 0)
                     - escape * 2, 55, 99.6);

  /* --- throughput: 1 m effective coating width, 85% uptime --------------- */
  const cathodePerCell = g.area * (g.layers > 1 ? 2 * g.layers : 1) / 10000;   /* m² */
  const cellsDay = S.speed * 1.0 * 60 * 24 * 0.85 / (cathodePerCell * 2);
  const gwh = cellsDay * 365 * cellAh * 3.65 / 1e9;

  /* --- the worst problem, in plain language ------------------------------ */
  let level = "ok", head = "Model inside the training window", body =
    `Porosity ${por.toFixed(0)}%, N/P ${np.toFixed(2)}, residual moisture ${ppm.toFixed(0)} ppm, wetting ${wetting.toFixed(0)}%.`;
  const flag = (cond, lv, h, b) => { if (cond) { level = lv; head = h; body = b; } };

  flag(!dry && disp < 85, "warn", "Slurry not fully dispersed",
    `Dispersion index ${disp.toFixed(0)}%. Agglomerates survive into the coating and print through as thickness scatter.`);
  flag(!dry && visc < 2000, "warn", "Slurry too thin",
    `${visc.toFixed(0)} mPa·s. Below the 2 000 mPa·s floor the solids settle in the buffer tank and the film runs at the die.`);
  flag(!dry && visc > 6000, "warn", "Slurry too thick",
    `${visc.toFixed(0)} mPa·s. Above the 6 000 mPa·s ceiling the die streaks and the coat weight drifts.`);
  flag(coatErr > 2, "warn", "Coat weight outside ±2 g/m²",
    `Predicted scatter ${coatErr.toFixed(1)} g/m². Thickness variation becomes capacity variation, which end-of-line grading will find.`);
  flag(!dry && S.force > 2300, "warn", "Calender line force very high",
    "Above roughly 2 300 N/mm this teaching model increases the risk of over-compression, particle damage and stress cracking. PEM caps line pressure at 2 500 N/mm.");
  flag(!dry && crackGap > 12, "warn", "Dryer hotter than the web needs",
    `At ${S.speed} m/min and ${S.solid} wt% solids the profile only needs about ${needT.toFixed(0)} °C. Overshooting skins the surface and drags binder to the top.`);
  flag(dry && fibril < 55, "warn", "Not enough fibrillation",
    `Shear at ${S.dcFib}%. The PTFE has not been drawn into a fibril network, so the powder leaves the nip as powder rather than as a film.`);
  flag(dry && adhesion < 80, "warn", "Dry film is not holding on to the foil",
    `Adhesion index ${adhesion.toFixed(0)}%. ${S.dcPrimer ? "Bare foil gives the film nothing to key into — switch to the carbon primer." : "Warm the rolls, or raise the fibrillation shear."} Low adhesion is the standing weakness of the dry route.`);
  flag(np > 1.25, "warn", "Anode heavily over-sized",
    `N/P ratio ${np.toFixed(2)}. Excess anode capacity is not fully utilised and reduces energy density; it does not by itself establish that the cell is safe.`);
  flag(burr > 10, "warn", "Burr above the illustrative risk threshold",
    `${burr.toFixed(1)} µm on the cut edge against a 12–25 µm separator reference. This is an illustrative risk flag, not a universal acceptance limit.`);
  flag(ppm > 120, "warn", "Residual moisture too high",
    `${ppm.toFixed(0)} ppm going into the dry room. Residual water can hydrolyse LiPF₆ and generate HF-containing species that degrade electrolyte and interfaces.`);
  flag(wetting < 90, "warn", "Electrolyte has not reached every pore",
    `Wetting ${wetting.toFixed(0)}%. Incomplete wetting can create locally inactive or nonuniform regions. Additional rest or pressure cycling may help, but formation should not be treated as a reliable correction for an inadequate filling process.`);
  flag(pouch && sealQ < 90, "warn", "Pouch seal outside its window",
    `Seal quality ${sealQ.toFixed(0)}%. The sealant layer melts around 165 °C — too cold and it never bonds, too hot and it thins.`);
  flag(!dry && solventGap > 10, "bad", "Web is under-dried",
    `At ${S.speed} m/min and ${S.solid} wt% solids the teaching model estimates about ${needT.toFixed(0)} °C but the setpoint is ${S.dryT} °C. Excess residual solvent can impair adhesion, interfaces and cell performance.`);
  flag(S.cRate > 0.42, "bad", "Formation charge too aggressive",
    `${S.cRate.toFixed(2)} C on the first charge. PEM specifies 0.1–0.5 C stepped up over successive cycles — rushing the first one builds a poor SEI and can plate lithium.`);
  flag(S.vMax > 4.3, "bad", "Upper cut-off voltage too high",
    `${S.vMax.toFixed(2)} V. Electrolyte oxidation and interfacial degradation can increase gas generation and impedance.`);
  flag(!shipOK, "warn", "Above the air-freight state of charge limit",
    `${S.shipSOC}% SOC. For this UN 3480 shipped-alone air scenario, PI 965 limits state of charge to 30%; other shipment configurations and modes use different requirements.`);
  flag(np < 1.02, "bad", "Anode under-sized — lithium plating risk",
    `N/P ratio ${np.toFixed(2)}. Insufficient anode capacity raises lithium-plating risk during charge and can contribute to internal-short hazards.`);

  return { por, capC, capA, np, cellAh, ppm, uniformity, moisture, safety, yieldPct, dry, fibril, adhesion, dcErr,
           cellsDay, gwh, level, head, body, needT, visc, disp, coatErr, wetNeed, burr,
           wetting, excess, seiQ, liLoss, sealQ, alignRisk, gasLeft, screenSens, solventGap, crackGap,
           burrSlit, burrSep, shipOK };
}
</script>
<script>
/* =====================================================================
   THE BIG PICTURE LAYER
   1. REFS       — every cited process range points at a source
   2. COMPONENTS — the cell, layer by layer, and which station builds it
   3. FLOW       — one material chain from powder to graded cell
   4. MATRIX     — station × component, derived from the two above
   ===================================================================== */

/* ---------------- 1 · references ---------------- */
const REFS = [
  { n:1, tag:"PEM/VDMA", txt:"Michaelis, S.; Rothhagen, B.; Heimes, H. H.; Born, H.; Kampker, A.; Scherer, C.; Lingohr, P. <em>Production Process of a Lithium-Ion Battery Cell</em>, 5th ed.; PEM of RWTH Aachen University &amp; VDMA: Frankfurt am Main, February 2026. ISBN 978-3-947920-71-6.",
    use:"Process parameters, environment classes, machine investments and cycle times used in this simulator.",
    url:"https://www.vdma.eu/documents/34570/35405938/Production_Process_of_a_Lithium-Ion_Battery_Cell_2026.pdf" },
  { n:2, tag:"Chem. Rev. 2022", txt:"Li, J.; Fleetwood, J.; Hawley, W. B.; Kays, W. From Materials to Cell: State-of-the-Art and Prospective Technologies for Lithium-Ion Battery Electrode Processing. <em>Chem. Rev.</em> <b>2022</b>, <em>122</em> (1), 903–956.",
    use:"Areal loading and areal capacity, commercial calendered porosity (≈20% anode, ≈25% cathode; 30–35% in research cells), separator thickness, foil thickness trend, scrap-rate range.",
    url:"https://doi.org/10.1021/acs.chemrev.1c00565" },
  { n:3, tag:"Nat. Energy 2018", txt:"Kwade, A.; Haselrieder, W.; Leithoff, R.; Modlinger, A.; Dietrich, F.; Droeder, K. Current status and challenges for automotive battery production technologies. <em>Nat. Energy</em> <b>2018</b>, <em>3</em> (4), 290–300.",
    use:"Process-chain structure, the dominance of formation and aging in cost and floor space, quality-gate logic.",
    url:"https://doi.org/10.1038/s41560-018-0130-3" },
  { n:4, tag:"Adv. Energy Mater. 2023", txt:"Abdollahifar, M.; Cavers, H.; Scheffler, S.; Diener, A.; Lippke, M.; Kwade, A. Insights into Influencing Electrode Calendering on the Battery Performance. <em>Adv. Energy Mater.</em> <b>2023</b>, <em>13</em> (40), 2300973.",
    use:"Porosity–performance trade-off, particle cracking and tortuosity increase under severe calendering.",
    url:"https://doi.org/10.1002/aenm.202300973" },
  { n:5, tag:"J. Power Sources 2016", txt:"Ahmed, S.; Nelson, P. A.; Dees, D. W. Study of a dry room in a battery manufacturing plant using a process model. <em>J. Power Sources</em> <b>2016</b>, <em>326</em>, 490–497.",
    use:"Dry-room dew point targets and the energy cost of holding them.",
    url:"https://doi.org/10.1016/j.jpowsour.2016.06.107" },
  { n:6, tag:"J. Phys. Chem. C 2018", txt:"Stich, M.; Göttlinger, M.; Kurniawan, M.; Schmidt, U.; Bund, A. Hydrolysis of LiPF₆ in Carbonate-Based Electrolytes for Lithium-Ion Batteries and in Aqueous Media. <em>J. Phys. Chem. C</em> <b>2018</b>, <em>122</em> (16), 8836–8842.",
    use:"LiPF₆ hydrolysis and formation of HF-containing species; why residual moisture is a critical gate before filling.",
    url:"https://doi.org/10.1021/acs.jpcc.8b02080" },
  { n:7, tag:"Carbon 2016", txt:"An, S. J.; Li, J.; Daniel, C.; Mohanty, D.; Nagpure, S.; Wood, D. L. The State of Understanding of the Lithium-Ion-Battery Graphite Solid Electrolyte Interphase (SEI) and Its Relationship to Formation Cycling. <em>Carbon</em> <b>2016</b>, <em>105</em>, 52–76.",
    use:"SEI composition and thickness, why formation protocol influences SEI properties, formation-protocol effects.",
    url:"https://doi.org/10.1016/j.carbon.2016.04.008" },
  { n:8, tag:"J. Power Sources 2015", txt:"Wood, D. L., III; Li, J.; Daniel, C. Prospects for reducing the processing cost of lithium ion batteries. <em>J. Power Sources</em> <b>2015</b>, <em>275</em>, 234–242.",
