${H(4, 664, 148, 132, 66, `
  ${IDLER(700, 178, 12, 1)}
  ${T(668, 142, "Strips at the required width", "mTxtS")}`)}
${H(5, 856, 96, 112, 172, `
  ${REEL(910, 130, 22, "mSep")}${REEL(910, 178, 22, "mSep")}${REEL(910, 226, 22, "mSep")}
