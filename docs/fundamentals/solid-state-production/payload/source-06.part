  ${T(560, 224, "Densified — porosity down, contact up", "mTxtS")}`)}
${H(3, 790, 110, 178, 120, `
  ${R(820, 140, 66, 44, "mSteel2", 4)}${T(826, 168, "% dens.", "mTxtS onpanel")}
  ${T(794, 224, "Density gauge", "mTxtS")}`)}
${ARROW(192, 168)}${ARROW(532, 168)}
`;

M.slitting = () => `
${T(30, 26, "Two ways to make the same cut — both act on the same web line", "mTxtS")}
${H(0, 24, 120, 150, 112, `
  ${REEL(90, 178, 36, "mSep")}
  ${T(28, 250, "Wide coated web", "mTxtS")}`)}
${H(3, 182, 176, 104, 60, `
  ${IDLER(214, 178, 14, 1)}${IDLER(258, 178, 14, 1)}
  ${T(184, 254, "Guide rollers", "mTxtS")}`)}
${H(1, 300, 52, 168, 154, `
  ${R(362, 66, 34, 52, "mDark", 4)}
  ${P("M379 118l0 48", "mLnHot")}${C(379, 172, 7, "mHot")}
  ${T(304, 46, "Laser — contactless", "mTxt")}
