${P("M606 166q40 2 64 4", "mLine")}${P("M732 170q40 -2 70 -2", "mLine")}
`;

M.calender = () => `
${H(0, 26, 140, 150, 116, `
  ${REEL(92, 194, 30, "mCa")}
  ${T(30, 248, "Composite infeed", "mTxtS")}`)}
${H(1, 330, 68, 220, 250, `
  ${NIP(438, 194, 42)}
  ${T(340, 84, "Calender rollers", "mTxt")}
  ${T(340, 98, "below 2 500 N/mm, tempered", "mTxtS")}`)}
${H(2, 560, 40, 200, 110, `
  ${C(640, 92, 18, "mSteel2")}
  ${P("M626 106q-20 20 -34 26", "mAcc")}
  ${[0,1,2].map(i => `<circle cx="${600 - i * 8}" cy="${134 + i * 6}" r="2.6" fill="var(--elyte)"/>`).join("")}
  ${T(566, 60, "Solvent supply (optional)", "mTxtS")}`)}
${H(3, 186, 190, 240, 108, `
  ${[0,1].map(i => IDLER(226 + i * 60, 194, 15, 1)).join("")}
  ${T(190, 288, "Support rollers keep the web flat", "mTxtS")}`)}
${WEB([[122, 194], [438, 194]], "mLnCa", 9)}
${R(122, 190, 274, 4, "mCu", 1)}
${H(4, 496, 152, 444, 116, `
  ${R(480, 186, 434, 8, "mCa", 1)}
  ${R(480, 194, 434, 5, "mSep", 1)}
  ${R(480, 199, 434, 6, "mCu", 1)}
  ${T(528, 176, "Densified composite", "mTxt")}
  ${T(528, 240, "oxide electrolytes are sintered instead — this station", "mTxtS")}
  ${T(528, 254, "does not exist on the oxide route", "mTxtS")}`)}
`;

M.drycoat = () => `
${T(30, 30, "Solvent-free — the binder is fibrillated, not dissolved", "mTxtS")}
${H(0, 40, 60, 190, 138, `
  ${R(70, 78, 140, 40, "mSteel2", 5)}
  ${P("M84 118l40 26l24 0l48 -26z", "mDark")}
  <g class="bob">${C(98, 96, 6, "mCa")}${C(124, 100, 5, "mSep")}${C(150, 94, 5, "mDark")}${C(176, 99, 6, "mCa")}</g>
  ${T(46, 52, "Dry mix — fibrillated binder", "mTxtS")}`)}
${H(1, 250, 96, 190, 150, `
  ${NIP(300, 182, 30)}
  ${T(256, 262, "Fibre-forming nip", "mTxt")}${T(256, 276, "RT–200 °C", "mTxtS")}`)}
${H(2, 460, 96, 200, 150, `
  ${ROLLER(520, 150, 32)}${ROLLER(520, 214, 32)}
  ${T(566, 120, "Gap or pressure", "mTxt")}${T(566, 134, "sets layer thickness", "mTxtS")}
  ${LEAD(562, 128, 552, 150)}`)}
${H(3, 690, 110, 150, 120, `
  ${R(720, 140, 66, 44, "mSteel2", 4)}${T(728, 168, "µm OK", "mTxtS onpanel")}
  ${P("M753 184l0 20", "mLine")}
  ${T(694, 236, "Thickness gauge", "mTxtS")}`)}
${H(4, 858, 120, 110, 110, `${REEL(908, 182, 26, "mSep")}${T(862, 226, "Dry film", "mTxtS")}`)}
${P("M210 136q36 26 60 46", "mLnSep")}
${WEB([[330, 182], [520, 182]], "mWebS", 7)}
${P("M552 182l332 0", "mWebS")}
<path class="mWebS flowdash" stroke="var(--sep)" d="M552 182l332 0"/>
${ARROW(236, 168)}${ARROW(676, 170)}
${[400, 620, 760].map(x => ROLLER(x, 194, 10)).join("")}
`;

M.ald = () => `
${T(30, 30, "One atomic layer at a time — self-limiting surface reactions", "mTxtS")}
${H(0, 22, 118, 118, 112, `${REEL(76, 174, 28, "mAn")}${T(26, 222, "Cell layer in", "mTxtS")}`)}
${H(1, 160, 48, 640, 192, `
  ${R(176, 92, 610, 108, "mGlass", 6)}
  ${[0, 1, 2, 3].map(q => R(206 + q * 152, 78, 96, 20, "mDark", 3)).join("")}
  ${[0, 1, 2, 3].map(q => T(254 + q * 152, 62, ["precursor A", "purge", "precursor B", "purge"][q], "mTxtS", "middle")).join("")}
  ${[0, 1, 2, 3].map(q => NOZZLES(216 + q * 152, 100, 4, 20)).join("")}
  ${T(178, 216, "No vacuum required · 100–250 °C", "mTxtS")}`)}
${H(2, 812, 118, 156, 112, `
  ${REEL(866, 174, 26, "mAn")}
  ${R(902, 150, 60, 38, "mSteel2", 4)}${T(908, 174, "1–10 nm", "mTxtS onpanel")}
  ${T(816, 222, "Coated, out", "mTxtS")}`)}
${P("M76 174l790 0", "mWebA")}
<path class="mWebA flowdash" stroke="var(--anode)" d="M76 174l790 0"/>
${P("M176 162l610 0", "mEl")}
${ARROW(126, 152)}${ARROW(802, 152)}
`;

M.compacting = () => `
${T(30, 30, "The stack is densified before it is joined — 5 to 600 MPa", "mTxtS")}
${H(0, 30, 110, 150, 120, `${R(60, 152, 96, 40, "mSteel2", 4)}
  ${[0, 1, 2, 3].map(q => R(66, 156 + q * 9, 84, 5, q % 2 ? "mCa" : "mSep", 1)).join("")}
  ${T(34, 220, "Loose stack in", "mTxtS")}`)}
${H(1, 220, 54, 300, 232, `
  ${R(250, 80, 240, 26, "mDark", 4)}
  ${R(250, 220, 240, 26, "mDark", 4)}
  ${R(272, 130, 196, 62, "mHotSoft", 3)}
  ${[0, 1, 2, 3, 4].map(q => R(280, 136 + q * 11, 180, 7, q % 2 ? "mCa" : "mSep", 1)).join("")}
  ${P("M300 106l0 20M370 106l0 20M440 106l0 20", "mAcc")}
  ${P("M300 220l0 -20M370 220l0 -20M440 220l0 -20", "mAcc")}
  ${T(226, 70, "Isostatic press · RT–2 000 °C", "mTxtS")}
