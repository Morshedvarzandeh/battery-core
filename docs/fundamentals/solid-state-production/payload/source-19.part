    d:"Oxide is ground dry in a ball mill. Sulfide and oxide are dispersed in a planetary mixer. Polymer is compounded in a twin-screw extruder. Sulfidic materials are sensitive to polar solvents and to moisture, which sharply limits what you can even mix them with." },
  { id:"tape", pic:"layer", t:"Laying the layers down",
    d:"A slot die meters slurry onto the substrate — and the substrate for the electrolyte layer is the cathode itself. Set the gap away from the wet film the recipe needs and watch thickness scatter leave specification." },
  { id:"calender", pic:"dense", t:"Two ways to make an interface",
    d:"Sulfide and polymer are calendered: pressure and temperature densify the composite. Oxide is sintered instead, at 500 to 2 000 °C, because it is not pressed after stacking and has to win its interface in the furnace. Switch to oxide and this station disappears entirely." },
  { id:"separation", pic:"cut", t:"The cut that can short the cell",
    d:"Elementary cells are cut out by laser or punched. The guide is explicit: the layer materials must not be melted, because melting them connects the layers electrically. Push the laser power up and watch the melt risk climb." },
  { id:"stacking", pic:"press", t:"Pressure is how a solid cell makes contact",
    d:"There is no liquid to wet interfacial gaps, so pressure is one key way to establish contact at this stage. Published work on lithium against a sulfide electrolyte found the critical current density rose fivefold as stack pressure went from 3 to 7 MPa. Slide the pressure and watch both the contact and the illustrative dendrite margin move." },
  { id:"contacting", pic:"nofill", t:"And then nothing else happens",
    d:"Conductors welded, pouch drawn, seam sealed. In a lithium-ion plant the next station is electrolyte filling in a dry room at a −50 °C dew point, followed by hours of wetting. Here that station does not exist. It is the clearest process saving of the whole solid-state route." },
  { id:"formation", pic:"dendrite", t:"The first cycle, and the limit it must respect",
    d:"The cell arrives already charged, because its anode is lithium metal. The first cycles grow the interface layers. Push the rate and the current density crosses the value the electrolyte can survive — and lithium starts growing through it. There is no standard way to measure that limit, which is itself worth knowing." },
  { id:"view:matrix", pic:"matrix", t:"Who is responsible for what",
    d:"Fifteen machines down the side, the parts of the cell across the top. Two columns that would be full in a lithium-ion plant are empty here: there is no liquid electrolyte and no porous separator." },
  { id:"view:refs", pic:"refs", t:"And where every number came from",
    d:"Process steps, parameter ranges, atmospheres and quality features are from the PEM RWTH Aachen and VDMA guide. Conductivity, stack pressure and critical current density come from the peer-reviewed sources listed here. Every superscript number opens its source." }
];
let tourAt = -1;
function showTour(i) {
  tourAt = i;
  const s = TOUR[i];
  go(s.id);
  $("tour").dataset.open = "1";
  $("tourStep").textContent = `STOP ${i + 1} OF ${TOUR.length}`;
  $("tourTitle").textContent = s.t;
  $("tourText").textContent = s.d;
  $("tourPic").innerHTML = s.pic && TOURPIC[s.pic] ? TOURPIC[s.pic]() : "";
  $("tourDots").innerHTML = TOUR.map((_, j) => `<i class="${j <= i ? "on" : ""}"></i>`).join("");
  $("tourBack").disabled = i === 0;
  $("tourNext").textContent = i === TOUR.length - 1 ? "Finish tour" : "Next stop →";
}
$("tourStart").addEventListener("click", () => showTour(0));
$("tourNext").addEventListener("click", () => {
  if (tourAt >= TOUR.length - 1) { $("tour").dataset.open = "0"; return; }
  showTour(tourAt + 1);
});
$("tourBack").addEventListener("click", () => { if (tourAt > 0) showTour(tourAt - 1); });
$("tourClose").addEventListener("click", () => { $("tour").dataset.open = "0"; });
document.addEventListener("keydown", e => {
  if ($("tour").dataset.open !== "1") return;
  if (e.key === "Escape") $("tour").dataset.open = "0";
  if (e.key === "ArrowRight") $("tourNext").click();
  if (e.key === "ArrowLeft") $("tourBack").click();
});

</script><script>
/* =====================================================================
   THE BIG-PICTURE VIEWS + the interactive station console
   ===================================================================== */
const VIEWS = [
  { id:"machine", label:"Machine overview",   hint:"the whole line, live" },
  { id:"anatomy", label:"Cell anatomy",       hint:"every layer, and who builds it" },
  { id:"flow",    label:"Material flow",      hint:"powder to graded cell" },
  { id:"matrix",  label:"Process ↔ component",hint:"which station touches what" },
  { id:"compare", label:"Electrolyte classes", hint:"four materials, seven properties" },
  { id:"proctech",label:"Process technologies",hint:"what else could do each job" },
  { id:"refs",    label:"References",         hint:"every number, sourced" }
];
let layerPick = "sse";

function renderLayerNav() {
  $("layerNav").innerHTML = VIEWS.map(v => `
    <button class="stage-btn" data-go="view:${v.id}" aria-current="${current === "view:" + v.id}">
      <b>◆</b><em>${v.label}</em><i style="background:var(--primary);opacity:.5"></i></button>`).join("");
}

/* ---------------------------------------------------------------------
   1 · CELL ANATOMY — one elementary cell, and the bipolar stack it lives in
   ------------------------------------------------------------------- */
function anatomySVG(pick) {
  /* the elementary cell is collector / lithium / electrolyte / catholyte /
     collector. The interface layer is grown on the electrolyte faces.     */
  const SAND = ["collector", "lithium", "passiv", "sse", "catholyte"];
  const bars = SAND.map(id => compMap[id]);
  const GAP = 12, TOP = 62, H = 288;
  const unit = (H - GAP * (bars.length - 1)) / bars.reduce((a, c) => a + c.h, 0);
  let y = TOP, rows = "";
  bars.forEach(c => {
    const h = Math.max(12, c.h * unit), on = c.id === pick;
    rows += `<g class="hot" data-layer="${c.id}" tabindex="0" role="button"
      aria-label="${esc(c.name)}, ${esc(c.spec)}">
      <rect x="338" y="${y}" width="286" height="${h}" rx="2" fill="${c.col}"
        stroke="${on ? "var(--primary)" : "color-mix(in srgb,var(--foreground) 16%,transparent)"}"
        stroke-width="${on ? 3 : 1}"/>
      <text class="mTxt" x="638" y="${y + h / 2 - 1}">${esc(c.short)}</text>
      <text class="mTxtS" x="638" y="${y + h / 2 + 12}">${esc(c.spec)}</text>
      <rect class="hit" x="240" y="${y - GAP / 2}" width="480" height="${h + GAP}" fill="transparent"/>
    </g>`;
    /* the interface layer sits on the electrolyte faces */
    if (c.id === "sse") {
      const on2 = pick === "interface";
      rows += `<g class="hot" data-layer="interface" tabindex="0" role="button" aria-label="Interface layer">
        <rect x="338" y="${y - 2}" width="286" height="4" fill="${compMap.interface.col}"
          stroke="${on2 ? "var(--primary)" : "none"}" stroke-width="${on2 ? 2.5 : 0}"/>
        <rect x="338" y="${y + h - 2}" width="286" height="4" fill="${compMap.interface.col}"
          stroke="${on2 ? "var(--primary)" : "none"}" stroke-width="${on2 ? 2.5 : 0}"/>
        <path class="mLead" d="M338 ${y}L312 ${y - 16}"/>
        <text class="mTxtS" x="308" y="${y - 18}" text-anchor="end">interface layers</text>
        <rect class="hit" x="206" y="${y - 30}" width="106" height="32" fill="transparent"/></g>`;
    }
    y += h + GAP;
  });
  /* the second collector closes the elementary cell */
  rows += `<g class="hot" data-layer="collector" tabindex="0" role="button" aria-label="Current collector">
    <rect x="338" y="${y}" width="286" height="14" rx="2" fill="var(--alu)"
      stroke="color-mix(in srgb,var(--foreground) 16%,transparent)"/>
    <text class="mTxt" x="638" y="${y + 10}">Collector</text>
    <rect class="hit" x="240" y="${y - 6}" width="480" height="26" fill="transparent"/></g>`;
  const bOn = pick === "bipolar";
  rows += `<g class="hot" data-layer="bipolar" tabindex="0" role="button" aria-label="Bipolar connection">
    <rect x="330" y="${TOP - 8}" width="302" height="${y - TOP + 30}" rx="7" fill="none"
      stroke="${bOn ? "var(--primary)" : "var(--elyte)"}" stroke-width="${bOn ? 3 : 1.5}" stroke-dasharray="6 5"/>
    <text class="mTxtS" x="481" y="${TOP - 18}" text-anchor="middle" fill="var(--elyte)">one elementary cell — stacked in series, not in parallel</text>
    <rect class="hit" x="330" y="${TOP - 32}" width="302" height="24" fill="transparent"/></g>`;

  /* the pouch, with the bipolar stack inside */
  const hOn = pick === "housing" ? 3 : 1;
  const cell = `
    <g class="hot" data-layer="housing" tabindex="0" role="button" aria-label="Housing">
      <rect x="52" y="72" width="150" height="248" rx="9" class="mSteel2"
        ${hOn === 3 ? 'stroke="var(--primary)" stroke-width="3"' : ""}/>
      <rect class="hit" x="46" y="66" width="162" height="260" fill="transparent"/></g>
    <rect x="64" y="86" width="126" height="220" rx="4" fill="var(--card)"/>
    ${[0,1,2,3,4,5].map(i => `
      <rect x="72" y="${94 + i * 35}" width="110" height="5" rx="1" fill="var(--copper)"/>
      <rect x="72" y="${99 + i * 35}" width="110" height="8" rx="1" fill="var(--anode)"/>
      <rect x="72" y="${107 + i * 35}" width="110" height="6" rx="1" fill="var(--sep)"/>
      <rect x="72" y="${113 + i * 35}" width="110" height="10" rx="1" fill="var(--cathode)"/>`).join("")}
    <rect x="72" y="304" width="110" height="5" rx="1" fill="var(--alu)"/>
    <rect x="80" y="54" width="28" height="20" rx="3" class="mAl"/>
    <rect x="148" y="54" width="28" height="20" rx="3" class="mCu"/>
    <text class="mTxtS" x="127" y="338" text-anchor="middle">Pouch — bipolar stack, two conductors out</text>`;

  return `<svg viewBox="0 0 760 404" role="img" aria-label="Exploded all-solid-state cell layers">
    ${cell}
    <path class="mLead" d="M204 200 C 250 200, 258 212, 330 212"/>
    <text class="mTxtS" x="214" y="192">one elementary cell →</text>
    <text class="mTxtS" x="214" y="236" fill="var(--faint)">repeated in series</text>
    ${rows}</svg>`;
}

function renderAnatomy() {
  const c = compMap[layerPick];
  const stationChip = id => {
    const st = STATIONS.find(x => x.id === id);
    if (!st || !st.routes.includes(route)) return "";
    const col = phaseColor(st.phase);
    return `<button class="chipc" data-go="${st.id}"><i style="background:${col}"></i>${esc(st.title)}</button>`;
  };
  $("layerView").innerHTML = `
    <div class="card card-pad">
      <span class="eyebrow">The big picture · 1 of 3</span>
      <h2 style="font-size:22px;letter-spacing:-.02em;margin:6px 0 8px">What you are actually building</h2>
      <p class="lede" style="max-width:80ch">A solid-state cell is an elementary cell — collector, lithium metal, solid electrolyte, catholyte, collector —
      stacked in series inside one pouch. There is no liquid and no porous separator. Pick any layer to see what it is,
      why it is that thickness, and which stations on the line are responsible for it.</p>
    </div>

    <div class="card card-pad">
      <div class="anat">
        <div>
          <small style="display:block;font-size:8.5px;font-weight:900;letter-spacing:.14em;color:var(--faint);margin-bottom:9px">THE REPEAT UNIT</small>
          <div class="layerlist">
            ${COMPONENTS.map(x => `
              <button class="layer" data-layer="${x.id}" aria-current="${x.id === layerPick}">
                <i style="background:${x.col}"></i>
                <span><strong>${esc(x.name)}</strong><small>${esc(x.spec)}</small></span>
                <em>${x.made.filter(id => (STATIONS.find(s => s.id === id) || {routes:""}).routes.includes(route)).length} ST</em>
              </button>`).join("")}
          </div>
        </div>
        <div class="anat-detail">
          ${anatomySVG(layerPick)}
        </div>
      </div>
    </div>

    <div class="card card-pad anat">
      <div>
        <span class="eyebrow" style="color:${c.col === "var(--sep)" ? "var(--warning)" : c.col}">${esc(c.short)}</span>
        <h3 style="margin:5px 0 10px">${esc(c.name)}</h3>
        <div class="anat-spec">
          <div><small>Dimension</small><b>${esc(c.spec)}</b></div>
          <div><small>Material</small><b>${esc(c.mat)}</b></div>
          <div><small>Origin</small><b>${esc(c.src)}</b></div>
        </div>
      </div>
      <div>
        <p><b>${esc(c.role)}</b></p>
        <p style="margin-top:9px">${c.why}</p>
        <div style="margin-top:14px">
          <small style="display:block;font-size:8.5px;font-weight:900;letter-spacing:.14em;color:var(--faint)">STATIONS THAT BUILD OR SHAPE IT — ${GEOM[route].name.toUpperCase()} ROUTE</small>
          <div class="makes">${c.made.map(stationChip).join("") || "<span style='font-size:11px;color:var(--faint)'>Not built on this route.</span>"}</div>
        </div>
        <div style="margin-top:12px">
          <small style="display:block;font-size:8.5px;font-weight:900;letter-spacing:.14em;color:var(--destructive)">WHERE IT IS MOST EASILY RUINED</small>
          <div class="makes">${c.risk.map(stationChip).join("")}</div>
          <p style="margin-top:7px;font-size:11.5px">${esc(c.riskWhy)}</p>
        </div>
      </div>
    </div>`;

  $("layerView").querySelectorAll("[data-layer]").forEach(el =>
    el.addEventListener("click", () => { layerPick = el.dataset.layer; renderAnatomy(); }));
  $("layerView").querySelectorAll("svg [data-layer]").forEach(el =>
    el.addEventListener("keydown", e => {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); layerPick = el.dataset.layer; renderAnatomy(); }
    }));
}

/* ---------------------------------------------------------------------
   2 · MATERIAL FLOW — one chain, every state, the station that changes it
