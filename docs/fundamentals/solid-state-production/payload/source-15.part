  S[key] = old;
  return out;
}

const W = 340, HH = 168, PL = 46, PR = 12, PT = 22, PB = 30;

function chartSVG(cf) {
  const c = CTL[cf.x];
  const runs = cf.series.map(s => sweep(cf.x, s.y));
  const all = runs.flat().map(p => p[1]).filter(v => isFinite(v));
  let lo = cf.lo != null ? cf.lo : Math.min(...all);
  let hi = cf.hi != null ? cf.hi : Math.max(...all);
  if (cf.good) { lo = Math.min(lo, cf.good[0]); hi = Math.max(hi, cf.good[1]); }
  if (cf.limit != null) { lo = Math.min(lo, cf.limit); hi = Math.max(hi, cf.limit); }
  if (hi - lo < 1e-9) hi = lo + 1;
  const pad = (hi - lo) * 0.1; lo -= pad; hi += pad;

  const px = v => PL + (v - c.min) / (c.max - c.min) * (W - PL - PR);
  const py = v => PT + (1 - (Math.max(lo, Math.min(hi, v)) - lo) / (hi - lo)) * (HH - PT - PB);
  const dp = cf.dp != null ? cf.dp : 0;

  /* the band of outcomes you are allowed to land in */
  let band = "";
  if (cf.good) {
    const y1 = py(Math.min(cf.good[1], hi)), y2 = py(Math.max(cf.good[0], lo));
    band = `<rect x="${PL}" y="${y1}" width="${W - PL - PR}" height="${Math.max(1, y2 - y1)}"
      fill="color-mix(in srgb,var(--primary) 10%,transparent)"/>
      <text class="cLab" x="${W - PR - 3}" y="${y1 + 11}" text-anchor="end" fill="var(--primary)">${esc(cf.goodLabel || "acceptable")}</text>`;
  }
  let limit = "";
  if (cf.limit != null) limit = `<line x1="${PL}" y1="${py(cf.limit)}" x2="${W - PR}" y2="${py(cf.limit)}"
      stroke="var(--destructive)" stroke-width="1.4" stroke-dasharray="4 3"/>
      <text class="cLab" x="${PL + 3}" y="${py(cf.limit) - 4}" fill="var(--destructive)">${esc(cf.limitLabel || "limit")}</text>`;
  /* a hard boundary on the setpoint itself, e.g. a regulatory ceiling */
  let xmark = "";
  if (cf.xMark != null) xmark = `<rect x="${px(cf.xMark)}" y="${PT}" width="${W - PR - px(cf.xMark)}"
      height="${HH - PT - PB}" fill="color-mix(in srgb,var(--destructive) 8%,transparent)"/>
      <line x1="${px(cf.xMark)}" y1="${PT}" x2="${px(cf.xMark)}" y2="${HH - PB}" stroke="var(--destructive)" stroke-width="1.4"/>
      <text class="cLab" x="${px(cf.xMark) + 4}" y="${PT + 10}" fill="var(--destructive)">${esc(cf.xMarkLabel || "not allowed")}</text>`;

  /* is an outcome value acceptable? drives the colour of the curve */
  const okAt = v => cf.good ? (v >= cf.good[0] && v <= cf.good[1])
    : cf.limit != null ? v <= cf.limit
    : true;
  const hasState = !!(cf.good || cf.limit != null);

  /* the curves — the primary one is drawn in two colours, so the part of
     the range that lands out of specification is red on the chart itself */
  const lines = runs.map((pts, i) => {
    const s = cf.series[i];
    if (i > 0 || !hasState) {
      const d = pts.map((p, j) => `${j ? "L" : "M"}${px(p[0]).toFixed(1)} ${py(p[1]).toFixed(1)}`).join("");
      return `<path d="${d}" fill="none" stroke="${s.col || "var(--primary)"}" stroke-width="2.2"
        stroke-linejoin="round" stroke-linecap="round" ${s.dash ? 'stroke-dasharray="5 4"' : ""}/>`;
    }
    let dIn = "", dOut = "";
    for (let j = 1; j < pts.length; j++) {
      const a = pts[j - 1], b = pts[j];
      const seg = `M${px(a[0]).toFixed(1)} ${py(a[1]).toFixed(1)}L${px(b[0]).toFixed(1)} ${py(b[1]).toFixed(1)}`;
      if (okAt(a[1]) && okAt(b[1])) dIn += seg; else dOut += seg;
    }
    return `<path d="${dOut}" fill="none" stroke="var(--destructive)" stroke-width="2.4" stroke-linecap="round"/>
      <path d="${dIn}" fill="none" stroke="${s.col || "var(--primary)"}" stroke-width="2.2" stroke-linecap="round"/>`;
  }).join("");

  /* where you are standing right now */
  const m = model(), xv = S[cf.x];
  const dots = cf.series.map((s, i) => {
    const v = s.y(m);
    const off = i === 0 && hasState && !okAt(v);
    return `<circle cx="${px(xv)}" cy="${py(v)}" r="${off ? 5.4 : 4.6}"
      fill="${off ? "var(--destructive)" : "#fff"}" stroke="${off ? "var(--destructive)" : (s.col || "var(--primary)")}" stroke-width="2.4"/>`;
  }).join("");
  const curOff = hasState && !okAt(cf.series[0].y(m));

  /* legend */
  const leg = cf.series.length > 1 ? cf.series.map((s, i) =>
    `<g transform="translate(${PL + i * 132} ${HH - 4})">
       <line x1="0" y1="-3" x2="13" y2="-3" stroke="${s.col}" stroke-width="2.2" ${s.dash ? 'stroke-dasharray="4 3"' : ""}/>
       <text class="cLab" x="17" y="0">${esc(s.label)}</text></g>`).join("") : "";

  const cur = cf.series[0].y(m);
  const xdp = c.step < 1 ? String(c.step).split(".")[1].length : 0;
  /* axis labels: the current-value tick wins, and any end label it would
     collide with is dropped rather than drawn on top of it */
  const tw = t => String(t).length * 5.0;                      /* ≈ width at 9 px */
  const loTxt = `${c.min}${c.unit || ""}`, hiTxt = `${c.max}${c.unit || ""}`;
  const nowTxt = xv.toFixed(xdp);
  const nowX = Math.max(PL + tw(nowTxt) / 2, Math.min(W - PR - tw(nowTxt) / 2, px(xv)));
  const nowL = nowX - tw(nowTxt) / 2 - 5, nowR = nowX + tw(nowTxt) / 2 + 5;
  const loLab = nowL > PL + tw(loTxt)
    ? `<text class="cAx" x="${PL}" y="${HH - PB + 13}">${esc(loTxt)}</text>` : "";
  const hiLab = nowR < W - PR - tw(hiTxt)
    ? `<text class="cAx" x="${W - PR}" y="${HH - PB + 13}" text-anchor="end">${esc(hiTxt)}</text>` : "";
  return `<figure class="chart" data-off="${curOff}">
    <figcaption><b>${esc(cf.title)}</b><span>${esc(c.label)} → ${esc(cf.series[0].label)}</span></figcaption>
    <svg viewBox="0 0 ${W} ${HH}" role="img" aria-label="${esc(cf.title)}: ${esc(c.label)} against ${esc(cf.series[0].label)}">
      <line x1="${PL}" y1="${PT}" x2="${PL}" y2="${HH - PB}" stroke="var(--border-strong)"/>
      <line x1="${PL}" y1="${HH - PB}" x2="${W - PR}" y2="${HH - PB}" stroke="var(--border-strong)"/>
      ${band}${xmark}${limit}${lines}
      <line x1="${px(xv)}" y1="${PT}" x2="${px(xv)}" y2="${HH - PB}" stroke="var(--foreground)" stroke-width="1" stroke-dasharray="3 3" opacity=".45"/>
      ${dots}
      ${loLab}${hiLab}
      <text class="cNow" x="${nowX}" y="${HH - PB + 13}" text-anchor="middle">${xv.toFixed(xdp)}</text>
      ${leg}
      <text class="cAx" x="${PL - 5}" y="${py(hi - pad) + 4}" text-anchor="end">${(hi - pad).toFixed(dp)}</text>
      <text class="cAx" x="${PL - 5}" y="${py(lo + pad) + 4}" text-anchor="end">${(lo + pad).toFixed(dp)}</text>
      <text class="cVal" x="${PL}" y="${PT - 7}" fill="${curOff ? "var(--destructive)" : "var(--foreground)"}">${cur.toFixed(dp)}${esc(cf.unit || "")} now${curOff ? " — out of specification" : ""}</text>
    </svg>
  </figure>`;
}


/* --- bespoke: pressure against the current the cell can survive -------- */
function pressureChart() {
  const m = model(), W2 = 340, H2 = 176, L = 44, R = 12, TT = 22, B = 30;
  const oxide = route === "oxide", sulf = route === "sulfide", hal = route === "halide";
  const base = oxide ? 1.1 : sulf ? 0.9 : hal ? 0.8 : 0.45;
  const jc = p => base * (1 + p / 14) * (1 + Math.max(0, S.cellT - 25) / 90) * (S.sseTh / 25) ** 0.25;
  const maxY = Math.max(jc(40), m.jArea * 1.3, 1.5);
  const px = p => L + p / 40 * (W2 - L - R);
  const py = v => TT + (1 - Math.min(v, maxY) / maxY) * (H2 - TT - B);
  const path = Array.from({ length: 64 }, (_, i) => {
    const p = 0.1 + i / 63 * 39.9;
    return `${i ? "L" : "M"}${px(p).toFixed(1)} ${py(jc(p)).toFixed(1)}`;
  }).join("");
  const safe = m.jArea < jc(S.stackF);
  return `<figure class="chart" data-off="${!safe}">
    <figcaption><b>Pressure buys you current</b><span>stack pressure → the current density the electrolyte survives</span></figcaption>
    <svg viewBox="0 0 ${W2} ${H2}" role="img" aria-label="Critical current density against stack pressure">
      <line x1="${L}" y1="${TT}" x2="${L}" y2="${H2 - B}" stroke="var(--border-strong)"/>
      <line x1="${L}" y1="${H2 - B}" x2="${W2 - R}" y2="${H2 - B}" stroke="var(--border-strong)"/>
      <rect x="${L}" y="${TT}" width="${W2 - L - R}" height="${py(m.jArea) - TT}" fill="var(--destructive)" opacity=".08"/>
      <line x1="${L}" y1="${py(m.jArea)}" x2="${W2 - R}" y2="${py(m.jArea)}"
        stroke="var(--destructive)" stroke-width="1.6" stroke-dasharray="4 3"/>
      <text class="cLab" x="${L + 4}" y="${py(m.jArea) - 5}" fill="var(--destructive)">your formation current ${m.jArea.toFixed(2)} mA/cm²</text>
      <path d="${path}" fill="none" stroke="var(--primary)" stroke-width="2.4"/>
      <line x1="${px(S.stackF)}" y1="${TT}" x2="${px(S.stackF)}" y2="${H2 - B}"
        stroke="var(--foreground)" stroke-width="1" stroke-dasharray="3 3" opacity=".45"/>
      <circle cx="${px(S.stackF)}" cy="${py(jc(S.stackF))}" r="5"
        fill="${safe ? "var(--background)" : "var(--destructive)"}"
        stroke="${safe ? "var(--primary)" : "var(--destructive)"}" stroke-width="2.4"/>
      <text class="cAx" x="${L}" y="${H2 - B + 13}">0.1 MPa</text>
      <text class="cAx" x="${W2 - R}" y="${H2 - B + 13}" text-anchor="end">40 MPa</text>
      <text class="cVal" x="${L}" y="${TT - 7}">${jc(S.stackF).toFixed(2)} mA/cm² survivable</text>
    </svg>
    <p class="chart-note" data-s="${safe ? "ok" : "bad"}">${safe
      ? `At ${S.stackF.toFixed(1)} MPa the electrolyte survives ${jc(S.stackF).toFixed(2)} mA/cm² and you are asking for ${m.jArea.toFixed(2)}. In published work on lithium against a sulfide electrolyte, the critical current density rose from 0.2 to 1 mA/cm² as stack pressure went from 3 to 7 MPa.`
      : `At ${S.stackF.toFixed(1)} MPa the electrolyte survives about ${jc(S.stackF).toFixed(2)} mA/cm², and you are asking for ${m.jArea.toFixed(2)}. Lithium will grow through. Raise the pressure, slow the first cycle, or accept a thicker electrolyte.`}</p>
  </figure>`;
}

/* --- bespoke: where the cell's resistance actually comes from ---------- */
function resistanceChart() {
  const m = model(), W2 = 340, H2 = 176, L = 44, R = 12, TT = 26, B = 44;
  const parts = [
    ["interfaces", m.rInt, "var(--destructive)"],
    ["electrolyte bulk", m.rBulk, "var(--primary)"],
    ["everything else", 4, "var(--muted-foreground)"]
  ];
  const tot = parts.reduce((a, p) => a + p[1], 0);
  let x = L, bars = "", legend = "";
  parts.forEach(([n, v, c], i) => {
    const w = (v / tot) * (W2 - L - R);
    bars += `<rect x="${x.toFixed(1)}" y="${TT + 16}" width="${Math.max(1, w).toFixed(1)}" height="44"
      fill="${c}" opacity=".85"/>` +
      (w > 44 ? `<text class="cLab" x="${(x + w / 2).toFixed(1)}" y="${TT + 43}" text-anchor="middle"
         fill="var(--background)">${v.toFixed(0)}</text>` : "");
    legend += `<g transform="translate(${L + i * 100} ${H2 - 10})">
      <rect x="0" y="-8" width="10" height="8" fill="${c}" opacity=".85"/>
      <text class="cLab" x="14" y="0">${n}</text></g>`;
    x += w;
  });
  const good = tot < 60;
  return `<figure class="chart" data-off="${!good}">
    <figcaption><b>Where the resistance is</b><span>total area-specific resistance, Ω·cm²</span></figcaption>
    <svg viewBox="0 0 ${W2} ${H2}" role="img" aria-label="Breakdown of cell resistance">
      <text class="cVal" x="${L}" y="${TT + 4}">${tot.toFixed(0)} Ω·cm² total</text>
      ${bars}
      <line x1="${L}" y1="${TT + 66}" x2="${W2 - R}" y2="${TT + 66}" stroke="var(--border-strong)"/>
      <text class="cAx" x="${L}" y="${TT + 80}">0</text>
      <text class="cAx" x="${W2 - R}" y="${TT + 80}" text-anchor="end">${tot.toFixed(0)}</text>
      ${legend}
    </svg>
    <p class="chart-note" data-s="${good ? "ok" : tot < 120 ? "warn" : "bad"}">
      ${m.rInt > m.rBulk
        ? `The interfaces dominate, at ${m.rInt.toFixed(0)} of ${tot.toFixed(0)} Ω·cm². More stack pressure, a denser layer or better sintering will move this number; a thinner electrolyte will not.`
        : `The electrolyte bulk dominates, at ${m.rBulk.toFixed(0)} of ${tot.toFixed(0)} Ω·cm². Thin the layer or change to a more conductive class — pressing harder will not help here.`}</p>
  </figure>`;
}

/* --- which charts each station shows ------------------------------------ */
const CHARTS = {
  drycoat: [
    { x:"dcFib", title:"Too little shear and there is no film; too much and it clumps", unit:"%", good:[90,100], goodLabel:"in window", dp:0,
      series:[{ y:m => m.dryFilmQ, label:"Film quality", col:"var(--primary)" }] },
    { x:"dcT", title:"Warm rolls help the binder knit", unit:"%", good:[90,100], goodLabel:"in window", dp:0,
      series:[{ y:m => m.dryFilmQ, label:"Film quality", col:"var(--sep)" }] }],
  ald: [
    { x:"aldSpd", title:"Web speed is the thickness control", unit:" nm", dp:1, lo:0,
      series:[{ y:m => m.aldNm, label:"Film thickness", col:"var(--primary)" }] },
    { x:"aldT", title:"Outside the window it stops being self-limiting", unit:"%", good:[88,100], goodLabel:"discrete", dp:0,
      series:[{ y:m => m.aldQ, label:"Coating quality", col:"var(--elyte)" }] }],
  compacting: [
    { x:"compP", title:"Pressure closes the porosity, with diminishing returns", unit:"%", good:[82,100], goodLabel:"densified", dp:0,
      series:[{ y:m => m.compDens, label:"Relative density", col:"var(--primary)" }] },
    { x:"compP", title:"…and density is interfacial contact", unit:" Ω·cm²", limit:40, limitLabel:"target", lo:0, dp:0,
      series:[{ y:m => m.rInt, label:"Interfacial resistance", col:"var(--destructive)" }] },
    { x:"compT", title:"Heat does the same work as pressure", unit:"%", good:[82,100], goodLabel:"densified", dp:0,
      series:[{ y:m => m.compDens, label:"Relative density", col:"var(--sep)" }] }],

  extrusion: [
    { x:"liTh", title:"Foil thickness is lithium you may never use", unit:"", good:[1.05,3], goodLabel:"useful N/P band", dp:2, lo:0.4,
      series:[{ y:m => m.np, label:"N/P ratio", col:"var(--primary)" }] },
    { x:"pistF", title:"Force has a window, not a direction", unit:"%", good:[90,100], goodLabel:"in specification", lo:60, hi:100, dp:0,
      series:[{ y:m => m.foilQ, label:"Foil quality index", col:"var(--elyte)" }] }],
  lamination: [
    { x:"lamP", title:"Pressure builds the bond, then stops helping", unit:"%", good:[88,100], goodLabel:"bond holds", lo:40, hi:100, dp:0,
