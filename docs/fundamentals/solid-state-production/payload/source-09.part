  sop:["Select laser or knife for this composite","Set the cut width and thread the web","Trial-cut and inspect the edge under magnification","Check for delamination at the cut","Run and monitor the heat-affected zone","Wind the strips separately"] },

{ id:"separation", no:"11", phase:"Cell assembly", title:"Sheet separation", machine:"separation", routes:ALL,
