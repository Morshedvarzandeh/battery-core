  `<circle class="mDark" cx="${x}" cy="${y}" r="2"/>` + T(x, y + 27, label, "mTxtS", "middle") + `</g>`;
const ARROW = (x, y, dir = 1) =>
  `<path class="mArrow" d="M${x} ${y}l${14 * dir} 0l${-4 * dir} -4l${9 * dir} 4l${-9 * dir} 4l${4 * dir} -4z"/>`;
/* ---------- web geometry ----------
   A web is a ribbon of constant thickness through a list of points.
   An idler is placed TANGENT to the web, never centred on it, and a nip
   is two rollers whose surfaces meet exactly on the web line.          */
const WEB = (pts, cls, w = 5) =>
  `<path class="${cls}" style="stroke-width:${w};fill:none" d="${
    pts.map(([x, y], i) => `${i ? "L" : "M"}${x} ${y}`).join("")}"/>`;
const WEBRUN = (pts, cls, w = 5) =>
  WEB(pts, cls, w) + `<path class="${cls} flowdash" style="stroke-width:${w};fill:none"
    d="${pts.map(([x, y], i) => `${i ? "L" : "M"}${x} ${y}`).join("")}"/>`;
/* side = 1 → the roller sits under the web, side = -1 → above it */
const IDLER = (x, y, r, side = 1) => ROLLER(x, y + side * r, r);
/* the two rollers of a nip, touching on the web line */
/* the two rollers of a nip turn against each other, or they would tear the web */
const NIP = (x, y, r) => ROLLER(x, y - r, r) + ROLLERR(x, y + r, r);

const NOZZLES = (x, y, n, w, down = true) => {
  let s = "";
  for (let i = 0; i < n; i++) {
    const cx = x + i * w;
    s += `<path class="mEl" d="M${cx} ${y}l4 0l0 ${down ? 7 : -7}l-2 ${down ? 4 : -4}l-2 ${down ? -4 : 4}z"/>`;
  }
  return s;
};

