  const jArea = S.cRate * capC;                                   /* mA/cm² during formation */
  const jCrit = (oxide ? 1.1 : sulf ? 0.9 : hal ? 0.8 : 0.45) * (1 + S.stackF / 14)
              * (1 + Math.max(0, S.cellT - 25) / 90) * (S.sseTh / 25) ** 0.25;
  const dendrite = clamp((jArea / jCrit) * 55, 0, 140);           /* >100 = through-growth */

  /* --- drying, on the routes that cast a slurry ---------------------------- */
  const solvRes = (oxide || ductile) ? Math.max(0, 108 - S.dryT) * 3.4 + Math.max(0, S.dryT - 150) * 2.0 : 0;

  /* --- cutting and handling ---------------------------------------------- */
  const lineE = S.laserP / Math.max(1, S.cutSpd) * 0.06;          /* J/mm proxy */
  const meltRisk = S.cutMode ? 0 : clamp((lineE - 1.1) * 55, 0, 100);
  const delam = S.cutMode ? clamp((S.cutSpd - 60) * 0.7 + 18, 0, 100) : clamp((1.1 - lineE) * 45, 0, 100);
  const edgeQ = clamp(100 - meltRisk * 0.75 - delam * 0.45);
  /* separation cuts a second time, and punching fails differently from laser */
  const meltSep = S.sepMode ? 0 : meltRisk;
  const delamSep = S.sepMode ? clamp(26 + Math.max(0, S.cutSpd - 60) * 0.55, 0, 100) : delam;
  const edgeSep = clamp(100 - meltSep * 0.85 - delamSep * 0.45);

  /* --- assembly ---------------------------------------------------------- */
  const alignRisk = Math.max(0, S.stackAcc - 300) * 0.16 + Math.max(0, 0.6 - S.stackSpd) * 12
                  + Math.max(0, S.stackSpd - 1) * 6;   /* guide requires under 1 s per sheet */
  const weldQ = clamp(100 - Math.abs(S.weldP - 1600) / 34 - Math.max(0, S.weldP - 3200) * 0.02);
  const sealQ = clamp(100 - Math.abs(S.sealT - 190) * 1.2 - Math.max(0, S.drawD - 10) * 6);

  /* --- formation and aging ------------------------------------------------ */
  const interQ = clamp(100 - Math.max(0, S.cRate - 0.12) * 150 - Math.max(0, dendrite - 55) * 0.5
                     - Math.max(0, rTot - 60) * 0.14 - Math.max(0, 90 - aldQ) * 0.28);
  const screen = clamp(30 + S.ageDays * 5.2 + (S.ageT - 25) * 0.9 + (S.ageSOC - 20) * 0.22);
  const escape = Math.max(0, 92 - screen) * 0.07;

  /* --- lithium handling ---------------------------------------------------- */
  const liRisk = S.passiv ? 0 : 22;                              /* unpassivated foil, inert gas everywhere */
  const foilQ = clamp(100 - Math.abs(S.extT - 70) * 0.5 - Math.max(0, 3000 - S.pistF) * 0.006
                    - Math.max(0, S.pistF - 9000) * 0.008);
  const lamQ = clamp(58 + (S.lamP / 2500) * 36 + (S.lamT - 20) * 0.30 - Math.max(0, S.lamP - 2200) * 0.03);

  /* --- coating ------------------------------------------------------------- */
  const wetNeed = oxide || ductile ? S.cathTh / 0.42 : 0;
  const coatErr = oxide || ductile
    ? 0.6 + Math.abs(S.gapH - wetNeed) * 0.05 + (S.bandSpd - 25) * 0.016 + (100 - disp) * 0.05
    : 0.6 + Math.abs(S.meltDT - 8) * 0.09 + Math.abs(S.extP - 90) * 0.012 + (100 - disp) * 0.05;

  /* --- scores --------------------------------------------------------------- */
  const uniformity = clamp(100 - Math.max(0, coatErr - 1) * 9 - (100 - disp) * 0.3 - (100 - layerDens) * 0.5
                     - (route === "oxide" ? 0 : Math.max(0, 90 - dryFilmQ) * 0.35));
  const interfaces = clamp(100 - Math.max(0, rTot - 40) * 0.28 - (100 - contact) * 0.35);
  const safety     = clamp(100 - Math.max(0, dendrite - 45) * 0.9
                     - Math.max(0, 100 - edgeQ) * 0.28 - Math.max(0, 100 - edgeSep) * 0.28
                     - alignRisk * 1.4 - liRisk * 0.6 - (np < 1 ? (1 - np) * 120 : 0));
  const yieldPct   = clamp(99.4
                     - Math.max(0, coatErr - 2) * 3.2
                     - Math.max(0, 100 - edgeQ) * 0.10 - Math.max(0, 100 - edgeSep) * 0.10
                     - solvRes * 0.05 - liRisk * 0.10
                     - Math.max(0, dendrite - 60) * 0.35
                     - Math.max(0, 88 - lamQ) * 0.22
                     - Math.max(0, 90 - foilQ) * 0.16
                     - Math.max(0, 60 - contact) * 0.30
                     - Math.max(0, 94 - weldQ) * 0.2 - Math.max(0, 94 - sealQ) * 0.2
                     - alignRisk - escape * 2
                     - (oxide && !grainOK ? 5 : 0)
                     - Math.max(0, polyDeg) * 0.3, 50, 99.4);

  /* --- the worst problem, in plain language ---------------------------------- */
  let level = "ok", head = "Model inside the training window", body =
    `Interfacial resistance ${rInt.toFixed(0)} Ω·cm², total ${rTot.toFixed(0)} Ω·cm², contact ${contact.toFixed(0)}%, stack voltage ${vCell.toFixed(1)} V.`;
  const flag = (c, lv, h, b) => { if (c) { level = lv; head = h; body = b; } };

  flag(disp < 82, "warn", "Mixture not fully homogeneous",
    `Dispersion index ${disp.toFixed(0)}%. Agglomerates survive into the layer and print through as thickness scatter.`);
  flag(oxide && partSize > 6, "warn", "Particle size still coarse",
    `${partSize.toFixed(1)} µm after grinding. Coarse powder sinters unevenly and leaves a rough, resistive interface.`);
  flag(coatErr > 2, "warn", "Layer thickness scatter high",
    `Predicted scatter ±${coatErr.toFixed(1)} g/m². Thickness accuracy along and across the web is the headline quality feature of this station.`);
  flag(lamQ < 88, "warn", "Lithium lamination weak",
    `Bond index ${lamQ.toFixed(0)}%. Raise line pressure or temper the rollers — heat, not just pressure, makes this bond.`);
  flag(!S.passiv, "warn", "Lithium foil is not passivated",
    "Without a passivation layer the whole downstream line has to stay under inert gas rather than in a dry room. That is a large facility cost.");
  flag(contact < 60, "warn", "Interfaces are not properly in contact",
    `Contact index ${contact.toFixed(0)}%. A solid cell has no liquid to wet its pores, so pressure and density are key controls on the interface.`);
  flag(oxide && !grainOK, "warn", "Sintering outside the useful band",
    `${S.sintT} °C. Too low and the particles do not grow together; too high and grains coarsen and the materials fight each other.`);
  flag(solvRes > 40, "warn", "Solvent not fully driven off",
    `Dryer at ${S.dryT} °C against a 50–160 °C profile. Residual solvent in the layer is the reason the guide asks for a drying step and a recovery option.`);
  flag(edgeSep < 70, "warn", "Separation edge quality poor",
    S.sepMode ? "Punching is deflecting and delaminating the film at this speed."
              : "Laser energy at separation is off — and here the failure is specific: melted layers connect anode to cathode.");
  flag(edgeQ < 70, "warn", "Slitting edge quality poor",
    S.cutMode ? "The rolling knife is deflecting the substrate and delaminating the coating."
              : "Laser energy is off: too little leaves a ragged edge, too much melts the layers together.");
  flag(rTot > 120, "bad", "Cell resistance too high to be useful",
    `${rTot.toFixed(0)} Ω·cm² total. Either the interfaces are not in contact or the electrolyte layer is too thick for its conductivity.`);
  flag(np < 1, "bad", "Lithium anode under-sized",
    `N/P ratio ${np.toFixed(2)}. There is less lithium in the foil than the catholyte will demand.`);
  flag(!S.cutMode && meltRisk > 55, "bad", "Laser is melting the layers together",
    "Melting the layer materials connects them electrically. That is a short circuit built at the cutting station.");
  flag(dendrite > 100, "bad", "Lithium is growing through the electrolyte",
    `Current density ${jArea.toFixed(2)} mA/cm² against a critical value near ${jCrit.toFixed(2)}. Lower the first-cycle rate, raise the pressure, or use a thicker electrolyte.`);

  return { fibril, dryFilmQ, aldNm, aldOK, aldQ, compDens,
           partSize, disp, polyDeg, layerDens, grainOK, contact, rInt, rBulk, rTot,
           capC, capA, np, vCell, cellAh, cellWh, wgrav, wvol, unitTh,
           jArea, jCrit, dendrite, lineE, meltRisk, delam, edgeQ, meltSep, delamSep, edgeSep, solvRes,
           alignRisk, weldQ, sealQ, interQ, screen, escape, liRisk, foilQ, lamQ,
           wetNeed, coatErr, uniformity, interfaces, safety, yieldPct, level, head, body };
}
</script>
<script>
/* =====================================================================
   THE BIG PICTURE LAYER — all-solid-state cell
   1. REFS       — every number in this simulator points at a source
   2. COMPONENTS — the cell, layer by layer, and which station builds it
   3. FLOW       — one material chain, ingot to released cell
   ===================================================================== */

/* ---------------- 1 · references ---------------- */
const REFS = [
  { n:1, tag:"PEM/VDMA 2026", txt:"Heimes, H. H.; Kampker, A.; Born, H.; Plumeyer, J. F.; Kim, D.; Smulka, M.; Michaelis, S.; Rothhagen, B. <em>Production of a Solid-State Battery Cell</em>, 3rd ed.; PEM of RWTH Aachen University &amp; VDMA: Aachen, February 2026. ISBN 978-3-947920-75-4.",
