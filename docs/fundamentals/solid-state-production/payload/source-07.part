const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>]/g, c => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;" }[c]));
const PHASES = [
  ["Electrode & electrolyte production", "var(--warning)"],
  ["Cell assembly",                      "var(--elyte)"],
  ["Cell finishing",                     "var(--green)"]
];
const phaseColor = p => (PHASES.find(x => x[0] === p) || [, "var(--primary)"])[1];
const active = () => STATIONS.filter(s => s.routes.includes(route));
const clamp = (v, lo = 0, hi = 100) => Math.max(lo, Math.min(hi, v));
const fmt = n => n >= 1000 ? Math.round(n).toLocaleString("en-US") : n.toFixed(n < 10 ? 2 : 1);

const ALL = "oxide sulfide polymer halide";
const STATIONS = [

